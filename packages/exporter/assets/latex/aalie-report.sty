% ======================================================
% AALIE Report Style — Universidad de Caldas (FI)
% Archivo: aalie-report.sty
% Compilación: pdfLaTeX (Overleaf), SIN shell-escape
% ======================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aalie-report}[2026/03/19 v1.8 AALIE academic report style]

% ------------------------------------------------------
% Dependencias (pdfLaTeX)
% ------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{lastpage}
\RequirePackage{titlesec}
\RequirePackage{parskip}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{courier}
\setkeys{Gin}{draft=false}

% ------------------------------------------------------
% Geometría única (sin header reservado)
% ------------------------------------------------------
\geometry{
  top=1.25cm,
  bottom=1.25cm,
  left=1.45cm,
  right=1.45cm,
  footskip=14pt,
  includefoot
}

% ------------------------------------------------------
% Densidad general
% ------------------------------------------------------
\setlength{\parskip}{0.35em}
\setlength{\parindent}{0pt}
\setlist{nosep,leftmargin=1.4em}

% ------------------------------------------------------
% Colores
% ------------------------------------------------------
\definecolor{ingColor}{HTML}{D27B48}
\definecolor{ucaldasBlue}{HTML}{003E70}
\definecolor{aalieGray}{RGB}{85,85,85}
\definecolor{aalieLightGray}{RGB}{135,135,135}
\definecolor{aalieCodeBg}{RGB}{246,248,250}
\definecolor{aalieCodeFrame}{RGB}{210,218,226}

% ------------------------------------------------------
% Variables configurables
% ------------------------------------------------------
\newcommand{\aalie@logoUcaldas}{logos/ucaldas.pdf}
\newcommand{\aalie@logoAALIE}{logos/aalie.pdf}
\newcommand{\aalie@wmLogo}{logos/aalie.pdf}

\newcommand{\aalie@institutionLineA}{UNIVERSIDAD DE CALDAS}
\newcommand{\aalie@institutionLineB}{Facultad de Ingenierías}
\newcommand{\aalie@institutionLineC}{AALIE — Analizador de Complejidad Algorítmica}

\newcommand{\aalie@reportCode}{AALIE-REPORT-0000}
\newcommand{\aalie@reportVersion}{v1.0}
\newcommand{\aalie@reportDate}{\today}
\newcommand{\aalie@labelVersion}{Versión}
\newcommand{\aalie@labelDate}{Fecha}
\newcommand{\aalie@wmOpacity}{0.10}
\newcommand{\aalie@wmWidth}{0.42\paperwidth}
\newcommand{\aalie@wmGraphic}{%
  \includegraphics[width=\aalie@wmWidth,keepaspectratio]{\aalie@wmLogo}%
}

\newcommand{\aalie@disclaimer}{%
Este documento fue generado automáticamente como apoyo al análisis y puede contener omisiones o imprecisiones.
No sustituye criterio profesional ni garantiza exactitud total. Valide los resultados y consulte a un especialista cuando aplique.%
}

\newif\ifaalie@topdisclaimer
\aalie@topdisclaimertrue
\newif\ifaalie@watermark
\aalie@watermarkfalse

% ------------------------------------------------------
% API pública
% ------------------------------------------------------
\newcommand{\AALIESetLogos}[3]{%
  \renewcommand{\aalie@logoUcaldas}{#1}%
  \renewcommand{\aalie@logoAALIE}{#2}%
  \renewcommand{\aalie@wmLogo}{#3}%
}

\newcommand{\AALIESetInstitution}[3]{%
  \renewcommand{\aalie@institutionLineA}{#1}%
  \renewcommand{\aalie@institutionLineB}{#2}%
  \renewcommand{\aalie@institutionLineC}{#3}%
}

\newcommand{\AALIESetReportInfo}[3]{%
  \renewcommand{\aalie@reportCode}{#1}%
  \renewcommand{\aalie@reportVersion}{#2}%
  \renewcommand{\aalie@reportDate}{#3}%
}

\newcommand{\AALIESetMetaLabels}[2]{%
  \renewcommand{\aalie@labelVersion}{#1}%
  \renewcommand{\aalie@labelDate}{#2}%
}

\newcommand{\AALIESetDisclaimer}[1]{%
  \renewcommand{\aalie@disclaimer}{#1}%
}

\newcommand{\AALIEDisclaimerAtTop}[1]{%
  \csname aalie@topdisclaimer#1\endcsname
}

% ------------------------------------------------------
% Marca de agua
% ------------------------------------------------------
\newcommand{\AALIEEnableWatermark}[2]{%
  \aalie@watermarktrue
  \renewcommand{\aalie@wmOpacity}{#1}
  \renewcommand{\aalie@wmWidth}{#2}
}

\newcommand{\AALIEDisableWatermark}{%
  \aalie@watermarkfalse
}

% ------------------------------------------------------
% Footer único
% ------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[R]{\scriptsize\color{aalieGray}\textbf{\thepage/\pageref{LastPage}}}

\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[R]{\scriptsize\color{aalieGray}\textbf{\thepage/\pageref{LastPage}}}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% ------------------------------------------------------
% Bloque institucional SOLO una vez
% ------------------------------------------------------
\newcommand{\AALIEHeaderOnce}{%
  \begingroup
  \setlength{\parindent}{0pt}
  \noindent
  \begin{minipage}[t]{0.18\textwidth}
    \raggedright
    {\raisebox{2.8em}[0pt][0pt]{\scriptsize\color{aalieGray}\textbf{\aalie@labelVersion:} \aalie@reportVersion}}
    
    \vspace{0.2em}
    \centering
    \includegraphics[height=30pt,keepaspectratio]{\aalie@logoUcaldas}
  \end{minipage}%
  \begin{minipage}[t]{0.64\textwidth}
    \centering
    {\small\bfseries\color{ucaldasBlue}\aalie@institutionLineA\par}
    {\footnotesize\bfseries\color{ingColor}\aalie@institutionLineB\par}
    {\scriptsize\color{aalieGray}\aalie@institutionLineC\par}
  \end{minipage}%
  \begin{minipage}[t]{0.18\textwidth}
    \raggedleft
    {\raisebox{2.8em}[0pt][0pt]{\scriptsize\color{aalieGray}\textbf{\aalie@labelDate:} \aalie@reportDate}}
    
    \vspace{0.2em}
    \centering
    \includegraphics[height=30pt,keepaspectratio]{\aalie@logoAALIE}
  \end{minipage}%
  \par
  \vspace{0.8em}
  \endgroup
}

% ------------------------------------------------------
% Bloque superior de advertencia
% ------------------------------------------------------
\newcommand{\aalie@TopDisclaimerBlock}{%
  \begingroup
  \setlength{\parindent}{0pt}%
  \setlength{\fboxsep}{6pt}%
  \nointerlineskip
  \fcolorbox{ucaldasBlue}{white}{%
    \parbox{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
      {\scriptsize\color{aalieGray}\itshape \aalie@disclaimer}%
    }%
  }%
  \vspace{10pt}%
  \endgroup
}

% ------------------------------------------------------
% Bandas horizontales institucionales
% ------------------------------------------------------
\newcommand{\aalie@fullband}[1]{%
  \noindent
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \hspace*{-\dimexpr 1in+\hoffset+\oddsidemargin\relax}%
  \colorbox{ucaldasBlue}{%
    \parbox[c][0.88cm][c]{\paperwidth}{%
      \centering
      \color{white}\bfseries\large #1%
    }%
  }%
  \endgroup
}

\newcommand{\aalie@sectionband}[1]{%
  \aalie@fullband{#1}%
  \vspace{0.18em}%
}

\newcommand{\aalie@subsectionband}[1]{%
  \aalie@fullband{#1}%
  \vspace{0.14em}%
}

\newcommand{\AALIEExecutiveSummary}[1]{%
  \vspace{0.35em}%
  \noindent
  {\Large\bfseries\color{ucaldasBlue}#1\par}%
  \vspace{0.45em}%
  {\color{ingColor}\rule{\textwidth}{0.8pt}\par}%
  \vspace{0.55em}%
}

% ------------------------------------------------------
% Secciones sin numeración visible
% ------------------------------------------------------
\setcounter{secnumdepth}{0}

\titleformat{name=\section}[block]
  {\normalfont}
  {}
  {0pt}
  {\aalie@sectionband}

\titleformat{name=\subsection}[block]
  {\normalfont}
  {}
  {0pt}
  {\aalie@subsectionband}

\titlespacing*{\section}{0pt}{1.7em}{0.18em}
\titlespacing*{\subsection}{0pt}{1.3em}{0.14em}

% ------------------------------------------------------
% Bloques de código institucionales
% ------------------------------------------------------
\lstdefinestyle{aaliecode}{
  basicstyle=\footnotesize\ttfamily,
  backgroundcolor=\color{aalieCodeBg},
  frame=single,
  rulecolor=\color{aalieCodeFrame},
  framerule=0.7pt,
  framesep=8pt,
  xleftmargin=0pt,
  xrightmargin=0pt,
  aboveskip=8pt,
  belowskip=8pt,
  showstringspaces=false,
  keepspaces=true,
  columns=fullflexible,
  breaklines=true,
  breakatwhitespace=true,
  tabsize=2
}

\lstnewenvironment{aaliecodeblock}{\lstset{style=aaliecode}}{}

% ------------------------------------------------------
% Inicialización
% ------------------------------------------------------
\AtBeginDocument{%
  \renewcommand{\baselinestretch}{0.97}\normalsize
  \AALIEHeaderOnce
  \ifaalie@topdisclaimer
    \aalie@TopDisclaimerBlock
  \fi
}

\AddToHook{shipout/background}{%
  \ifaalie@watermark
    \begin{tikzpicture}[remember picture,overlay]
      \node[opacity=\aalie@wmOpacity,inner sep=0pt] at (current page.center)
        {\aalie@wmGraphic};
    \end{tikzpicture}%
  \fi
}

\endinput
