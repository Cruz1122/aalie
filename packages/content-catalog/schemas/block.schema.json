{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aalie.dev/schemas/content/block.schema.json",
  "title": "AALIE Content Block",
  "$ref": "#/$defs/block",
  "$defs": {
    "blockId": {
      "type": "string",
      "pattern": "^blk-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": {
          "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "string",
          "enum": ["small", "medium", "large", "full"]
        },
        "captionPosition": {
          "type": "string",
          "enum": ["top", "bottom"]
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "level", "content"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "heading"
            },
            "level": {
              "type": "integer",
              "enum": [2, 3, 4]
            },
            "content": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "content"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "paragraph"
            },
            "content": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "items"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "list"
            },
            "style": {
              "type": "string",
              "enum": ["unordered", "ordered"]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/listItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "content"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "quote"
            },
            "content": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "attribution": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "variant", "title", "blocks"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "note"
            },
            "variant": {
              "type": "string",
              "enum": ["info", "warning", "success", "danger"]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "blocks"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": [
                "callout",
                "definition",
                "theorem",
                "proof",
                "example",
                "exerciseSolution"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "variant", "icon", "blocks"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "evidenceBlock"
            },
            "variant": {
              "type": "string",
              "enum": [
                "concept",
                "example",
                "systemEvidence",
                "interpretation",
                "warning"
              ]
            },
            "icon": {
              "type": "string",
              "enum": [
                "school",
                "science",
                "analytics",
                "lightbulb",
                "warning",
                "error_outline"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "prompt"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "exercise"
            },
            "title": {
              "type": "string"
            },
            "prompt": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "difficulty": {
              "type": "string",
              "enum": ["basic", "intermediate", "advanced"]
            },
            "solutionRef": {
              "type": "string",
              "pattern": "^blk-[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "language", "code"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": ["algorithm", "code"]
            },
            "language": {
              "type": "string",
              "enum": ["pseudocode", "text", "json", "python", "typescript"]
            },
            "title": {
              "type": "string"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "columns", "rows"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "table"
            },
            "title": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "align": {
                    "type": "string",
                    "enum": ["left", "center", "right"]
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cells"],
                "properties": {
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "resourceRef"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": ["image", "figure"]
            },
            "resourceRef": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "display": {
              "$ref": "#/$defs/display"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "latex"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": ["latex", "equationBlock"]
            },
            "latex": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "align": {
              "type": "string",
              "enum": ["left", "center", "right"]
            },
            "title": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "steps"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "latexSteps"
            },
            "title": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stepId", "latex"],
                "properties": {
                  "stepId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "title": {
                    "type": "string"
                  },
                  "explanation": {
                    "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
                  },
                  "latex": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "code"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "mermaid"
            },
            "title": {
              "type": "string"
            },
            "code": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "nodes"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "recursionTree"
            },
            "title": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeId", "label"],
                "properties": {
                  "nodeId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "label": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  },
                  "parentId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "edgeLabel": {
                    "type": "string"
                  }
                }
              }
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "nodes", "edges"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "graph"
            },
            "title": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeId", "label"],
                "properties": {
                  "nodeId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "label": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edgeId", "source", "target"],
                "properties": {
                  "edgeId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "source": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "target": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "columns", "rows"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": ["complexityTable", "formulaComparisonTable"]
            },
            "title": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "align": {
                    "type": "string",
                    "enum": ["left", "center", "right"]
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cells"],
                "properties": {
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "methodCard"
            },
            "title": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "summary": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "whenToUse": {
              "type": "array",
              "items": {
                "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
              }
            },
            "pitfalls": {
              "type": "array",
              "items": {
                "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "steps"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "enum": ["stepByStepMethod", "proofSteps"]
            },
            "title": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stepId", "title", "blocks"],
                "properties": {
                  "stepId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "title": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  },
                  "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/block"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "warningTrap"
            },
            "title": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "misconception": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "whyItFails": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "fix": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "steps"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "exampleSolved"
            },
            "title": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "problem": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stepId", "title", "explanation"],
                "properties": {
                  "stepId": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                  },
                  "title": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  },
                  "explanation": {
                    "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
                  },
                  "latex": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                  }
                }
              }
            },
            "answer": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "quizId"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "quizCheckpoint"
            },
            "quizId": {
              "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
            },
            "title": {
              "type": "string"
            },
            "prompt": {
              "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "items"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "cheatsheet"
            },
            "title": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "$ref": "https://aalie.dev/schemas/content/inline.schema.json#/$defs/richText"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "references"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "referenceList"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "divider"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "buttons"],
          "properties": {
            "id": {
              "$ref": "#/$defs/blockId"
            },
            "type": {
              "const": "buttonRow"
            },
            "buttons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "target"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/targetRef"
                  },
                  "variant": {
                    "type": "string",
                    "enum": ["primary", "secondary", "ghost"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
