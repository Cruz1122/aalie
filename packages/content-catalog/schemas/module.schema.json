{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aalie.dev/schemas/content/module.schema.json",
  "title": "AALIE Content Module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "spaceId",
    "moduleId",
    "slug",
    "title",
    "order",
    "locale",
    "version",
    "status",
    "chapters"
  ],
  "$defs": {
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/prerequisiteRef"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/prerequisiteRef"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "aalie.content.module"
    },
    "schemaVersion": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/semver"
    },
    "spaceId": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^mod-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
    },
    "title": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
    },
    "shortTitle": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/locale"
    },
    "version": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/semver"
    },
    "status": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/status"
    },
    "summary": {
      "type": "string"
    },
    "difficulty": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/difficulty"
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
      }
    },
    "searchMeta": {
      "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/searchMeta"
    },
    "prerequisites": {
      "$ref": "#/$defs/prerequisites"
    },
    "relatedModuleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mod-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/learningObjective"
      }
    },
    "quizRefs": {
      "type": "array",
      "items": {
        "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/quizRef"
      }
    },
    "contentRefs": {
      "type": "array",
      "items": {
        "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/contentRef"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/imageResource"
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/imageResource"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/referenceResource"
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/term"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapterId", "slug", "title", "order", "sections"],
        "properties": {
          "chapterId": {
            "type": "string",
            "pattern": "^cap-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
          },
          "title": {
            "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sectionId",
                "slug",
                "title",
                "order",
                "kind",
                "trackProgress",
                "blocks"
              ],
              "properties": {
                "sectionId": {
                  "type": "string",
                  "pattern": "^sec-[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "slug": {
                  "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/idSlug"
                },
                "title": {
                  "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/nonEmptyString"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/sectionKind"
                },
                "trackProgress": {
                  "type": "boolean"
                },
                "estimatedMinutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "learningObjectives": {
                  "type": "array",
                  "items": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/learningObjective"
                  }
                },
                "quizRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/quizRef"
                  }
                },
                "contentRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/contentRef"
                  }
                },
                "searchMeta": {
                  "$ref": "https://aalie.dev/schemas/content/shared.schema.json#/$defs/searchMeta"
                },
                "prerequisites": {
                  "$ref": "#/$defs/prerequisites"
                },
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://aalie.dev/schemas/content/block.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
