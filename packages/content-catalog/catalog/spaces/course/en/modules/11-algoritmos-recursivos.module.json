  "learningObjectives": [
    {
      "objectiveId": "definir-algoritmo-recursivo",
      "text": "Deende what a recursive algorithm is and differentiate its follow-up from the follow-up of an iterative algorithm."
    },
    {
      "objectiveId": "explicar-ambientes-ejecucion-pila",
      "text": "Explain how execution environments are created on the stack during recursive calls."
    },
    {
      "objectiveId": "identificar-caso-base-caso-general",
      "text": "Identify base case and general case in a recursive algorithm."
    },
    {
      "objectiveId": "seguir-fibonacci-recursivo",
      "text": "Follow the recursive execution of Fibonacci for n=5 using a call tree."
    },
    {
      "objectiveId": "plantear-recurrencia-fibonacci",
      "text": "Establish the Fibonacci recurrence equation from its pseudocode."
    },
    {
      "objectiveId": "seguir-torres-hanoi",
      "text": "Follow the recursive strategy of Towers of Hanoi and its call tree."
    },
    {
      "objectiveId": "plantear-recurrencia-hanoi",
      "text": "Pose and recognize the recurrence T(n)=2T(n-1)+1 of the Towers of Hanoi."
    },
    {
      "objectiveId": "clasificar-recurrencias",
      "text": "Classify recurrence equations as divide and conquer, subtraction and conquer, or subtract and be conquered."
    },
    {
      "objectiveId": "reconocer-recursion-cola",
      "text": "Recognize tail recursion and explain why it is convenient to convert it to iterative."
    }
  ],
  "quizRefs": [],
  "contentRefs": [],
  "terms": [
    {
      "termId": "term-algoritmo-recursivo",
      "label": "Recursive algorithm",
      "definition": "Algorithm that calls itself as part of its solution."
    },
    {
      "termId": "term-ambiente-ejecucion",
      "label": "Execution environment",
      "definition": "Frame created by the system in each recursive call, where parameters, local variables and return address are saved."
    },
    {
      "termId": "term-marco-pila",
      "label": "stack frame",
      "definition": "Another name for execution environment within the call stack."
    },
    {
      "termId": "term-pila",
      "label": "Stack",
      "definition": "Structure where the execution environments of the pending recursive calls are stacked."
    },
    {
      "termId": "term-direccion-retorno",
      "label": "Return address",
      "definition": "The exact point in the code that a call should return to when it ends."
    },
    {
      "termId": "term-caso-base",
      "label": "Base case",
      "definition": "Stop condition of a recursion. It is resolved directly and its cost in recurrence is constant."
    },
    {
      "termId": "term-caso-general",
      "label": "General case",
      "definition": "Recursive part where the problem is reduced to smaller versions of itself through recursive calls."
    },
    {
      "termId": "term-ecuacion-recurrencia",
      "label": "Recurrence equation",
      "definition": "Equation that expresses the cost of a recursive algorithm as a function of the cost of solving smaller subproblems."
    },
    {
      "termId": "term-divide-y-venceras",
      "label": "Divide and conquer",
      "definition": "Family of recurrences of the form T(n)=aT(n/b)+f(n), identified by division in the call."
    },
    {
      "termId": "term-resta-y-venceras",
      "label": "Subtract and you will win",
      "definition": "Family of recurrences of the form T(n)=T(n-b)+f(n), with subtraction in the call and a=1."
    },
    {
      "termId": "term-resta-y-seras-vencido",
      "label": "Subtract and you will be defeated",
      "definition": "Family of recurrences of the form T(n)=aT(n-b)+f(n), with subtraction in the so-called and a>1."
    },
    {
      "termId": "term-recursion-cola",
      "label": "Tail recursion",
      "definition": "Recursion where the recursive call is the last thing that happens in the general case."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-algoritmos-recursivos",
      "slug": "algoritmos-recursivos",
      "title": "Recursive Algorithms",
      "order": 1,
      "summary": "Basic concepts of recursion, stack tracing, classic examples and initial classification of recurrences.",
      "sections": [
        {
          "sectionId": "sec-introduccion-algoritmos-recursivos",
          "slug": "introduccion-algoritmos-recursivos",
          "title": "11. Recursive Algorithms",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "learningObjectives": [
            {
              "objectiveId": "entender-recursion-como-autollamado",
              "text": "Understand that a recursive algorithm calls itself as part of its solution."
            },
            {
              "objectiveId": "contrastar-recursivo-iterativo",
              "text": "Contrast line-by-line iterative analysis with recursive tracing using execution environments."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              },
              {
                "id": "mod-loop-invariant",
                "kind": "required"
              },
              {
                "id": "mod-algoritmos-iterativos-patrones-costos",
                "kind": "required"
              }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-recursivos-prerrequisito",
              "type": "note",
              "variant": "info",
              "title": "Prerequisite",
              "blocks": [
                {
                  "id": "blk-recursivos-prerrequisito-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Modules 1–3: time complexity, elementary operations, iterative loops and stack knowledge."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-recursivos-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A recursive algorithm is one that calls itself as part of its solution. Unlike iterative ones—which are analyzed line by line—recursive ones are followed through execution environments, also called stack frames."
                }
              ]
            },
            {
              "id": "blk-recursivos-naturaleza",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Recursion is in nature: Russian dolls, fractals, the deendition of the factorial. Its power lies in expressing complex solutions in an elegant and concise way."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ambientes-ejecucion-pila",
          "slug": "ambientes-ejecucion-pila",
          "title": "11.1 Execution environments and the stack",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 6,
          "learningObjectives": [
            {
              "objectiveId": "explicar-creacion-ambientes",
              "text": "Explain what happens when a recursive algorithm calls itself."
            },
            {
              "objectiveId": "identificar-contenido-ambiente",
              "text": "Identify what is stored within an execution environment."
            },
            {
              "objectiveId": "relacionar-recursion-espacio",
              "text": "Relate recursion to space cost for stack usage."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-complejidad-espacial",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-ambientes-pila-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Every time a recursive algorithm calls itself, the system creates a new execution environment and stacks it on top of the previous ones."
                }
              ]
            },
            {
              "id": "blk-ambiente-guarda-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In that environment are kept:"
                }
              ]
            },
            {
              "id": "blk-ambiente-guarda-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "All parameters received in that call."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "All local variables declared in that run."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "The return address: the exact point in the code to return to when that call ends."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-ambientes-suspendidos",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As long as the environment is not terminated, all previous environments are suspended waiting on the stack. That is why recursion has a relevant space cost: each environment consumes memory."
                }
              ]
            },
            {
              "id": "blk-regla-casos-base",
              "type": "note",
              "variant": "warning",
              "title": "Base Case Rule",
              "blocks": [
                {
                  "id": "blk-regla-casos-base-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The number of base cases must be EQUAL to the number of calls in the general case. If the general case makes 2 recursive calls, at least 2 base cases are needed. If you make 3, 3 are needed."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-estructura-algoritmo-recursivo",
          "slug": "estructura-algoritmo-recursivo",
          "title": "11.2 Structure of a recursive algorithm",
          "order": 3,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "learningObjectives": [
            {
              "objectiveId": "identificar-dos-partes-recursion",
              "text": "Identify the two mandatory parts of any correct recursive algorithm."
            },
            {
              "objectiveId": "diferenciar-base-general",
              "text": "Differentiate base case and general case."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-ambientes-ejecucion-pila",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-estructura-recursivo-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Every correct recursive algorithm has exactly two parts:"
                }
              ]
            },
            {
              "id": "blk-estructura-obligatoria-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Mandatory structure of a recursive algorithm"
                }
              ]
            },
            {
              "id": "blk-definicion-caso-base",
              "type": "definition",
              "title": "Base case or base cases",
              "blocks": [
                {
                  "id": "blk-definicion-caso-base-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "It is the stopping condition. It is resolved directly, without a recursive call. Its cost in the recurrence equation is always a constant."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-definicion-caso-general",
              "type": "definition",
              "title": "General case",
              "blocks": [
                {
                  "id": "blk-definicion-caso-general-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "It is the situation where the problem is reduced to smaller versions of itself through recursive calls. Here is the logic of the reduction."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ejemplo-fibonacci",
          "slug": "ejemplo-fibonacci",
          "title": "11.3 Example: Fibonacci",
          "order": 4,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "learningObjectives": [
            {
              "objectiveId": "entender-fibonacci-recursivo",
              "text": "Understand the recursive deendition of Fibonacci."
            },
            {
              "objectiveId": "leer-pseudocodigo-fibonacci",
              "text": "Read the base case and general case in the Fibonacci pseudocode."
            },
            {
              "objectiveId": "seguir-fib-cinco",
              "text": "Follow the Fib(5) execution tree."
            },
            {
              "objectiveId": "plantear-recurrencia-fib",
              "text": "Establish the Fibonacci recurrence equation."
            },
            {
              "objectiveId": "reconocer-recalculo-fibonacci",
              "text": "Recognize that Fibonacci without optimization recalculates subproblems and motivates Dynamic Programming."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-estructura-algoritmo-recursivo",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-fibonacci-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fibonacci is the sum of the previous two:"
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(n)=Fib(n-1)+Fib(n-2)"
                },
                {
                  "type": "text",
                  "text": ". In Fibonacci, two base cases are required not because there are two recursive calls, but because the formula depends on two initial values."
                }
              ]
            },
            {
              "id": "blk-fibonacci-pseudocodigo-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Pseudocode"
                }
              ]
            },
            {
              "id": "blk-fibonacci-pseudocodigo",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Fib",
              "code": "int Fib(E int n) {\n  if (n=0) or (n=1) then\n    f <- n # base case: Fib(0)=0, Fib(1)=1\n  else\n    f <- Fib(n-1) + Fib(n-2) # general case\n  endif\n  return f\n}"
            },
            {
              "id": "blk-fibonacci-seguimiento",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Follow up with"
                },
                {
                  "type": "inlineMath",
                  "latex": "n=5"
                },
                {
                  "type": "text",
                  "text": ": the algorithm first solves"
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(4)"
                },
                {
                  "type": "text",
                  "text": "(opens an environment), within that it resolves"
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(3)"
                },
                {
                  "type": "text",
                  "text": ", and so on until we reach the base cases. The"
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(n-2)"
                },
                {
                  "type": "text",
                  "text": "of each level remains pending until the left one endishes."
                }
              ]
            },
            {
              "id": "blk-fibonacci-mermaid",
              "type": "mermaid",
              "title": "Diagram in Mermaid — Fib(5)",
              "code": "graph TD\nA[\"n = 5<br/>fib(4) + fib(3)<br/>3 + 2<br/>return 5\"]\nA --> B[\"n = 4<br/>fib(3) + fib(2)<br/>2 + 1<br/>return 3\"]\nA --> C[\"n = 3<br/>fib(2) + fib(1)<br/>1 + 1<br/>return 2\"]\nB --> D[\"n = 3<br/>fib(2) + fib(1)<br/>1 + 1<br/>return 2\"]\nB --> E[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nC --> F[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nC --> G[\"n = 1<br/>return 1\"]\nD --> H[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nD --> I[\"n = 1<br/>return 1\"]\nE --> J[\"n = 1<br/>return 1\"]\nE --> K[\"n = 0<br/>return 0\"]\nF --> L[\"n = 1<br/>return 1\"]\nF --> M[\"n = 0<br/>return 0\"]\nH --> N[\"n = 1<br/>return 1\"]\nH --> O[\"n = 0<br/>return 0\"]\nJ -.-> E\nK -.-> E\nL -.-> F\nM -.-> F\nN -.-> H\nO -.-> H\nH -.-> D\nI -.-> D\nD -.-> B\nE -.-> B\nF -.-> C\nG -.-> C\nB -.-> A\nC -.-> A"
            },
            {
              "id": "blk-fibonacci-nota-costo",
              "type": "note",
              "variant": "warning",
              "title": "About the cost",
              "blocks": [
                {
                  "id": "blk-fibonacci-nota-costo-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Fibonacci without optimization recalculates the same subproblems many times."
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(5)"
                    },
                    {
                      "type": "text",
                      "text": "calculate"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(3)"
                    },
                    {
                      "type": "text",
                      "text": "twice."
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(30)"
                    },
                    {
                      "type": "text",
                      "text": "It is hugely inefficient. This motivates Dynamic Programming (Module 13)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-fibonacci-recurrencia-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Recurrence equation"
                }
              ]
            },
            {
              "id": "blk-fibonacci-recurrencia",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "step-fib-base-0",
                  "title": "Base case 0",
                  "latex": "T(0)=1"
                },
                {
                  "stepId": "step-fib-base-1",
                  "title": "Base case 1",
                  "latex": "T(1)=1"
                },
                {
                  "stepId": "step-fib-base-summary",
                  "title": "Base cases",
                  "latex": "T(0)=1,\\quad T(1)=1 \\quad \\text{are constants}"
                },
                {
                  "stepId": "step-fib-general",
                  "title": "General case",
                  "latex": "T(n)=T(n-1)+T(n-2)\\quad \\text{for } n\\ge 2"
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ejemplo-torres-hanoi",
          "slug": "ejemplo-torres-hanoi",
          "title": "11.4 Example: Towers of Hanoi",
          "order": 5,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 14,
          "learningObjectives": [
            {
              "objectiveId": "entender-problema-hanoi",
              "text": "Understand the Towers of Hanoi problem, its towers, disks and rules."
            },
            {
              "objectiveId": "describir-estrategia-recursiva-hanoi",
              "text": "Describe the three-step recursive strategy for moving n disks."
            },
            {
              "objectiveId": "leer-pseudocodigo-hanoi",
              "text": "Read the base case and the general case in the Towers of Hanoi pseudocode."
            },
            {
              "objectiveId": "interpretar-arbol-hanoi",
              "text": "Interpret the Towers of Hanoi recursion tree."
            },
            {
              "objectiveId": "plantear-costo-hanoi",
              "text": "Pose and resolve the recurrence of the Towers of Hanoi."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-estructura-algoritmo-recursivo",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-hanoi-descripcion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Three towers (origin, auxiliary, destination) and"
                },
                {
                  "type": "inlineMath",
                  "latex": "n"
                },
                {
                  "type": "text",
                  "text": "disks stacked from largest to smallest at the origin."
                }
              ]
            },
            {
              "id": "blk-hanoi-reglas",
              "type": "note",
              "variant": "info",
              "title": "Rules",
              "blocks": [
                {
                  "id": "blk-hanoi-reglas-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Move one disk at a time, never put a larger one on top of a smaller one."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-hanoi-estrategia-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Recursive strategy: to move"
                },
                {
                  "type": "inlineMath",
                  "latex": "n"
                },
                {
                  "type": "text",
                  "text": "disks from source to destination:"
                }
              ]
            },
            {
              "id": "blk-hanoi-estrategia-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
