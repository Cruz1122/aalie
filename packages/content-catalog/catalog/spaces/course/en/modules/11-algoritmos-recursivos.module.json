              "id": "blk-clasificacion-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Before choosing the solution method, we must identify what type of equation we have:"
                }
              ]
            },
            {
              "id": "blk-clasificacion-recurrencias-tabla",
              "type": "table",
              "title": "Classification of recurrence equations",
              "columns": [
                {
                  "key": "tipo",
                  "label": "Type"
                },
                {
                  "key": "forma",
                  "label": "Shape"
                },
                {
                  "key": "identificador",
                  "label": "Identifier"
                },
                {
                  "key": "ejemplo",
                  "label": "Example"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Divide and conquer"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "T(n)=aT(n/b)+f(n)"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Division in the call"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Merge Sort, Binary Search"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Subtract and you will win"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "T(n)=T(n-b)+f(n)"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Remains in the call,"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "a=1"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Recursive sequential search"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Subtract and you will be defeated"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "T(n)=aT(n-b)+f(n)"
                      }
                    ],
                    [
                      {
                        "type": "text",
