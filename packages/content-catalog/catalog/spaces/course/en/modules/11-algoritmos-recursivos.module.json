            {
              "id": "blk-hanoi-pseudocodigo",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "T.H.",
              "code": "TH(E int n, E char o, E char a, E char d) {\n  if (n = 1) then\n    Print('move disk from source to destination') # base case\n  else\n    TH(n-1, o, d, a) # move n-1 disks to the auxiliary peg\n    Print('move disk from source to destination')\n    TH(n-1, a, o, d) # move n-1 disks to the destination peg\n  endif\n}"
            },
