        {
          "sectionId": "sec-demostracion-theta-n2",
          "slug": "demostracion-theta-n2",
          "title": "Proof 1: 3n² + 5n ∈ Θ(n²)",
          "order": 2,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "learningObjectives": [
            {
              "objectiveId": "calcular-limite-theta",
              "text": "Calculate the limit of (3n² + 5n)/n²."
            },
            {
              "objectiveId": "aplicar-teorema-theta",
              "text": "Apply the theorem when the limit is a finite positive constant."
            },
            {
              "objectiveId": "verificar-theta-definicion",
              "text": "Verify membership in Θ(n²) using c₁, c₂ and n₀."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-notaciones-asintoticas",
                "kind": "required"
              },
              {
                "id": "mod-tabla-maestra-notaciones-convenciones",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-teorema-general-limites",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-demo1-enunciado",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "show that"
                },
                {
                  "type": "inlineMath",
                  "latex": "3n^2 + 5n \\in \\Theta(n^2)"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-demo1-paso1-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Step 1 — Calculate the limit (Conv. A)"
                }
              ]
            },
            {
              "id": "blk-demo1-paso1-formulas",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "plantear",
                  "title": "Set the limit",
                  "latex": "\\lim_{n \\to \\infty}\\frac{3n^2 + 5n}{n^2}"
                },
                {
                  "stepId": "dividir",
                  "title": "Divide each term of the numerator by n²",
                  "latex": "\\lim_{n \\to \\infty}\\left(\\frac{3n^2}{n^2} + \\frac{5n}{n^2}\\right)"
                },
                {
                  "stepId": "simplificar",
                  "title": "Simplify",
                  "latex": "\\lim_{n \\to \\infty}\\left(3 + \\frac{5}{n}\\right)"
                },
                {
                  "stepId": "evaluar",
                  "title": "Evaluate",
                  "latex": "3 + 0 = 3"
                }
              ]
            },
            {
              "id": "blk-demo1-paso2-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Step 2 — Apply the theorem"
                }
              ]
            },
            {
              "id": "blk-demo1-paso2-text",
              "type": "paragraph",
              "content": [
                {
                  "type": "inlineMath",
                  "latex": "L = 3"
                },
                {
                  "type": "text",
                  "text": ", which is a finite positive constant"
                },
                {
                  "type": "inlineMath",
                  "latex": "(0 < 3 < \\infty)"
                },
                {
                  "type": "text",
                  "text": ". By the theorem, this implies"
                },
                {
                  "type": "inlineMath",
                  "latex": "f \\in \\Theta(n^2)"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Step 3 — Verification with formal definition"
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We take"
                },
                {
                  "type": "inlineMath",
                  "latex": "c_1 = 3"
                },
                {
                  "type": "text",
                  "text": "and"
                },
                {
                  "type": "inlineMath",
                  "latex": "c_2 = 4"
                },
                {
                  "type": "text",
                  "text": ", and we search"
                },
                {
                  "type": "inlineMath",
                  "latex": "n_0"
                },
                {
                  "type": "text",
                  "text": "such that:"
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-desigualdad",
              "type": "equationBlock",
              "latex": "3n^2 \\le 3n^2 + 5n \\le 4n^2 \\quad \\text{for all } n \\ge n_0"
            },
            {
              "id": "blk-demo1-paso3-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Left inequality"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "3n^2 \\le 3n^2 + 5n"
                    },
                    {
                      "type": "text",
                      "text": "is always true for"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 0"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "The right inequality"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "3n^2 + 5n \\le 4n^2"
                    },
                    {
                      "type": "text",
                      "text": "equivalent to"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "5n \\le n^2"
                    },
                    {
                      "type": "text",
                      "text": ", that is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 5"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-demo1-resultado",
              "type": "note",
              "variant": "success",
              "title": "Conclusion",
              "blocks": [
                {
                  "id": "blk-demo1-resultado-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "taking"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n_0 = 5"
                    },
                    {
                      "type": "text",
                      "text": ", the property holds for everything"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 5"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
