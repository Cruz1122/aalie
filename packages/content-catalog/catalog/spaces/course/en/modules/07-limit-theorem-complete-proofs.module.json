                  "type": "inlineMath",
                  "latex": "n < c \\cdot n^2"
                },
                {
                  "type": "text",
                  "text": "for"
                },
                {
                  "type": "inlineMath",
                  "latex": "n \\ge n_0"
                },
                {
                  "type": "text",
                  "text": "."
                }
