  "learningObjectives": [
    {
      "objectiveId": "enunciar-teorema-limites",
      "text": "State the limit criterion for asymptotic notations in Convention A and Convention B."
    },
    {
      "objectiveId": "aplicar-convencion-a",
      "text": "Apply the theorem using Convention A, based on lim f(n)/g(n)."
    },
    {
      "objectiveId": "aplicar-convencion-b",
      "text": "Apply the theorem using Convention B from the course, based on lim g(n)/f(n)."
    },
    {
      "objectiveId": "demostrar-theta",
      "text": "Formally prove that 3n² + 5n belongs to Θ(n²)."
    },
    {
      "objectiveId": "demostrar-little-o",
      "text": "Formally prove that n belongs to o(n²)."
    },
    {
      "objectiveId": "demostrar-little-omega",
      "text": "Formally prove that n² belongs to ω(n)."
    },
    {
      "objectiveId": "verificar-con-definicion",
      "text": "Verify an asymptotic conclusion using the formal definition with constants and n₀."
    },
    {
      "objectiveId": "reconocer-caso-oscilatorio",
      "text": "Recognize that if the limit does not exist, for example due to oscillation, the theorem does not automatically allow us to conclude with this criterion."
    }
  ],
  "quizRefs": [],
  "contentRefs": [],
  "terms": [
    {
      "termId": "term-teorema-limites",
      "label": "Limits theorem",
      "definition": "Criterion that allows deciding membership in asymptotic notations based on the limit of the quotient between two functions."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convention A",
      "definition": "Convention that calculates L = lim f(n)/g(n) as n approaches infinity."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convention B / course",
      "definition": "Course convention that calculates L' = lim g(n)/f(n) as n tends to infinity."
    },
    {
      "termId": "term-limite-cero",
      "label": "Zero limit",
      "definition": "Case where the quotient tends to 0; under Convention A denotes f ∈ o(g) and f ∈ O(g)."
    },
    {
      "termId": "term-limite-constante",
      "label": "Finite positive constant limit",
      "definition": "Case where the quotient tends to a constant c with 0 < c < ∞; indicates f ∈ Θ(g)."
    },
    {
      "termId": "term-limite-uno",
      "label": "Limit one",
      "definition": "Case where the quotient tends exactly to 1; indicates f ~ g."
    },
    {
      "termId": "term-limite-infinito",
      "label": "infinite limit",
      "definition": "Case where the quotient tends to +∞; under Convention A denotes f ∈ ω(g) and f ∈ Ω(g)."
    },
    {
      "termId": "term-caso-oscilatorio",
      "label": "Oscillatory case",
      "definition": "Case where the limit does not exist due to oscillation; The direct limit criterion does not automatically conclude a notation."
    },
    {
      "termId": "term-verificacion-formal",
      "label": "Formal verification",
      "definition": "Step where the conclusion is confirmed using the formal definition of the notation, with constants and an appropriate n₀."
    },
    {
      "termId": "term-n0",
      "label": "n₀",
      "definition": "Point from which an asymptotic inequality must be satisfied."
    }
  ],
