                  "latex": "n < c \\cdot n^2"
                },
                {
                  "stepId": "dividir",
                  "title": "We divide by positive n",
                  "latex": "1 < c \\cdot n"
                },
                {
                  "stepId": "despejar",
                  "title": "We clear n",
                  "latex": "n > \\frac{1}{c}"
                }
              ]
            },
