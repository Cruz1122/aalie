  "learningObjectives": [
    {
      "objectiveId": "leer-matriz-comparaciones",
      "text": "Read a comparison matrix between f(n) and g(n) using both limit conventions."
    },
    {
      "objectiveId": "determinar-notaciones-aplicables",
      "text": "Determine which notations apply for a pair of functions: O, Ω, Θ, o, ω and ~."
    },
    {
      "objectiveId": "interpretar-limite-cero-infinito",
      "text": "Interpret the cases where Convention A gives 0 and Convention B gives ∞, or vice versa."
    },
    {
      "objectiveId": "interpretar-limite-constante",
      "text": "Interpret the cases where both conventions give reciprocal finite constants."
    },
    {
      "objectiveId": "identificar-equivalencia-tilde",
      "text": "Identify when the exact asymptotic equivalence f ~ g applies."
    },
    {
      "objectiveId": "usar-tabla-como-referencia",
      "text": "Use the matrix as a quick reference for asymptotic comparison exercises."
    }
  ],
  "quizRefs": [],
  "contentRefs": [],
  "terms": [
    {
      "termId": "term-matriz-comparaciones",
      "label": "Comparison Matrix",
      "definition": "Table that crosses pairs of functions f(n) and g(n), shows their limits in both conventions and marks which notations apply."
    },
    {
      "termId": "term-par-funciones",
      "label": "Pair of functions",
      "definition": "Two functions f(n) and g(n) that are compared to determine their asymptotic relationship."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convention A",
      "definition": "Convention that calculates the limit of f(n)/g(n)."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convention B / course",
      "definition": "Convention used in the course that calculates the limit of g(n)/f(n)."
    },
    {
      "termId": "term-simetria-limites",
      "label": "Limit symmetry",
      "definition": "Relationship between both conventions: if one gives 0, the other gives ∞; If one gives a finite constant, the other gives its reciprocal; If one gives 1, the other also gives 1."
    },
    {
      "termId": "term-reciproco",
      "label": "Reciprocal",
      "definition": "Multiplicative inverse number. If a limit gives c, the inverted limit gives 1/c when c is finite and positive."
    }
  ],
