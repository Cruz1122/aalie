        {
          "sectionId": "sec-receta-analizar-algoritmo-iterativo",
          "slug": "receta-analizar-algoritmo-iterativo",
          "title": "10.1 Recipe for analyzing an iterative algorithm",
          "order": 2,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "seguir-receta-iterativa",
              "text": "Follow a minimal sequence of steps to analyze an iterative algorithm."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              },
              {
                "id": "mod-algoritmos-iterativos-patrones-costos",
                "kind": "required"
              }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-receta-iterativo-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Identify all the lines, without counting the"
                    },
                    {
                      "type": "inlineCode",
                      "text": "end"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "For each line, determine how many times it is executed based on"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Add all the costs to obtain"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "T(n)"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Identify the dominant term and apply asymptotic notation."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-receta-demostrar-pertenencia-asintotica",
          "slug": "receta-demostrar-pertenencia-asintotica",
          "title": "10.2 Recipe to demonstrate membership in an asymptotic family",
          "order": 3,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "seguir-receta-pertenencia",
              "text": "Follow a minimal sequence to demonstrate membership in an asymptotic family using limits."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-notaciones-asintoticas",
                "kind": "required"
              },
              {
                "id": "mod-demostraciones-completas-teorema-limites",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-teorema-general-limites",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-receta-pertenencia-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Calculate"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "L=\\lim_{n\\to\\infty}\\frac{f(n)}{g(n)}"
                    },
                    {
                      "type": "text",
                      "text": "or"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "L=\\lim_{n\\to\\infty}\\frac{g(n)}{f(n)}"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Apply the limits theorem to identify which notations apply."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Conclude explicitly with the corresponding notation."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-tecnicas-calcular-limites",
          "slug": "tecnicas-calcular-limites",
          "title": "10.3 Techniques for calculating limits",
          "order": 4,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "identificar-tecnicas-limites",
              "text": "Identify common techniques to solve limits in asymptotic comparisons."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-demostraciones-completas-teorema-limites",
                "kind": "required"
              }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-tecnicas-limites-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Divide numerator and denominator by the dominant term of the denominator."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "L'Hôpital's rule: if the limit is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "\\infty/\\infty"
                    },
                    {
                      "type": "text",
                      "text": "or"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "0/0"
                    },
                    {
                      "type": "text",
                      "text": ", derive numerator and denominator."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Logarithms: to compare exponential functions, apply log to both."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Taylor series: for finer approximations near the limit."
                    }
                  ]
                }
              ]
            }
          ]
        },
