  "terms": [
    {
      "termId": "term-for-simple",
      "label": "for simple",
      "definition": "Cycle whose counter runs through a linear range, usually from 1 to n."
    },
    {
      "termId": "term-for-anidado",
      "label": "for nested",
      "definition": "For loop located inside another for loop. Its cost depends on the combination of both ranges."
    },
    {
      "termId": "term-limite-fijo",
      "label": "fixed limit",
      "definition": "Limit of an internal cycle that does not depend on the external index."
    },
    {
      "termId": "term-limite-variable",
      "label": "variable limit",
      "definition": "Limit of an internal cycle that depends on the external index."
    },
    {
      "termId": "term-while-duplicacion",
      "label": "while with duplication",
      "definition": "While loop where the control variable is multiplied by a constant, generating logarithmic behavior."
    },
    {
      "termId": "term-busqueda-secuencial",
      "label": "sequential search",
      "definition": "Algorithm that traverses an array position by position until an element is found or confirmed that it is not there."
    },
    {
      "termId": "term-mejor-caso",
      "label": "best case",
      "definition": "Input that causes the algorithm to perform the least amount of work possible."
    },
    {
      "termId": "term-peor-caso",
      "label": "worst case",
      "definition": "Input that causes the algorithm to perform as much work as possible."
    },
    {
      "termId": "term-caso-promedio",
      "label": "average case",
      "definition": "Expected cost when possible inputs are considered under a probabilistic model, for example uniform distribution."
    },
    {
      "termId": "term-metodo-limites",
      "label": "limits method",
      "definition": "Formal technique to compare two functions by calculating the limit of the quotient between them when n tends to infinity."
    }
  ],
