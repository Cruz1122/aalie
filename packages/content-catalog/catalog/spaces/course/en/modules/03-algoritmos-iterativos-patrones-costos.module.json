            },
            {
              "objectiveId": "aplicar-limite-cociente",
              "text": "Apply the quotient limit to decide which function grows the fastest."
            },
            {
              "objectiveId": "interpretar-limite-cero-constante-infinito",
              "text": "Interpret the cases L=0, L constant positive and L infinite."
            }
