              }
            ]
          },
          "blocks": [
            {
              "id": "blk-comparar-funciones-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The correct way to compare functions is not by graphing or tabulating. Inequalities and limits are used."
                }
              ]
            },
            {
              "id": "blk-metodo-limites-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Limits method"
                }
              ]
            },
            {
              "id": "blk-metodo-limites-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "To compare"
                },
                {
                  "type": "inlineMath",
                  "latex": "f(n)"
                },
                {
                  "type": "text",
                  "text": "and"
                },
                {
                  "type": "inlineMath",
                  "latex": "g(n)"
                },
                {
                  "type": "text",
                  "text": ", we calculate:"
                }
              ]
            },
            {
              "id": "blk-metodo-limites-formula",
              "type": "equationBlock",
              "latex": "\\lim_{n \\to \\infty}\\frac{f(n)}{g(n)} = L"
            },
            {
              "id": "blk-metodo-limites-tabla",
              "type": "table",
              "title": "Interpretation of the limit to compare functions",
              "columns": [
                {
                  "key": "resultado",
                  "label": "Result L"
                },
                {
                  "key": "significado",
                  "label": "Meaning"
                },
                {
                  "key": "relacion",
                  "label": "Relationship"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "inlineMath",
                        "latex": "L=0"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      },
                      {
                        "type": "text",
                        "text": "grows faster than"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "grows slower than"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "L = constant"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "(c>0)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "and"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      },
                      {
                        "type": "text",
                        "text": "they grow at the same speed"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "They are of the same order"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineMath",
                        "latex": "L=\\infty"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "grows faster than"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "dominates"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Example"
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-enunciado",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Compare"
                },
                {
                  "type": "inlineMath",
                  "latex": "f(n)=3n^2+5n"
                },
                {
                  "type": "text",
                  "text": "and"
                },
                {
                  "type": "inlineMath",
                  "latex": "g(n)=n^2"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-limite",
              "type": "latexSteps",
              "title": "Limit calculation",
              "steps": [
                {
                  "stepId": "plantear-el-cociente",
                  "title": "Set the quotient",
                  "latex": "\\lim_{n \\to \\infty}\\frac{3n^2+5n}{n^2}"
                },
                {
                  "stepId": "dividir-por-n-cuadrado",
                  "title": "Divide by n^2",
                  "latex": "\\lim_{n \\to \\infty}\\left(3+\\frac{5}{n}\\right)"
                },
                {
                  "stepId": "evaluar-el-limite",
                  "title": "Evaluate the limit",
                  "latex": "3+0=3"
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-conclusion",
              "type": "note",
              "variant": "success",
              "title": "Conclusion",
              "blocks": [
                {
                  "id": "blk-ejemplo-comparar-funciones-conclusion-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "inlineMath",
                      "latex": "L=3"
                    },
                    {
                      "type": "text",
                      "text": "It is a positive constant. then"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "f(n)"
                    },
                    {
                      "type": "text",
                      "text": "and"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "g(n)"
                    },
                    {
                      "type": "text",
                      "text": "They are of the same order. They grow at the same speed."
                    }
                  ]
                }
              ]
            }
          ]
        }
