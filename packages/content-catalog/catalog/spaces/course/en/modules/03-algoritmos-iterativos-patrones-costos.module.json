              "type": "algorithm",
              "language": "pseudocode",
              "title": "SearchSequential",
              "code": "int BusquedaSecuencial (E int A[n], E int x) { i <- 1 # C1 * 1 while (A[i]<>x) and (i<=n) # C2 * (n+1) en peor caso i <- i + 1 # C3 * n endwhile if (i <= n) then # C4 * 1 return i else return -1 # C5 * 1\n}"
