  "terms": [
    {
      "termId": "term-tabla-maestra",
      "label": "Master table",
      "definition": "Reference table that concentrates the six asymptotic notations, their type of bound and their criterion under the two limit conventions."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convention A",
      "definition": "Convention that compares functions using the limit f(n)/g(n)."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convention B / course",
      "definition": "Convention used in the course that compares functions using the g(n)/f(n) limit."
    },
    {
      "termId": "term-igualdad-con-g",
      "label": "Equality with g",
      "definition": "Tell whether the notation allows f to grow at the same rate as g."
    },
    {
      "termId": "term-cota-superior-exacta",
      "label": "Upper bound that can be exact",
      "definition": "Case in which an upper bound also allows f and g to grow at the same rate."
    },
    {
      "termId": "term-cota-inferior-exacta",
      "label": "Lower bound that can be exact",
      "definition": "Case in which a lower bound also allows f and g to grow at the same rate."
    },
    {
      "termId": "term-cota-estricta",
      "label": "strict bound",
      "definition": "Boundary that excludes asymptotic equality with the reference function."
    },
    {
      "termId": "term-equivalencia-exacta",
      "label": "Exact equivalence",
      "definition": "Asymptotic relationship where the quotient between the functions tends exactly to 1."
    }
  ],
