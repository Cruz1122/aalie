    {
      "objectiveId": "consultar-seis-notaciones",
      "text": "Consult the six asymptotic notations of the course in a single table."
    },
    {
      "objectiveId": "comparar-convenciones-limites",
      "text": "Compare Convention A, based on lim f/g, with Convention B of the course, based on lim g/f."
    },
    {
      "objectiveId": "identificar-tipo-cota",
      "text": "Identify whether a notation expresses upper bound, lower bound, exact bound, strict bound, or exact equivalence."
    },
    {
      "objectiveId": "reconocer-igualdad-con-g",
      "text": "Recognize which notations allow equality with g and which exclude equality."
    },
    {
      "objectiveId": "evitar-confusion-o-omega",
      "text": "Avoid confusion between the O and Ω criteria when switching from one limit convention to another."
    },
    {
      "objectiveId": "ubicar-theta-tilde",
      "text": "Recognize that Θ and ~ maintain the same numerical criteria in both conventions."
    }
  ],
