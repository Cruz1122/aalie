  "terms": [
    {
      "termId": "term-branch-and-bound",
      "label": "Branch and Bound",
      "definition": "Optimization technique that explores a decision tree and uses bounds to prune branches that cannot improve the best known solution."
    },
    {
      "termId": "term-ramificacion",
      "label": "Branching",
      "definition": "Process of generating children of a node, usually setting an additional decision."
    },
    {
      "termId": "term-bound",
      "label": "Dimension",
      "definition": "Mathematical estimate that limits the best possible value achievable from a node."
    },
    {
      "termId": "term-cota-superior",
      "label": "Upper bound",
      "definition": "In maximization, an optimistic estimate of the maximum value that could be achieved from a node."
    },
    {
      "termId": "term-cota-inferior",
      "label": "Lower bound",
      "definition": "Value guaranteed by a partial solution or by a known feasible solution."
    },
    {
      "termId": "term-incumbente",
      "label": "Incumbent",
      "definition": "Best complete feasible solution known during the execution of the algorithm."
    },
    {
      "termId": "term-lista-nodos-vivos",
      "label": "List of Live Nodes",
      "definition": "Set of nodes generated but not yet explored. Its structure determines the order of travel."
    },
    {
      "termId": "term-poda-suboptimalidad",
      "label": "Pruning for suboptimality",
      "definition": "Pruning discards a branch even if it is feasible because its bound shows that it cannot improve the incumbent solution."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-branch-and-bound",
      "slug": "branch-and-bound",
      "title": "Branch and Bound",
      "order": 1,
      "summary": "Branching, dimensions, pruning for suboptimality and complete example of an entire backpack.",
      "sections": [
        {
          "sectionId": "sec-introduccion-branch-and-bound",
          "slug": "introduccion-branch-and-bound",
          "title": "Branch and Bound: central idea",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 8,
          "blocks": [
            {
              "id": "blk-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Branch and Bound is a technique for solving optimization problems by exploring a decision tree. At each node a bound is calculated that estimates how good the best solution within that branch could be."
                }
              ]
            },
            {
              "id": "blk-bb-intro-ramificar-acotar",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The technique combines two actions: branching and delimiting. Branching means breaking down the problem into more specific decisions. Bounding means estimating whether a branch still has the possibility of improving the best solution found."
                }
              ]
            },
            {
              "id": "blk-bb-idea-central",
              "type": "note",
              "variant": "info",
              "title": "Essential idea",
              "blocks": [
                {
                  "id": "blk-bb-idea-central-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Branch and Bound does not explore a branch just because it is valid. It explores it only if it can still improve the best known solution."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-bb-vs-backtracking-basico",
              "type": "table",
              "title": "Basic difference with backtracking",
              "columns": [
                {
                  "key": "criterio",
