        },
        {
          "sectionId": "sec-conceptos-clave-branch-and-bound",
          "slug": "conceptos-clave-branch-and-bound",
          "title": "Key concepts",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-conceptos-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The algorithm maintains a best known solution and a list of pending nodes. Each node is kept or discarded depending on its dimensions."
                }
              ]
            },
            {
              "id": "blk-modelo-cota-maximizacion",
              "type": "equationBlock",
              "title": "Pruning model in maximization",
              "latex": "podar(N)=\\begin{cases}\\text{verdadero},& CS(N)\\le mejor\\\\\\text{falso},& CS(N)>mejor\\end{cases}"
            },
            {
              "id": "blk-expl-cota-maximizacion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In a maximization problem,"
                },
                {
                  "type": "inlineMath",
                  "latex": "CS(N)"
                },
                {
                  "type": "text",
                  "text": "is the upper bound (optimistic estimate) of the node"
                },
                {
                  "type": "inlineMath",
                  "latex": "N"
                },
                {
                  "type": "text",
                  "text": ". If this maximum possible value does not even reach the best solution already found ("
                },
                {
                  "type": "strong",
                  "text": "better"
                },
                {
                  "type": "text",
                  "text": "), the branch is cut because there is no point in continuing to explore something that cannot surpass what we already have."
                }
              ]
            },
            {
              "id": "blk-modelo-cota-minimizacion",
              "type": "equationBlock",
              "title": "Pruning model in minimization",
              "latex": "podar(N)=\\begin{cases}\\text{verdadero},& CI(N)\\ge mejor\\\\\\text{falso},& CI(N)<mejor\\end{cases}"
            },
            {
              "id": "blk-expl-cota-minimizacion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In minimization,"
                },
                {
                  "type": "inlineMath",
                  "latex": "CI(N)"
                },
                {
                  "type": "text",
                  "text": "represents the lower bound (the minimum estimated cost). If the lowest cost we could achieve on this branch is greater than or equal to the best known cost, we discard the node."
                }
              ]
            },
            {
              "id": "blk-conceptos-bb-table",
              "type": "table",
              "title": "Branch and Bound Technical Glossary",
              "columns": [
                {
                  "key": "concepto",
                  "label": "Concept"
                },
                {
                  "key": "rol",
                  "label": "Role in the algorithm"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "strong",
                        "text": "Global level / Incumbent"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Reference of the best feasible value found so far."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "strong",
                        "text": "List of Live Nodes (LNV)"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Structure that saves the generated but not expanded nodes."
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-modelo-general-branch-and-bound",
          "slug": "modelo-general-branch-and-bound",
          "title": "General Branch and Bound Model",
          "order": 3,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 14,
          "blocks": [
            {
              "id": "blk-modelo-general-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Each node represents a partial solution. In addition to the decisions made, the node stores the accumulated value, the resources used, an optimistic bound and the next decision level."
                }
              ]
            },
            {
              "id": "blk-modelo-nodo-bb",
              "type": "equationBlock",
              "title": "node model",
              "latex": "N=(X_k,valor(N),recurso(N),CI(N),CS(N),k)"
            },
            {
              "id": "blk-expl-nodo-bb",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "a node"
                },
                {
                  "type": "strong",
                  "text": "N"
                },
                {
                  "type": "text",
                  "text": "is defined by the vector of partial decisions"
                },
                {
                  "type": "inlineMath",
                  "latex": "X_k"
                },
                {
                  "type": "text",
                  "text": ", the value and resource consumed so far, the lower bounds ("
                },
                {
                  "type": "inlineMath",
                  "latex": "CI"
                },
                {
                  "type": "text",
                  "text": ") and higher ("
                },
                {
                  "type": "inlineMath",
                  "latex": "CS"
                },
                {
                  "type": "text",
                  "text": "), and the level"
                },
                {
                  "type": "inlineMath",
                  "latex": "k"
                },
                {
                  "type": "text",
                  "text": "in the decision tree."
                }
              ]
            },
            {
              "id": "blk-modelo-ramificacion-bb",
              "type": "equationBlock",
              "title": "Binary branch model",
              "latex": "hijos(N)=\\begin{cases}N_{incluir}:x_{k+1}=1\\\\N_{excluir}:x_{k+1}=0\\end{cases}"
            },
            {
              "id": "blk-expl-ramificacion-bb",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Branching consists of dividing the current problem into two or more subproblems. In the binary case, this usually means making a decision (value 1) or ignoring it (value 0) for the next element of the problem."
                }
              ]
            },
            {
              "id": "blk-modelo-actualizacion-mejor",
              "type": "equationBlock",
              "title": "Best solution update",
              "latex": "mejor_{t+1}=\\begin{cases}valor(N),& esFactible(N)\\ \\land\\ esCompleto(N)\\ \\land\\ valor(N)>mejor_t\\\\mejor_t,& \\text{en otro caso}\\end{cases}"
            },
            {
              "id": "blk-expl-actualizacion-mejor",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The variable"
                },
                {
                  "type": "inlineMath",
                  "latex": "mejor"
                },
                {
                  "type": "text",
                  "text": "It is updated only when we find a solution that is feasible (meets constraints), complete (all decisions made) and that also exceeds the previous value."
                }
              ]
            },
            {
              "id": "blk-modelo-poda-completa-bb",
              "type": "equationBlock",
              "title": "Complete node decision model",
              "latex": "estado(N)=\\begin{cases}\\text{podado por infactibilidad},& recurso(N)>limite\\\\\\text{solucion completa},& esCompleto(N)\\ \\land\\ esFactible(N)\\\\\\text{podado por suboptimalidad},& CS(N)\\le mejor\\\\\\text{vivo},& \\text{en otro caso}\\end{cases}"
            },
            {
              "id": "blk-expl-poda-completa-bb",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This model summarizes the fate of a node. It can die because it exceeds resources, because it is a leaf on the tree, or because it is suboptimal (its upper bound does not exceed the best). If none of this is done, the node remains"
                },
                {
                  "type": "strong",
                  "text": "alive"
                },
                {
                  "type": "text",
                  "text": "to be explored later."
                }
              ]
            },
            {
              "id": "blk-modelo-general-bb-flujo",
              "type": "mermaid",
              "title": "General Flow of Branch and Bound",
              "code": "flowchart TD\n  A[\"Crear nodo raíz\"] --> B[\"Calcular cotas\"]\n  B --> C[\"Insertar en Lista de Nodos Vivos\"]\n  C --> D{\"¿LNV vacía?\"}\n  D -- \"Sí\" --> E[\"Retornar mejor solución\"]\n  D -- \"No\" --> F[\"Extraer nodo según estrategia\"]\n  F --> G{\"¿Podar?\"}\n  G -- \"Sí\" --> D\n  G -- \"No\" --> H{\"¿Solución completa?\"}\n  H -- \"Sí\" --> I[\"Actualizar mejor si mejora\"]\n  I --> D\n  H -- \"No\" --> J[\"Ramificar\"]\n  J --> K[\"Calcular cotas de hijos\"]\n  K --> L[\"Insertar hijos vivos\"]\n  L --> D"
            }
          ]
        },
        {
          "sectionId": "sec-mochila-entera-planteamiento-bb",
          "slug": "mochila-entera-planteamiento-bb",
          "title": "Complete example: Entire backpack 0/1",
          "order": 4,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-mochila-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The entire 0/1 backpack contains objects with value and weight. The goal is to maximize total value without exceeding capacity."
                }
              ]
            },
            {
              "id": "blk-mochila-bb-modelo-decision",
              "type": "equationBlock",
              "title": "Decision model",
              "latex": "x_i=\\begin{cases}1,& \\text{si el objeto }i\\text{ se incluye}\\\\0,& \\text{si el objeto }i\\text{ se excluye}\\end{cases}"
            },
            {
              "id": "blk-expl-mochila-decision",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The decision variable"
                },
                {
                  "type": "inlineMath",
                  "latex": "x_i"
                },
                {
                  "type": "text",
                  "text": "It is binary. A value of 1 indicates that the object is part of the backpack, and a 0 indicates that it is left outside."
                }
              ]
            },
            {
              "id": "blk-mochila-bb-modelo-objetivo",
              "type": "equationBlock",
              "title": "Optimization model",
              "latex": "\\max\\sum_{i=1}^{n}v_ix_i\\quad \\text{sujeto a}\\quad \\sum_{i=1}^{n}w_ix_i\\le W,\\quad x_i\\in\\{0,1\\}"
            },
            {
              "id": "blk-expl-mochila-objetivo",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We seek to maximize the sum of the values ("
                },
                {
                  "type": "inlineMath",
                  "latex": "v_i"
                },
                {
                  "type": "text",
                  "text": ") of the chosen objects, with the restriction that the sum of their weights ("
                },
                {
                  "type": "inlineMath",
                  "latex": "w_i"
                },
                {
                  "type": "text",
                  "text": ") does not exceed the total capacity"
                },
                {
                  "type": "strong",
                  "text": "W"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-arbol-mochila-mermaid",
              "type": "mermaid",
              "title": "Branch and Bound Exploration Tree — Backpack 0/1",
              "code": "flowchart TD\n  R[\"Raíz<br/>CI = 0<br/>CS = 10.25\"]\n\n  R -->|\"I: incluir obj1\"| A[\"A<br/>Incl. obj1<br/>CI = 2<br/>CS = 10.25\"]\n  R -->|\"N: no incluir obj1\"| B[\"B [Podado]<br/>No obj1<br/>CS = 9.50<br/>PODA\"]\n\n  A -->|\"I: incluir obj2\"| C[\"C<br/>Incl. obj2<br/>CI = 5<br/>CS = 10.25\"]\n  A -->|\"N: no incluir obj2\"| D[\"D [Podado]<br/>No obj2<br/>CS = 9.75<br/>PODA\"]\n\n  C -->|\"I: incluir obj3\"| E[\"E<br/>Incl. obj3<br/>CI = 9<br/>CS = 10.25\"]\n  C -->|\"N: no incluir obj3\"| F[\"F<br/>No obj3<br/>CI = 5<br/>CS = 10.00\"]\n\n  E -->|\"I: incluir obj4\"| G[\"G [Podado]<br/>Incl. obj4<br/>p = 10 mayor que 7<br/>INVIABLE\"]\n  E -->|\"N: no incluir obj4\"| H[\"H<br/>No obj4<br/>{1,2,3}<br/>val = 9\"]\n\n  F -->|\"I: incluir obj4\"| I[\"I [Optimo]<br/>Incl. obj4<br/>{1,2,4}<br/>val = 10<br/>ÓPTIMO\"]\n  F -->|\"N: no incluir obj4\"| J[\"J<br/>No obj4<br/>{1,2}<br/>val = 5\"]\n\n  classDef normal fill:#1e293b,stroke:#60a5fa,color:#e2e8f0,stroke-width:1px;\n  classDef poda fill:#3f1212,stroke:#ef4444,color:#fee2e2,stroke-width:1px,stroke-dasharray:5 5;\n  classDef solucion fill:#12351f,stroke:#22c55e,color:#dcfce7,stroke-width:2px;\n\n  class R,A,C,E,F,J normal;\n  class B,D,G poda;\n  class H,I solucion;"
            },
            {
              "id": "blk-arbol-mochila-resultado",
              "type": "note",
              "variant": "success",
              "title": "Optimal solution",
              "blocks": [
                {
                  "id": "blk-arbol-mochila-resultado-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The optimal solution is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "X=(1,1,0,1)"
                    },
                    {
                      "type": "text",
                      "text": ", that is, take objects 1, 2 and 4. The total weight is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "1+2+4=7"
                    },
                    {
                      "type": "text",
                      "text": "and the total value is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "2+3+5=10"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-cota-superior-mochila-fraccionaria",
          "slug": "cota-superior-mochila-fraccionaria",
          "title": "Upper bound for fractional backpack",
          "order": 5,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 14,
          "blocks": [
            {
              "id": "blk-cota-fraccionaria-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "To estimate an upper bound on 0/1 backpack, we allow taking fractions of objects. That fractional solution is always greater than or equal to any integer solution."
                }
              ]
            },
            {
              "id": "blk-cota-fraccionaria-modelo",
              "type": "equationBlock",
              "title": "Upper bound model",
              "latex": "CS(N)=valor(N)+valor\\_fraccionario(objetos\\_restantes,capacidad\\_restante)"
            },
            {
              "id": "blk-expl-cota-fraccionaria-modelo",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The upper bound of the node"
                },
                {
                  "type": "inlineMath",
                  "latex": "N"
                },
                {
                  "type": "text",
                  "text": "It is the sum of the value already accumulated plus the value we would obtain if we could fill the rest of the capacity optimally using fractions of the leftover objects."
                }
              ]
            },
            {
              "id": "blk-cota-fraccionaria-pieza",
              "type": "equationBlock",
              "title": "Value of a fraction",
              "latex": "valor\\_fraccion=valor_i\\cdot\\frac{capacidad\\_restante}{peso_i}"
            },
            {
              "id": "blk-expl-cota-fraccionaria-pieza",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "When an object no longer fits completely, we take only the proportional part that completes the capacity"
                },
                {
                  "type": "strong",
                  "text": "W"
                },
                {
                  "type": "text",
                  "text": ". Its value is calculated by multiplying the total value of the object by the fraction of weight that we are taking advantage of."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-complejidad-branch-and-bound",
          "slug": "complejidad-branch-and-bound",
          "title": "Branch and Bound Complexity",
          "order": 6,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "blocks": [
            {
              "id": "blk-complejidad-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Branch and Bound may be fast in practice, but its worst case is still exponential."
                }
              ]
            },
            {
              "id": "blk-complejidad-bb-general",
              "type": "equationBlock",
              "title": "General cost model",
              "latex": "T(n)=\\Theta(N_{visitados}\\cdot(C_{ramificar}+C_{cota}+C_{LNV}))"
            },
            {
              "id": "blk-expl-complejidad-bb-general",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The total time"
                },
                {
                  "type": "inlineMath",
                  "latex": "T(n)"
                },
                {
                  "type": "text",
                  "text": "depends on the number of nodes visited multiplied by the cost of operations per node: generate children ("
                },
                {
                  "type": "inlineMath",
                  "latex": "C_{ramificar}"
                },
                {
                  "type": "text",
                  "text": "), calculate the elevation ("
                },
                {
                  "type": "inlineMath",
                  "latex": "C_{cota}"
                },
                {
                  "type": "text",
                  "text": ") and manage the list of live nodes ("
                },
                {
                  "type": "inlineMath",
                  "latex": "C_{LNV}"
                },
                {
                  "type": "text",
                  "text": ")."
                }
              ]
            },
            {
              "id": "blk-complejidad-bb-peor-caso",
              "type": "equationBlock",
              "title": "binary worst case",
              "latex": "N_{visitados}=\\begin{cases}O(2^n),& \\text{si casi no hay poda}\\\\\\ll 2^n,& \\text{si las cotas podan muchas ramas}\\end{cases}"
            },
            {
              "id": "blk-expl-complejidad-bb-peor-caso",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "In the worst case, the bound does not discard any branches and we visit the entire binary tree of size"
                },
                {
                  "type": "inlineMath",
                  "latex": "2^n"
                },
                {
                  "type": "text",
                  "text": ". However, a good bound can make the actual number of nodes orders of magnitude smaller."
                }
              ]
            },
            {
              "id": "blk-complejidad-bb-mochila",
              "type": "equationBlock",
              "title": "0/1 backpack with fractional dimension",
              "latex": "T(n)=O(2^n\\cdot n)\\quad \\text{si calcular cada cota cuesta }O(n)"
            },
            {
              "id": "blk-expl-complejidad-bb-mochila",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Since the calculation of the fractional dimension requires a linear traversal through the remaining objects, the cost per node is"
                },
                {
                  "type": "inlineMath",
                  "latex": "O(n)"
                },
                {
                  "type": "text",
                  "text": ", which multiplies the total cost of the tree."
                }
              ]
            },
            {
              "id": "blk-complejidad-bb-prioridad",
              "type": "equationBlock",
              "title": "Additional priority queue cost",
              "latex": "C_{LNV}=O(\\log |LNV|)"
            },
            {
              "id": "blk-expl-complejidad-bb-prioridad",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "If we use a priority queue for Max Benefit or Least Cost, inserting and extracting nodes has a logarithmic cost with respect to the number of nodes alive at that moment."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-resumen-operativo-branch-and-bound",
          "slug": "resumen-operativo-branch-and-bound",
          "title": "Operational summary",
          "order": 10,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 7,
          "blocks": [
            {
              "id": "blk-resumen-bb",
              "type": "note",
              "variant": "success",
              "title": "Minimum recipe",
              "blocks": [
                {
                  "id": "blk-resumen-bb-list",
                  "type": "list",
                  "style": "ordered",
                  "items": [
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Defines the objective function."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Represent each solution as a sequence of decisions."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Defines branching and safe limits."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Maintain the best feasible solution (relevant)."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Choose route strategy (Max Benefit recommended)."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Expand and prune until the LNV is emptied."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-formulas-clave-bb",
              "type": "latexSteps",
              "title": "Key models",
              "steps": [
                {
                  "stepId": "step-formula-nodo-bb",
                  "title": "Node",
                  "latex": "N=(X_k,valor(N),recurso(N),CI(N),CS(N),k)",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "A node saves the state of the search at a given point."
                    }
                  ]
                },
                {
                  "stepId": "step-formula-poda-max",
                  "title": "Pruning in maximization",
                  "latex": "CS(N)\\le mejor\\Rightarrow podar(N)",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "The branch is discarded if its maximum potential does not exceed what has already been achieved."
                    }
                  ]
                },
                {
                  "stepId": "step-formula-costo-bb",
                  "title": "Overall cost",
                  "latex": "T(n)=\\Theta(N_{visitados}\\cdot(C_{ramificar}+C_{cota}+C_{LNV}))",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "Cost is measured in nodes multiplied by the work on each one."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
