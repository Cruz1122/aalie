          },
          "blocks": [
            {
              "id": "blk-bubble-sort-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "BubbleSort",
              "code": "BubbleSort (I/O int A[n]) {\n for i <- 1 to (n-1) do\n  for j <- 1 to (n-i) do\n   if A[j] > A[j+1] then\n    swap(A[j], A[j+1])\n   endif\n  endfor\n endfor\n}"
            },
            {
              "id": "blk-bubble-sort-invariante",
              "type": "note",
              "variant": "info",
              "title": "Invariant of the external for loop (variable i)",
              "blocks": [
                {
                  "id": "blk-bubble-sort-invariante-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "After completing the iteration"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": "of the external loop,"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": "larger elements are in their final positions at the end of the array"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[n-i+1..n]"
                    },
                    {
                      "type": "text",
                      "text": ", in non-decreasing order."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-bubble-sort-demostracion-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Proof of the three moments"
                }
              ]
            },
            {
              "id": "blk-bubble-sort-demostracion",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Initialization (i=1):"
                    },
                    {
                      "type": "text",
                      "text": "Before we begin, there are no items secured at the end of the array. The property is trivially true (0 elements ordered last)."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Maintenance:"
                    },
                    {
                      "type": "text",
                      "text": "During the iteration"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": ", the inner loop pushes the maximum element of the unordered subarray"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[1..n-i+1]"
                    },
                    {
                      "type": "text",
                      "text": "towards the position"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-i+1"
                    },
                    {
                      "type": "text",
                      "text": ". When finished, that element remains in its final position."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Termination (i=n):"
                    },
                    {
                      "type": "text",
                      "text": "The"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-1"
                    },
                    {
                      "type": "text",
                      "text": "larger elements. The only one remaining is the smallest and is already in place. The array is completely ordered."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-bubble-sort-eficiencia-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Bubble Sort Efficiency"
                }
              ]
            },
            {
              "id": "blk-bubble-sort-for-interno",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The internal for is executed"
                },
                {
                  "type": "inlineMath",
                  "latex": "n-i"
                },
                {
                  "type": "text",
                  "text": "times for each value of"
                },
                {
                  "type": "inlineMath",
                  "latex": "i"
                },
                {
                  "type": "text",
                  "text": ": "
                }
              ]
            },
            {
              "id": "blk-bubble-sort-sumatoria",
              "type": "equationBlock",
              "latex": "\\sum_{i=1}^{n-1}(n-i) = (n-1) + (n-2) + \\cdots + 1 = \\frac{n(n-1)}{2}"
            },
            {
              "id": "blk-bubble-sort-tn",
              "type": "latexSteps",
              "title": "Bubble Sort Efficiency Feature",
              "steps": [
                {
                  "stepId": "funcion-de-eficiencia",
                  "title": "Efficiency function",
                  "latex": "T(n) = C_1 n + (C_2 + C_3)\\frac{n(n-1)}{2} + C_4\\frac{n(n-1)}{2}"
                },
                {
                  "stepId": "forma-cuadratica",
                  "title": "quadratic shape",
                  "latex": "T(n) = a n^2 + b n + c"
                }
              ]
            },
            {
              "id": "blk-bubble-sort-resultado",
              "type": "note",
              "variant": "success",
              "title": "Result",
              "blocks": [
                {
                  "id": "blk-bubble-sort-resultado-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "inlineMath",
                      "latex": "T(n) = a n^2 + b n + c"
                    },
                    {
                      "type": "text",
                      "text": "->"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "O(n^2)"
                    },
                    {
                      "type": "text",
                      "text": "in both cases."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-bubble-sort-nota",
