              "variant": "warning",
              "title": "Note",
              "blocks": [
                {
                  "id": "blk-bubble-sort-nota-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Note: Bubble Sort is"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "O(n^2)"
                    },
                    {
                      "type": "text",
                      "text": "both in the best and worst case, because even if you don't make exchanges (best case), you still make all the comparisons."
                    }
