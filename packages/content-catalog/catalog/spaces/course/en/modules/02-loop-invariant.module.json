  "terms": [
    {
      "termId": "term-loop-invariant",
      "label": "Loop invariant",
      "definition": "Logical property associated with the main loop of an algorithm that is used to prove correctness."
    },
    {
      "termId": "term-correctitud",
      "label": "Correctness",
      "definition": "Property of an algorithm that indicates that it does what it claims to do for all valid input."
    },
    {
      "termId": "term-inicializacion",
      "label": "Initialization",
      "definition": "Moment of the proof where it is verified that the invariant is true before the first iteration."
    },
    {
      "termId": "term-mantenimiento",
      "label": "Maintenance",
      "definition": "Moment of the proof where it is verified that if the invariant is true before one iteration, it remains true before the next."
    },
    {
      "termId": "term-terminacion",
      "label": "Termination",
