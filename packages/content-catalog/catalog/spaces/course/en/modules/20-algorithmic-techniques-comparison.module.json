  "learningObjectives": [
    {
      "objectiveId": "distinguir-tecnicas-por-estructura",
      "text": "Distinguish algorithmic techniques according to the structure of the problem and not only by the appearance of the code."
    },
    {
      "objectiveId": "identificar-subproblemas-independientes",
      "text": "Identify when a problem is divided into independent subproblems and it is appropriate to use Divide and Conquer."
    },
    {
      "objectiveId": "identificar-subproblemas-superpuestos",
      "text": "Identify when there are overlapping subproblems and it is appropriate to use Dynamic Programming."
    },
    {
      "objectiveId": "distinguir-voraz-pd",
      "text": "Distinguish problems where a demonstrable local choice is enough from problems that require evaluating alternatives."
    },
    {
      "objectiveId": "distinguir-backtracking-bb",
      "text": "Distinguishing backtracking from Branch and Bound by the type of pruning: feasibility versus suboptimality."
    },
    {
      "objectiveId": "usar-fuerza-bruta-como-linea-base",
      "text": "Use brute force as a conceptual baseline before justifying a more efficient technique."
    },
    {
      "objectiveId": "comparar-garantias",
      "text": "Compare which techniques guarantee an optimal solution, which require additional proof, and which can only be heuristics."
    },
    {
      "objectiveId": "comparar-costos",
      "text": "Compare typical time and space for each technique."
    },
    {
      "objectiveId": "clasificar-problemas",
      "text": "Classify a given problem according to structural signals: cycles, recurrence, table, local choice, decision tree or bounds."
    },
    {
      "objectiveId": "evitar-confusiones",
      "text": "Avoid common confusion: calling any fast algorithm greedy, calling any table PD, or calling any backtracking B&B."
    }
  ],
  "quizRefs": [],
  "contentRefs": [],
  "terms": [
    {
      "termId": "term-tecnica-algoritmica",
      "label": "Algorithmic technique",
      "definition": "Design or analysis pattern used to solve a family of problems with a recognizable structure."
    },
    {
      "termId": "term-senal-estructural",
      "label": "Structural signal",
      "definition": "Feature of the problem or algorithm that suggests a technique: subproblems, decisions, overlap, restrictions, bounds or cycles."
    },
    {
      "termId": "term-subproblemas-independientes",
      "label": "Independent subproblems",
      "definition": "Subproblems that are solved without reusing results with each other. They are typical of Divide and Conquer."
    },
    {
      "termId": "term-subproblemas-superpuestos-comparacion",
      "label": "Overlapping subproblems",
      "definition": "Subproblems that appear repeated and justify saving results through Dynamic Programming."
    },
    {
      "termId": "term-decision-irrevocable",
      "label": "Irrevocable decision",
      "definition": "Decision that is not reconsidered after being accepted. It is typical of greedy algorithms."
    },
    {
      "termId": "term-decision-reversible",
      "label": "Reversible decision",
      "definition": "Decision that can be undone to try another alternative. It is typical of backtracking."
    },
    {
      "termId": "term-poda-factibilidad-comparacion",
      "label": "Pruning for feasibility",
      "definition": "Drop a branch because it violates constraints and cannot lead to a valid solution."
    },
    {
      "termId": "term-poda-suboptimalidad-comparacion",
      "label": "Pruning for suboptimality",
      "definition": "Drop a branch because its best possible value does not improve the best known solution."
    },
    {
      "termId": "term-garantia-optimalidad",
      "label": "Optimality guarantee",
      "definition": "Justification that the technique endds an optimal solution, not just a valid or reasonable solution."
    },
    {
      "termId": "term-linea-base-fuerza-bruta",
      "label": "Brute Force Baseline",
      "definition": "Comprehensive solution used as an initial reference to understand the entire space before pruning, saving or choosing better."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-comparacion-tecnicas-algoritmicas",
      "slug": "algorithmic-techniques-comparison",
      "title": "Comparison of Algorithmic Techniques",
      "order": 1,
      "summary": "Synthesis to choose a technique according to the structure of the problem, the guarantees required and the expected cost.",
      "sections": [
        {
          "sectionId": "sec-idea-central-comparacion-tecnicas",
          "slug": "idea-central-comparacion-tecnicas",
          "title": "Central idea: the technique is not chosen for pleasure",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 7,
          "blocks": [
            {
              "id": "blk-comparacion-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The algorithmic technique is not chosen for fashion or convenience. It is chosen because the problem has a structure that justifies it: independent subproblems, repeated subproblems, safe local decisions, partial restrictions, bounds or exhaustive search."
                }
              ]
            },
            {
              "id": "blk-comparacion-principio",
              "type": "note",
              "variant": "warning",
              "title": "Selection principle",
              "blocks": [
                {
                  "id": "blk-comparacion-principio-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "First, the structure of the problem is identified; Then the technique is decided. Doing it the other way around often produces algorithms that look sophisticated but are not justified."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-senales-estructurales-table",
              "type": "table",
              "title": "Structural signs and suggested technique",
              "columns": [
                {
                  "key": "senal",
                  "label": "Structural signal"
                },
                {
                  "key": "pregunta",
                  "label": "Diagnostic question"
                },
                {
                  "key": "tecnica",
                  "label": "Candidate technique"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Cumulative cost for repeated instructions"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Is the algorithm mainly explained by cycles?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Iterative analysis"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Problem is divided into independent parts"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Don't subproblems share results?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Divide and Conquer"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Problem is reduced to a smaller version"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Does each step reduce the size and continue with a subproblem?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Subtraction and Conquer / linear recursion"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Repeated subproblems"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Is the same state calculated multiple times?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Dynamic Programming"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Safe local choice"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Can it be shown that choosing the best now does not harm the optimal?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Greedy"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Partial solutions under constraints"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Can I prune a branch as soon as it violates a constraint?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Backtracking"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Optimization with bounds"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Can I estimate if a branch can no longer improve the best solution?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Branch and Bound"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "There is no exploitable structure"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "All that's left to do is try all the possibilities?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "brute force"
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-modelo-decision-tecnica",
          "slug": "modelo-decision-tecnica",
          "title": "Decision model for choosing technique",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "blocks": [
            {
              "id": "blk-modelo-decision-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A disciplined way to choose technique is to answer cascading questions. Each question discards techniques that do not apply."
                }
              ]
            },
            {
              "id": "blk-modelo-decision-cases",
              "type": "equationBlock",
              "title": "Technique selection model",
              "latex": "Technique(P)=\\begin{cases}\\text{Iterative},& P\\ \\text{is solved by accumulating steps in loops}\\\\\\text{Divide and Conquer},& P\\to \\text{independent subproblems}\\\\\\text{Decrease and Conquer},& P\\to \\text{one dominant smaller subproblem}\\\\\\text{Dynamic Programming},& P\\to \\text{overlapping subproblems}\\\\\\text{Greedy},& P\\to \\text{provably safe local choice}\\\\\\text{Backtracking},& P\\to \\text{reversible decisions with feasibility pruning}\\\\\\text{Branch and Bound},& P\\to \\text{optimization with pruning bounds}\\\\\\text{Brute Force},& \\text{no clearly exploitable structure}\\end{cases}"
            },
            {
              "id": "blk-expl-modelo-decision-cases",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This model classifies the problem"
                },
                {
                  "type": "strong",
                  "text": "Q"
                },
                {
                  "type": "text",
                  "text": "according to its structural nature. The key is to identify the relationship between the original problem and its subproblems or decisions. For example, if a problem is divided into parts that do not share information, the logical technique is"
                },
                {
                  "type": "emphasis",
                  "text": "Divide and Conquer"
                },
                {
                  "type": "text",
                  "text": "; If the decisions are irreversible and local, it is"
                },
                {
                  "type": "emphasis",
                  "text": "Greedy"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-flujo-decision-tecnica",
              "type": "mermaid",
              "title": "Technique selection flow",
              "code": "flowchart TD\n A[\"Problem\"] --> B{\"Is there a given algorithm to analyze?\"}\n B -- \"Yes\" --> C{\"Do loops dominate?\"}\n C -- \"Yes\" --> D[\"Iterative analysis\"]\n C -- \"No\" --> E{\"Does recursion dominate?\"}\n E -- \"Yes\" --> F[\"Set up recurrence\"]\n F --> G{\"Independent subproblems?\"}\n G -- \"Yes\" --> H[\"Divide and Conquer / recurrence methods\"]\n G -- \"No\" --> I{\"Repeated states?\"}\n I -- \"Yes\" --> J[\"Dynamic Programming\"]\n I -- \"No\" --> K[\"Decrease and Conquer / linear recursion\"]\n B -- \"No\" --> L{\"Is it an optimization problem?\"}\n L -- \"Yes\" --> M{\"Safe local choice?\"}\n M -- \"Yes\" --> N[\"Greedy\"]\n M -- \"No\" --> O{\"Are there useful bounds?\"}\n O -- \"Yes\" --> P[\"Branch and Bound\"]\n O -- \"No\" --> Q{\"Are there partial constraints?\"}\n Q -- \"Yes\" --> R[\"Backtracking\"]\n Q -- \"No\" --> S[\"Brute force / exhaustive search\"]\n L -- \"No\" --> T{\"Are valid solutions under constraints being sought?\"}\n T -- \"Yes\" --> R\n T -- \"No\" --> S"
            }
          ]
        },
        {
          "sectionId": "sec-tabla-comparativa-global",
          "slug": "tabla-comparativa-global",
          "title": "Global comparative table",
          "order": 3,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-tabla-comparativa-global",
              "type": "table",
              "title": "Global comparison of algorithmic techniques",
              "columns": [
                {
                  "key": "tecnica",
                  "label": "Technique"
                },
                {
                  "key": "estructura",
                  "label": "Structure that takes advantage"
                },
                {
                  "key": "decision",
                  "label": "Decision type"
                },
                {
                  "key": "garantia",
                  "label": "Guarantee"
                },
                {
                  "key": "costo",
                  "label": "Typical cost"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Iterative analysis"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Cycles and counting of operations."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "He doesn't design; analyzes execution."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Exact if the count is correct."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Sum of executions per line."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Dynamic Programming"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Overlapping subproblems and optimal substructure."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Evaluate alternatives and save states."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Optimal by principle of optimality."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "#States x transition cost."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Greedy"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Greedy property and optimal substructure."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Choose locallocally without backtracking."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Optimal only if it is demonstrated."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "O(n) or O(n log n)."
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-comparacion-pd-voraz",
          "slug": "comparacion-pd-voraz",
          "title": "Dynamic vs. Greedy Programming",
          "order": 4,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-pd-voraz-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Dynamic and Greedy Programming appear in optimization problems, but have a central difference: DP evaluates alternatives and saves results; the greedy algorithm makes a local decision and does not go back."
                }
              ]
            },
            {
              "id": "blk-pd-voraz-modelo",
              "type": "equationBlock",
              "title": "Formal difference",
              "latex": "Decision(P)=\\begin{cases}\\max\\{option_1,option_2,\\ldots\\},& \\text{Dynamic Programming}\\\\select\\_local(C),& \\text{Greedy}\\end{cases}"
            },
            {
              "id": "blk-expl-pd-voraz-modelo",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The difference lies in the moment of truth. In"
                },
                {
                  "type": "strong",
                  "text": "Dynamic Programming"
                },
                {
                  "type": "text",
                  "text": ", the endal value is chosen by comparing ("
                },
                {
                  "type": "inlineMath",
                  "latex": "\\max"
                },
                {
                  "type": "text",
                  "text": ") the results of various options. in an algorithm"
                },
                {
                  "type": "strong",
                  "text": "Greedy"
                },
                {
                  "type": "text",
                  "text": ", only a local selection function is executed on the set of current candidates"
                },
                {
                  "type": "strong",
                  "text": "c"
                },
                {
                  "type": "text",
                  "text": ", without looking at what other options might have been better in the long run."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-comparacion-backtracking-bb-fuerza-bruta",
          "slug": "comparacion-backtracking-bb-fuerza-bruta",
          "title": "Brute Force vs Backtracking vs Branch and Bound",
          "order": 5,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-fb-bt-bb-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Brute force, backtracking and Branch and Bound work on combinatorial spaces. The difference is when a branch is dropped and why it is dropped."
                }
              ]
            },
            {
              "id": "blk-fb-bt-bb-modelo",
              "type": "equationBlock",
              "title": "Branch discard model",
              "latex": "discard(branch)=\\begin{cases}\\text{never before completion},& \\text{Brute Force}\\\\\\text{if it violates constraints},& \\text{Backtracking}\\\\\\text{if it violates constraints or does not improve the incumbent},& \\text{Branch and Bound}\\end{cases}"
            },
            {
              "id": "blk-expl-fb-bt-bb-modelo",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This model deendes the aggressiveness of the"
                },
                {
                  "type": "strong",
                  "text": "pruning"
                },
                {
                  "type": "text",
                  "text": ". While Brute Force explores everything, the"
                },
                {
                  "type": "emphasis",
                  "text": "Backtracking"
                },
                {
                  "type": "text",
                  "text": "discard unviable branches (pruning for feasibility). The"
                },
                {
                  "type": "emphasis",
                  "text": "Branch and Bound"
                },
                {
                  "type": "text",
                  "text": "It goes further and also discards branches that, although viable, their potential (boundary) is not sufficient to overcome the best solution already found (incumbent)."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-comparacion-recursion-pd",
          "slug": "comparacion-recursion-pd",
          "title": "Recursion, Divide and Conquer and Dynamic Programming",
          "order": 6,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "blocks": [
            {
              "id": "blk-recursion-pd-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Not all recursion is Divide and Conquer, and not all recursion needs Dynamic Programming. The key question is what happens to the subproblems."
                }
              ]
            },
            {
              "id": "blk-recursion-pd-modelo",
              "type": "equationBlock",
              "title": "Classification by subproblems",
              "latex": "Subproblems(P)=\\begin{cases}\\text{one dominant smaller subproblem},& \\text{Decrease and Conquer}\\\\\\text{several independent subproblems},& \\text{Divide and Conquer}\\\\\\text{several repeated subproblems},& \\text{Dynamic Programming}\\end{cases}"
            },
            {
              "id": "blk-expl-recursion-pd-modelo",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The classification depends on how the generated subproblems interact. If the problem"
                },
                {
                  "type": "strong",
                  "text": "Q"
                },
                {
                  "type": "text",
                  "text": "It is solved simply by reducing its size, it is a subtraction. If it is fragmented into non-overlapping parts, it is a division. If the parts appear repeated in different branches, this is the unmistakable signal to apply"
                },
                {
                  "type": "emphasis",
                  "text": "Dynamic Programming"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-comparacion-costos-memoria",
          "slug": "comparacion-costos-memoria",
          "title": "Comparison of time and memory",
          "order": 7,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "blocks": [
            {
              "id": "blk-costos-memoria-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The cost of a technique is not summarized in a single notation. It depends on the number of states, branches, levels, candidates or instructions that are currently processed."
                }
              ]
            },
            {
              "id": "blk-modelos-costo-tecnicas",
              "type": "latexSteps",
              "title": "Cost models by technique",
              "steps": [
                {
                  "stepId": "step-costo-iterativo",
                  "title": "Iterative",
                  "latex": "T(n)=\\sum_{line} cost(line)\\cdot times(line)",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "Cost based on the count of executions of each line of code."
                    }
                  ]
                },
                {
                  "stepId": "step-costo-pd",
                  "title": "Dynamic Programming",
                  "latex": "T(n)=\\#states\\cdot cost\\_transition",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "Each unique state is calculated only once thanks to memory."
                    }
                  ]
                },
                {
                  "stepId": "step-costo-backtracking",
                  "title": "Backtracking",
                  "latex": "T(n)=N_{visited}\\cdot C_{validate}",
                  "explanation": [
                    {
                      "type": "text",
                      "text": "It depends on how many nodes of the decision tree are currently explored."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-resumen-operativo-comparacion-tecnicas",
          "slug": "resumen-operativo-comparacion-tecnicas",
          "title": "Operational summary",
          "order": 8,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 8,
          "blocks": [
            {
              "id": "blk-resumen-comparacion",
              "type": "note",
              "variant": "success",
              "title": "Minimum recipe",
              "blocks": [
                {
                  "id": "blk-resumen-comparacion-list",
                  "type": "list",
                  "style": "ordered",
                  "items": [
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "Analyze the structure of the problem before coding."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "If there are cycles, count steps."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "If there are independent subproblems, use Divide and Conquer."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "If there are repeated subproblems, use Dynamic Programming."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "If there is a demonstrably safe local choice, use Ravenous."
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "text",
                          "text": "If there are restrictions and search, use Backtracking or B&B."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-modelo-general-poda",
              "type": "equationBlock",
              "title": "General pruning model",
              "latex": "Pruning=\\text{Infeasibility}\\cup \\text{Suboptimality}"
            },
            {
              "id": "blk-expl-modelo-poda",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Pruning is the tool to combat the combinatorial explosion. The"
                },
                {
                  "type": "strong",
                  "text": "Infeasibility"
                },
                {
                  "type": "text",
                  "text": "eliminate what is impossible (Backtracking); the"
                },
                {
                  "type": "strong",
                  "text": "Suboptimality"
                },
                {
                  "type": "text",
                  "text": "eliminate what, even if possible, is not worth it (Branch and Bound). The union of both maximizes efficiency."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
