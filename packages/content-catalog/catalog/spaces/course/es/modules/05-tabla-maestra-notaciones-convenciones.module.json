  "terms": [
    {
      "termId": "term-tabla-maestra",
      "label": "Tabla maestra",
      "definition": "Tabla de referencia que concentra las seis notaciones asintóticas, su tipo de cota y su criterio bajo las dos convenciones de límites."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convención A",
      "definition": "Convención que compara funciones mediante el límite de f(n)/g(n)."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convención B / curso",
      "definition": "Convención usada en el curso que compara funciones mediante el límite de g(n)/f(n)."
    },
    {
      "termId": "term-igualdad-con-g",
      "label": "Igualdad con g",
      "definition": "Indica si la notación permite que f crezca al mismo ritmo que g."
    },
    {
      "termId": "term-cota-superior-exacta",
      "label": "Cota superior que puede ser exacta",
      "definition": "Caso en el que una cota superior también admite que f y g crezcan al mismo ritmo."
    },
    {
      "termId": "term-cota-inferior-exacta",
      "label": "Cota inferior que puede ser exacta",
      "definition": "Caso en el que una cota inferior también admite que f y g crezcan al mismo ritmo."
    },
    {
      "termId": "term-cota-estricta",
      "label": "Cota estricta",
      "definition": "Cota que excluye igualdad asintótica con la función de referencia."
    },
    {
      "termId": "term-equivalencia-exacta",
      "label": "Equivalencia exacta",
      "definition": "Relación asintótica donde el cociente entre las funciones tiende exactamente a 1."
    }
  ],
