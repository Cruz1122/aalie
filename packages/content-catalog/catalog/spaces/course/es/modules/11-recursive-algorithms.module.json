  "terms": [
    {
      "termId": "term-algoritmo-recursivo",
      "label": "Algoritmo recursivo",
      "definition": "Algoritmo que se llama a sí mismo como parte de su solución."
    },
    {
      "termId": "term-ambiente-ejecucion",
      "label": "Ambiente de ejecución",
      "definition": "Marco creado por el sistema en cada llamada recursiva, donde se guardan parámetros, variables locales y dirección de retorno."
    },
    {
      "termId": "term-marco-pila",
      "label": "Marco de pila",
      "definition": "Otro nombre para ambiente de ejecución dentro de la pila de llamadas."
    },
    {
      "termId": "term-pila",
      "label": "Pila",
      "definition": "Estructura donde se apilan los ambientes de ejecución de las llamadas recursivas pendientes."
    },
    {
      "termId": "term-direccion-retorno",
      "label": "Dirección de retorno",
      "definition": "Punto exacto del código al que debe volver una llamada cuando termina."
    },
    {
      "termId": "term-caso-base",
      "label": "Caso base",
      "definition": "Condición de parada de una recursión. Se resuelve directamente y su costo en la recurrencia es constante."
    },
    {
      "termId": "term-caso-general",
      "label": "Caso general",
      "definition": "Parte recursiva donde el problema se reduce a versiones más pequeñas de sí mismo mediante llamados recursivos."
    },
    {
      "termId": "term-ecuacion-recurrencia",
      "label": "Ecuación de recurrencia",
      "definition": "Ecuación que expresa el costo de un algoritmo recursivo en función del costo de resolver subproblemas más pequeños."
    },
    {
      "termId": "term-divide-y-venceras",
      "label": "Divide y vencerás",
      "definition": "Familia de recurrencias de la forma T(n)=aT(n/b)+f(n), identificada por división en el llamado."
    },
    {
      "termId": "term-resta-y-venceras",
      "label": "Resta y vencerás",
      "definition": "Familia de recurrencias de la forma T(n)=T(n-b)+f(n), con resta en el llamado y a=1."
    },
    {
      "termId": "term-resta-y-seras-vencido",
      "label": "Resta y serás vencido",
      "definition": "Familia de recurrencias de la forma T(n)=aT(n-b)+f(n), con resta en el llamado y a>1."
    },
    {
      "termId": "term-recursion-cola",
      "label": "Recursión de cola",
      "definition": "Recursión donde el llamado recursivo es lo último que ocurre en el caso general."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-algoritmos-recursivos",
      "slug": "recursive-algorithms",
      "title": "Algoritmos Recursivos",
      "order": 1,
      "summary": "Conceptos base de recursión, seguimiento mediante pila, ejemplos clásicos y clasificación inicial de recurrencias.",
      "sections": [
        {
          "sectionId": "sec-introduccion-algoritmos-recursivos",
          "slug": "introduccion-algoritmos-recursivos",
          "title": "11. Algoritmos Recursivos",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "learningObjectives": [
            {
              "objectiveId": "entender-recursion-como-autollamado",
              "text": "Entender que un algoritmo recursivo se llama a sí mismo como parte de su solución."
            },
            {
              "objectiveId": "contrastar-recursivo-iterativo",
              "text": "Contrastar el análisis iterativo línea por línea con el seguimiento recursivo mediante ambientes de ejecución."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              },
              {
                "id": "mod-loop-invariant",
                "kind": "required"
              },
              {
                "id": "mod-algoritmos-iterativos-patrones-costos",
                "kind": "required"
              }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-recursivos-prerrequisito",
              "type": "note",
              "variant": "info",
              "title": "Prerrequisito",
              "blocks": [
                {
                  "id": "blk-recursivos-prerrequisito-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Módulos 1–3: complejidad temporal, operaciones elementales, ciclos iterativos y conocimiento de pilas."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-recursivos-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Un algoritmo recursivo es aquel que se llama a sí mismo como parte de su solución. A diferencia de los iterativos —que se analizan línea por línea—, los recursivos se siguen a través de ambientes de ejecución, también llamados marcos de pila."
                }
              ]
            },
            {
              "id": "blk-recursivos-naturaleza",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La recursión está en la naturaleza: las muñecas rusas, los fractales, la definición del factorial. Su poder está en expresar soluciones complejas de forma elegante y concisa."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ambientes-ejecucion-pila",
          "slug": "ambientes-ejecucion-pila",
          "title": "11.1 Ambientes de ejecución y la pila",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 6,
          "learningObjectives": [
            {
              "objectiveId": "explicar-creacion-ambientes",
              "text": "Explicar qué ocurre cuando un algoritmo recursivo se llama a sí mismo."
            },
            {
              "objectiveId": "identificar-contenido-ambiente",
              "text": "Identificar qué se guarda dentro de un ambiente de ejecución."
            },
            {
              "objectiveId": "relacionar-recursion-espacio",
              "text": "Relacionar recursión con costo espacial por uso de pila."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-complejidad-espacial",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-ambientes-pila-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Cada vez que un algoritmo recursivo se llama a sí mismo, el sistema crea un nuevo ambiente de ejecución y lo apila sobre los anteriores."
                }
              ]
            },
            {
              "id": "blk-ambiente-guarda-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "En ese ambiente se guardan:"
                }
              ]
            },
            {
              "id": "blk-ambiente-guarda-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Todos los parámetros recibidos en esa llamada."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Todas las variables locales declaradas en esa ejecución."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "La dirección de retorno: el punto exacto del código al que hay que volver cuando esa llamada termine."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-ambientes-suspendidos",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Mientras el ambiente no termine, todos los ambientes anteriores quedan suspendidos esperando en la pila. Por eso la recursión tiene un costo espacial relevante: cada ambiente consume memoria."
                }
              ]
            },
            {
              "id": "blk-regla-casos-base",
              "type": "note",
              "variant": "warning",
              "title": "Regla de los casos base",
              "blocks": [
                {
                  "id": "blk-regla-casos-base-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "El número de casos base debe ser IGUAL al número de llamados en el caso general. Si el caso general hace 2 llamados recursivos, se necesitan al menos 2 casos base. Si hace 3, se necesitan 3."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-estructura-algoritmo-recursivo",
          "slug": "estructura-algoritmo-recursivo",
          "title": "11.2 Estructura de un algoritmo recursivo",
          "order": 3,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "learningObjectives": [
            {
              "objectiveId": "identificar-dos-partes-recursion",
              "text": "Identificar las dos partes obligatorias de todo algoritmo recursivo correcto."
            },
            {
              "objectiveId": "diferenciar-base-general",
              "text": "Diferenciar caso base y caso general."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-ambientes-ejecucion-pila",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-estructura-recursivo-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Todo algoritmo recursivo correcto tiene exactamente dos partes:"
                }
              ]
            },
            {
              "id": "blk-estructura-obligatoria-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Estructura obligatoria de un algoritmo recursivo"
                }
              ]
            },
            {
              "id": "blk-definicion-caso-base",
              "type": "definition",
              "title": "Caso base o casos base",
              "blocks": [
                {
                  "id": "blk-definicion-caso-base-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Es la condición de parada. Se resuelve directamente, sin llamado recursivo. Su costo en la ecuación de recurrencia siempre es una constante."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-definicion-caso-general",
              "type": "definition",
              "title": "Caso general",
              "blocks": [
                {
                  "id": "blk-definicion-caso-general-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Es la situación donde el problema se reduce a versiones más pequeñas de sí mismo mediante llamados recursivos. Aquí está la lógica de la reducción."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ejemplo-fibonacci",
          "slug": "ejemplo-fibonacci",
          "title": "11.3 Ejemplo: Fibonacci",
          "order": 4,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "learningObjectives": [
            {
              "objectiveId": "entender-fibonacci-recursivo",
              "text": "Entender la definición recursiva de Fibonacci."
            },
            {
              "objectiveId": "leer-pseudocodigo-fibonacci",
              "text": "Leer el caso base y el caso general en el pseudocódigo de Fibonacci."
            },
            {
              "objectiveId": "seguir-fib-cinco",
              "text": "Seguir el árbol de ejecución de Fib(5)."
            },
            {
              "objectiveId": "plantear-recurrencia-fib",
              "text": "Plantear la ecuación de recurrencia de Fibonacci."
            },
            {
              "objectiveId": "reconocer-recalculo-fibonacci",
              "text": "Reconocer que Fibonacci sin optimización recalcula subproblemas y motiva Programación Dinámica."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-estructura-algoritmo-recursivo",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-fibonacci-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fibonacci es la suma de los dos anteriores: "
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(n)=Fib(n-1)+Fib(n-2)"
                },
                {
                  "type": "text",
                  "text": ". En Fibonacci, se requieren dos casos base no porque haya dos llamadas recursivas, sino porque la fórmula depende de dos valores iniciales."
                }
              ]
            },
            {
              "id": "blk-fibonacci-pseudocodigo-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Pseudocódigo"
                }
              ]
            },
            {
              "id": "blk-fibonacci-pseudocodigo",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Fib",
              "code": "int Fib(E int n) {\n  if (n=0) or (n=1) then\n    f <- n # caso base: Fib(0)=0, Fib(1)=1\n  else\n    f <- Fib(n-1) + Fib(n-2) # caso general\n  endif\n  return f\n}"
            },
            {
              "id": "blk-fibonacci-seguimiento",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Seguimiento con "
                },
                {
                  "type": "inlineMath",
                  "latex": "n=5"
                },
                {
                  "type": "text",
                  "text": ": el algoritmo primero resuelve "
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(4)"
                },
                {
                  "type": "text",
                  "text": " (abre un ambiente), dentro de ese resuelve "
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(3)"
                },
                {
                  "type": "text",
                  "text": ", y así hasta llegar a los casos base. El "
                },
                {
                  "type": "inlineMath",
                  "latex": "Fib(n-2)"
                },
                {
                  "type": "text",
                  "text": " de cada nivel queda pendiente hasta que el izquierdo termine."
                }
              ]
            },
            {
              "id": "blk-fibonacci-mermaid",
              "type": "mermaid",
              "title": "Diagrama en Mermaid — Fib(5)",
              "code": "graph TD\nA[\"n = 5<br/>fib(4) + fib(3)<br/>3 + 2<br/>return 5\"]\nA --> B[\"n = 4<br/>fib(3) + fib(2)<br/>2 + 1<br/>return 3\"]\nA --> C[\"n = 3<br/>fib(2) + fib(1)<br/>1 + 1<br/>return 2\"]\nB --> D[\"n = 3<br/>fib(2) + fib(1)<br/>1 + 1<br/>return 2\"]\nB --> E[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nC --> F[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nC --> G[\"n = 1<br/>return 1\"]\nD --> H[\"n = 2<br/>fib(1) + fib(0)<br/>1 + 0<br/>return 1\"]\nD --> I[\"n = 1<br/>return 1\"]\nE --> J[\"n = 1<br/>return 1\"]\nE --> K[\"n = 0<br/>return 0\"]\nF --> L[\"n = 1<br/>return 1\"]\nF --> M[\"n = 0<br/>return 0\"]\nH --> N[\"n = 1<br/>return 1\"]\nH --> O[\"n = 0<br/>return 0\"]\nJ -.-> E\nK -.-> E\nL -.-> F\nM -.-> F\nN -.-> H\nO -.-> H\nH -.-> D\nI -.-> D\nD -.-> B\nE -.-> B\nF -.-> C\nG -.-> C\nB -.-> A\nC -.-> A"
            },
            {
              "id": "blk-fibonacci-nota-costo",
              "type": "note",
              "variant": "warning",
              "title": "Sobre el costo",
              "blocks": [
                {
                  "id": "blk-fibonacci-nota-costo-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Fibonacci sin optimización recalcula los mismos subproblemas muchas veces. "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(5)"
                    },
                    {
                      "type": "text",
                      "text": " calcula "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(3)"
                    },
                    {
                      "type": "text",
                      "text": " dos veces. "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "Fib(30)"
                    },
                    {
                      "type": "text",
                      "text": " es enormemente ineficiente. Esto motiva la Programación Dinámica (Módulo 13)."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-fibonacci-recurrencia-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Ecuación de recurrencia"
                }
              ]
            },
            {
              "id": "blk-fibonacci-recurrencia",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "step-fib-base-0",
                  "title": "Caso base 0",
                  "latex": "T(0)=1"
                },
                {
                  "stepId": "step-fib-base-1",
                  "title": "Caso base 1",
                  "latex": "T(1)=1"
                },
                {
                  "stepId": "step-fib-base-summary",
                  "title": "Casos base",
                  "latex": "T(0)=1,\\quad T(1)=1 \\quad \\text{son constantes}"
                },
                {
                  "stepId": "step-fib-general",
                  "title": "Caso general",
                  "latex": "T(n)=T(n-1)+T(n-2)\\quad \\text{para } n\\ge 2"
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-ejemplo-torres-hanoi",
          "slug": "ejemplo-torres-hanoi",
          "title": "11.4 Ejemplo: Torres de Hanói",
          "order": 5,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 14,
          "learningObjectives": [
            {
              "objectiveId": "entender-problema-hanoi",
              "text": "Entender el problema de Torres de Hanói, sus torres, discos y reglas."
            },
            {
              "objectiveId": "describir-estrategia-recursiva-hanoi",
              "text": "Describir la estrategia recursiva de tres pasos para mover n discos."
            },
            {
              "objectiveId": "leer-pseudocodigo-hanoi",
              "text": "Leer el caso base y el caso general en el pseudocódigo de Torres de Hanói."
            },
            {
              "objectiveId": "interpretar-arbol-hanoi",
              "text": "Interpretar el árbol de recursión de Torres de Hanói."
            },
            {
              "objectiveId": "plantear-costo-hanoi",
              "text": "Plantear y resolver la recurrencia de Torres de Hanói."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-estructura-algoritmo-recursivo",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-hanoi-descripcion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Tres torres (origen, auxiliar, destino) y "
                },
                {
                  "type": "inlineMath",
                  "latex": "n"
                },
                {
                  "type": "text",
                  "text": " discos apilados de mayor a menor en el origen."
                }
              ]
            },
            {
              "id": "blk-hanoi-reglas",
              "type": "note",
              "variant": "info",
              "title": "Reglas",
              "blocks": [
                {
                  "id": "blk-hanoi-reglas-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Mover un disco a la vez, nunca poner uno más grande sobre uno más pequeño."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-hanoi-estrategia-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Estrategia recursiva: para mover "
                },
                {
                  "type": "inlineMath",
                  "latex": "n"
                },
                {
                  "type": "text",
                  "text": " discos del origen al destino:"
                }
              ]
            },
            {
              "id": "blk-hanoi-estrategia-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Mover los "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-1"
                    },
                    {
                      "type": "text",
                      "text": " discos superiores del origen al auxiliar, usando destino como apoyo."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Mover el disco más grande del origen al destino."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Mover los "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-1"
                    },
                    {
                      "type": "text",
                      "text": " discos del auxiliar al destino, usando origen como apoyo."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-hanoi-pseudocodigo-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Pseudocódigo"
                }
              ]
            },
            {
              "id": "blk-hanoi-pseudocodigo",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "TH",
              "code": "TH(E int n, E char o, E char a, E char d) {\n  if (n = 1) then\n    Print('mover disco del origen al destino') # caso base\n  else\n    TH(n-1, o, d, a) # mueve n-1 al auxiliar\n    Print('mover disco del origen al destino')\n    TH(n-1, a, o, d) # mueve n-1 al destino\n  endif\n}"
            },
            {
              "id": "blk-hanoi-mermaid",
              "type": "mermaid",
              "title": "Mermaid — Torres de Hanói con n=4",
              "code": "graph TD\nA[\"TH(4, O, A, D)\"]\nA --> B[\"TH(3, O, D, A)\"]\nA --> C[\"Mover disco O → D\"]\nA --> D[\"TH(3, A, O, D)\"]\nB --> E[\"TH(2, O, A, D)\"]\nB --> F[\"Mover disco O → A\"]\nB --> G[\"TH(2, D, O, A)\"]\nE --> H[\"TH(1, O, D, A)\"]\nE --> I[\"Mover disco O → D\"]\nE --> J[\"TH(1, A, O, D)\"]\nH --> H1[\"Mover disco O → A\"]\nJ --> J1[\"Mover disco A → D\"]\nG --> K[\"TH(1, D, A, O)\"]\nG --> L[\"Mover disco D → O\"]\nG --> M[\"TH(1, A, D, O)\"]\nK --> K1[\"Mover disco D → O\"]\nM --> M1[\"Mover disco A → O\"]\nD --> N[\"TH(2, A, D, O)\"]\nD --> O[\"Mover disco A → D\"]\nD --> P[\"TH(2, O, A, D)\"]\nN --> Q[\"TH(1, A, O, D)\"]\nN --> R[\"Mover disco A → O\"]\nN --> S[\"TH(1, D, A, O)\"]\nQ --> Q1[\"Mover disco A → D\"]\nS --> S1[\"Mover disco D → O\"]\nP --> T[\"TH(1, O, D, A)\"]\nP --> U[\"Mover disco O → D\"]\nP --> V[\"TH(1, A, O, D)\"]\nT --> T1[\"Mover disco O → A\"]\nV --> V1[\"Mover disco A → D\"]"
            },
            {
              "id": "blk-hanoi-arbol-recursion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Árbol de recursión: cada nivel del árbol tiene el doble de nodos que el anterior. Nivel 1 → "
                },
                {
                  "type": "inlineMath",
                  "latex": "2^0"
                },
                {
                  "type": "text",
                  "text": ", Nivel 2 → "
                },
                {
                  "type": "inlineMath",
                  "latex": "2^1"
                },
                {
                  "type": "text",
                  "text": ", Nivel 3 → "
                },
                {
                  "type": "inlineMath",
                  "latex": "2^2"
                },
                {
                  "type": "text",
                  "text": ", Nivel "
                },
                {
                  "type": "inlineMath",
                  "latex": "k"
                },
                {
                  "type": "text",
                  "text": " → "
                },
                {
                  "type": "inlineMath",
                  "latex": "2^{k-1}"
                },
                {
                  "type": "text",
                  "text": ". Cada nodo cuesta una constante: un movimiento."
                }
              ]
            },
            {
              "id": "blk-hanoi-recurrencia",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "step-hanoi-rec",
                  "title": "Recurrencia",
                  "latex": "T(n)=2T(n-1)+1"
                },
                {
                  "stepId": "step-hanoi-base",
                  "title": "Caso base",
                  "latex": "T(1)=1"
                },
                {
                  "stepId": "step-hanoi-sol",
                  "title": "Solución",
                  "latex": "T(n)=2^n-1"
                },
                {
                  "stepId": "step-hanoi-order",
                  "title": "Orden",
                  "latex": "O(2^n)"
                }
              ]
            },
            {
              "id": "blk-hanoi-clasificacion-nota",
              "type": "note",
              "variant": "warning",
              "title": "Clasificación",
              "blocks": [
                {
                  "id": "blk-hanoi-clasificacion-nota-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Esta ecuación es de tipo 'Resta y serás vencido': "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "T(n)=aT(n-b)+f(n)"
                    },
                    {
                      "type": "text",
                      "text": " con "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "a>1"
                    },
                    {
                      "type": "text",
                      "text": ". El costo crece exponencialmente porque cada nivel duplica el número de llamadas."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-clasificacion-ecuaciones-recurrencia",
          "slug": "clasificacion-ecuaciones-recurrencia",
