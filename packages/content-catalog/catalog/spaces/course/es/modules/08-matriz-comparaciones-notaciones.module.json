  "learningObjectives": [
    {
      "objectiveId": "leer-matriz-comparaciones",
      "text": "Leer una matriz de comparación entre f(n) y g(n) usando ambas convenciones de límites."
    },
    {
      "objectiveId": "determinar-notaciones-aplicables",
      "text": "Determinar qué notaciones aplican para un par de funciones: O, Ω, Θ, o, ω y ~."
    },
    {
      "objectiveId": "interpretar-limite-cero-infinito",
      "text": "Interpretar los casos donde la Convención A da 0 y la Convención B da ∞, o viceversa."
    },
    {
      "objectiveId": "interpretar-limite-constante",
      "text": "Interpretar los casos donde ambas convenciones dan constantes finitas recíprocas."
    },
    {
      "objectiveId": "identificar-equivalencia-tilde",
      "text": "Identificar cuándo aplica la equivalencia asintótica exacta f ~ g."
    },
    {
      "objectiveId": "usar-tabla-como-referencia",
      "text": "Usar la matriz como referencia rápida para ejercicios de comparación asintótica."
    }
  ],
  "quizRefs": [],
  "contentRefs": [],
  "terms": [
    {
      "termId": "term-matriz-comparaciones",
      "label": "Matriz de comparaciones",
      "definition": "Tabla que cruza pares de funciones f(n) y g(n), muestra sus límites en ambas convenciones y marca qué notaciones aplican."
    },
    {
      "termId": "term-par-funciones",
      "label": "Par de funciones",
      "definition": "Dos funciones f(n) y g(n) que se comparan para determinar su relación asintótica."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convención A",
      "definition": "Convención que calcula el límite de f(n)/g(n)."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convención B / curso",
      "definition": "Convención usada en el curso que calcula el límite de g(n)/f(n)."
    },
    {
      "termId": "term-simetria-limites",
      "label": "Simetría de límites",
      "definition": "Relación entre ambas convenciones: si una da 0, la otra da ∞; si una da una constante finita, la otra da su recíproco; si una da 1, la otra también da 1."
    },
    {
      "termId": "term-reciproco",
      "label": "Recíproco",
      "definition": "Número inverso multiplicativo. Si un límite da c, el límite invertido da 1/c cuando c es finito y positivo."
    }
  ],
