          "blocks": [
            {
              "id": "blk-bubble-sort-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "BubbleSort",
              "code": "BubbleSort (E/S int A[n]) { for i <- 1 to (n-1) do for j <- 1 to (n-i) do if A[j] > A[j+1] then swap(A[j], A[j+1]) endif endfor endfor\n}"
            },
            {
              "id": "blk-bubble-sort-invariante",
              "type": "note",
              "variant": "info",
              "title": "Invariante del ciclo for externo (variable i)",
              "blocks": [
                {
                  "id": "blk-bubble-sort-invariante-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Despues de completar la iteraci?n"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": "del ciclo externo, los"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": "elementos más grandes están en sus posiciones definitivas al final del arreglo"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[n-i+1..n]"
                    },
                    {
                      "type": "text",
                      "text": ", en orden no decreciente."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-bubble-sort-demostracion-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Demostracion de los 3 momentos"
                }
              ]
            },
            {
              "id": "blk-bubble-sort-demostracion",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Inicializacion (i=1):"
                    },
                    {
                      "type": "text",
                      "text": "Antes de empezar, no hay elementos asegurados al final del arreglo. La propiedad es trivialmente cierta (0 elementos ordenados al final)."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Mantenimiento:"
                    },
                    {
                      "type": "text",
                      "text": "Durante la iteraci?n"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": ", el ciclo interno empuja el m?ximo elemento del subarreglo no ordenado"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[1..n-i+1]"
                    },
                    {
                      "type": "text",
                      "text": "hacia la posición"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-i+1"
                    },
                    {
                      "type": "text",
                      "text": ". Al terminar, ese elemento queda en su posición definitiva."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Terminacion (i=n):"
                    },
                    {
                      "type": "text",
                      "text": "Se han colocado los"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n-1"
                    },
                    {
                      "type": "text",
                      "text": "elementos más grandes. El —nico restánte es el más peque?o y ya está en su lugar. El arreglo está completamente ordenado."
                    }
                  ]
                }
              ]
            },
