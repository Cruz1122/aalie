      "order": 1,
      "summary": "Demostracion de correctitud mediante invariantes de ciclo, aplicada a algoritmos de ordenamiento.",
      "sections": [
        {
          "sectionId": "sec-loop-invariant-introduccion",
          "slug": "loop-invariant-introduccion",
          "title": "2. Loop Invariant (Invariante de Ciclo)",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 6,
          "learningObjectives": [
            {
              "objectiveId": "comprender-loop-invariant",
              "text": "Comprender que el loop invariant reemplaza la validacion por casos particulares."
            },
            {
              "objectiveId": "identificar-tres-momentos",
              "text": "Identificar inicialización, mantenimiento y terminación cómo los tres momentos obligatorios."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-loop-invariant-definicion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El loop invariant (invariante de ciclo) es el mecanismo que usamos para demostrar que un algoritmo es correcto, es decir, que hace lo que dice que hace. Reemplaza la costumbre de probar con casos, ya que los casos nunca demuestran correctitud general."
                }
              ]
            },
            {
              "id": "blk-loop-invariant-propiedad-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El invariante es una propiedad logica que:"
                }
              ]
            },
            {
              "id": "blk-loop-invariant-propiedades",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Captura la razon de ser del algoritmo (su semantica)."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Esta asociada al ciclo principal del algoritmo."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Debe demostrarse en exactamente 3 momentos."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-loop-invariant-tres-momentos-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Los 3 momentos del Loop Invariant"
                }
              ]
            },
            {
              "id": "blk-loop-invariant-tres-momentos",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "INICIALIZACION:"
                    },
                    {
                      "type": "text",
                      "text": "La propiedad es cierta antes de la primera iteraci?n del ciclo."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "MANTENIMIENTO:"
                    },
                    {
                      "type": "text",
                      "text": "Si la propiedad es cierta antes de una iteraci?n, sigue siendo cierta antes de la siguiente iteraci?n."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "TERMINACION:"
                    },
                    {
                      "type": "text",
                      "text": "Cuando el ciclo termina, la propiedad combinada con la condición de parada demuestra que el algoritmo funciona correctamente."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-secuencia-conjunto",
          "slug": "secuencia-conjunto",
          "title": "2.1 Nociones de Secuencia y Conjunto",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "learningObjectives": [
            {
              "objectiveId": "diferenciar-secuencia-conjunto",
              "text": "Diferenciar secuencia y conjunto para evitar invariantes mal formulados."
            }
          ],
          "prerequisites": {
            "modules": [],
            "sections": [
              {
                "id": "sec-loop-invariant-introduccion",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-secuencia-conjunto-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Para formular invariantes correctamente, es crucial distinguir:"
                }
              ]
            },
            {
              "id": "blk-definicion-secuencia",
              "type": "definition",
              "title": "Secuencia",
              "blocks": [
                {
                  "id": "blk-definicion-secuencia-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "El orden importa."
                    },
                    {
                      "type": "inlineMath",
                      "latex": "S_1 = \\langle 3, 7, 1, 5, 4 \\rangle"
                    },
                    {
                      "type": "text",
                      "text": "es diferente de"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "S_2 = \\langle 7, 3, 5, 4, 1 \\rangle"
                    },
                    {
                      "type": "text",
                      "text": "aunque tengan los mismos elementos."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-definicion-conjunto",
              "type": "definition",
              "title": "Conjunto",
              "blocks": [
                {
                  "id": "blk-definicion-conjunto-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "El orden no importa."
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A = \\{3, 7, 1, 5, 4\\}"
                    },
                    {
                      "type": "text",
                      "text": "es igual que"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "B = \\{7, 1, 5, 3, 4\\}"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-secuencia-conjunto-cierre",
              "type": "note",
              "variant": "info",
              "title": "Regla para invariantes",
              "blocks": [
                {
                  "id": "blk-secuencia-conjunto-cierre-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "En los invariantes siempre se trabaja con secuencias cuando el orden de los elementos importa (cómo en ordenamiento)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-insertion-sort-invariante",
          "slug": "insertion-sort-invariante",
          "title": "2.2 Ejemplo: Algoritmo de Insercion",
          "order": 3,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "learningObjectives": [
            {
              "objectiveId": "entender-insertion-sort",
              "text": "Entender cómo funciona Insertion Sort bajo el paradigma incremental."
            },
            {
              "objectiveId": "formular-invariante-for-insertion",
              "text": "Formular el invariante del ciclo for de Insertion Sort."
            },
            {
              "objectiveId": "demostrar-invariante-insertion",
              "text": "Demostrar el invariante de Insertion Sort en inicialización, mantenimiento y terminación."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-secuencia-conjunto",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-insertion-sort-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El algoritmo de ordenamiento por inserción funciona bajo el paradigma incremental: mantiene un subarreglo ordenado que crece en cada iteraci?n."
                }
              ]
            },
            {
              "id": "blk-insertion-sort-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "InsertionSort",
              "code": "InsertionSort (E/S int A[n]) { for i <- 2 to n do x <- A[i] j <- i - 1 while (j >= 1) and (x < A[j]) do A[j+1] <- A[j] j <- j - 1 endwhile A[j+1] <- x endfor\n}"
            },
            {
              "id": "blk-insertion-sort-como-funciona",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "?C?mo funciona?Empieza en la posición 2 ("
                },
                {
                  "type": "inlineMath",
                  "latex": "i=2"
                },
                {
                  "type": "text",
                  "text": "). Para cada posición"
                },
                {
                  "type": "inlineMath",
                  "latex": "i"
                },
                {
                  "type": "text",
                  "text": ", extrae el elemento"
                },
                {
                  "type": "inlineMath",
                  "latex": "A[i]"
                },
                {
                  "type": "text",
                  "text": "y lo inserta en la posición correcta dentro del subarreglo ya ordenado"
                },
                {
                  "type": "inlineMath",
                  "latex": "A[1..i-1]"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-insertion-sort-invariante",
              "type": "note",
              "variant": "info",
              "title": "Invariante del ciclo for",
              "blocks": [
                {
                  "id": "blk-insertion-sort-invariante-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Los elementos en las posiciones"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[1..i-1]"
                    },
                    {
                      "type": "text",
                      "text": "son los mismos elementos que estaban en"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "A[1..i-1]"
                    },
                    {
                      "type": "text",
                      "text": "al inicio, pero organizados en orden no decreciente."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-insertion-sort-demostracion-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Demostracion de los 3 momentos"
                }
              ]
            },
            {
              "id": "blk-insertion-sort-demostracion-tabla",
              "type": "table",
              "title": "Demostracion del invariante de Insertion Sort",
              "columns": [
                {
                  "key": "momento",
                  "label": "Momento"
                },
                {
                  "key": "i",
                  "label": "i"
                },
                {
                  "key": "estado",
                  "label": "Estado del arreglo"
                },
                {
                  "key": "cumple",
                  "label": "Se cumple?"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Inicializacion"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "i = 2"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "A[1..1]"
                      },
                      {
                        "type": "text",
                        "text": "tiene un solo elemento. Por definición, un arreglo de un elemento está ordenado."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Si"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Mantenimiento"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "i = k"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Antes de la iteraci?n"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "k"
                      },
                      {
                        "type": "text",
                        "text": ","
                      },
                      {
                        "type": "inlineMath",
                        "latex": "A[1..k-1]"
                      },
                      {
                        "type": "text",
                        "text": "está ordenado. El while inserta"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "A[k]"
                      },
                      {
                        "type": "text",
                        "text": "en su lugar correcto, dejando"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "A[1..k]"
                      },
                      {
                        "type": "text",
                        "text": "ordenado."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Si"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Terminacion"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "i = n+1"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Cuando el for termina ("
                      },
                      {
                        "type": "inlineMath",
                        "latex": "i=n+1"
                      },
                      {
                        "type": "text",
                        "text": "), la propiedad dice que"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "A[1..n]"
                      },
                      {
                        "type": "text",
                        "text": "está ordenado. El arreglo completo está ordenado."
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Correctitud demostrada"
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-insertion-sort-nota-j",
              "type": "note",
              "variant": "warning",
              "title": "Nota",
              "blocks": [
                {
                  "id": "blk-insertion-sort-nota-j-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "En la formulacion del invariante nunca se habla de"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "j"
                    },
                    {
                      "type": "text",
                      "text": "(variable del ciclo interno). El invariante del for solo habla de"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "i"
                    },
                    {
                      "type": "text",
                      "text": ". Cada ciclo tiene su propio invariante."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-insertion-sort-eficiencia",
          "slug": "insertion-sort-eficiencia",
          "title": "2.3 Análisis de Eficiencia — Insertion Sort",
          "order": 4,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 8,
          "learningObjectives": [
            {
              "objectiveId": "analizar-mejor-caso-insertion",
              "text": "Analizar el mejor caso de Insertion Sort cuando el arreglo ya está ordenado."
            },
            {
              "objectiveId": "analizar-peor-caso-insertion",
              "text": "Analizar el peor caso de Insertion Sort cuando el arreglo está en orden inverso."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-insertion-sort-invariante",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-insertion-eficiencia-mejor-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Mejor Caso (arreglo ya ordenado)"
                }
              ]
            },
            {
              "id": "blk-insertion-eficiencia-mejor-explicacion",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El while nunca se ejecuta porque la condición"
                },
                {
                  "type": "inlineMath",
                  "latex": "x < A[j]"
                },
                {
                  "type": "text",
                  "text": "es siempre falsa (el elemento a insertar ya está en su lugar)."
                }
              ]
            },
            {
              "id": "blk-insertion-eficiencia-mejor-tabla",
              "type": "table",
              "title": "Mejor caso de Insertion Sort",
              "columns": [
                {
                  "key": "linea",
                  "label": "Linea"
                },
                {
                  "key": "costo",
                  "label": "Costo"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "for i <- 2 to n"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "n"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "x <- A[i]"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "n-1"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "j <- i-1"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "n-1"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "while (condición)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "n-1"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "A[j+1] <- x"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "n-1"
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-insertion-eficiencia-mejor-resultado",
              "type": "note",
              "variant": "success",
              "title": "Resultado del mejor caso",
              "blocks": [
                {
                  "id": "blk-insertion-eficiencia-mejor-resultado-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "inlineMath",
                      "latex": "T_{best}(n) = A n — B"
                    },
                    {
                      "type": "text",
                      "text": "-> lineal"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "O(n)"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
