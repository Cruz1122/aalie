              "id": "blk-bubble-sort-for-interno",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El for interno se ejecuta"
                },
                {
                  "type": "inlineMath",
                  "latex": "n-i"
                },
                {
                  "type": "text",
                  "text": "veces para cada valor de"
                },
                {
                  "type": "inlineMath",
                  "latex": "i"
                },
                {
                  "type": "text",
                  "text": ":"
                }
              ]
            },
            {
              "id": "blk-bubble-sort-sumatoria",
              "type": "equationBlock",
              "latex": "\\sum_{i=1}^{n-1}(n-i) = (n-1) + (n-2) + \\cdots + 1 = \\frac{n(n-1)}{2}"
            },
            {
              "id": "blk-bubble-sort-tn",
              "type": "latexSteps",
              "title": "Funci?n de eficiencia de Bubble Sort",
              "steps": [
