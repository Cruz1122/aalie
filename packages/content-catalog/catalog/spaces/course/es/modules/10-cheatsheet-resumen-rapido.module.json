              { "id": "mod-complejidad-temporal-espacial", "kind": "required" },
              { "id": "mod-tabla-sumatorias-comunes", "kind": "required" }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-cheatsheet-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Este módulo consolida los módulos 1 al 9 en formato de referencia rápida. Está pensado para repasar antes de parciales o para consultar durante ejercicios, no para reemplazar las explicaciones completas de los módulos anteriores."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-receta-analizar-algoritmo-iterativo",
          "slug": "receta-analizar-algoritmo-iterativo",
          "title": "10.1 Receta para analizar un algoritmo iterativo",
          "order": 2,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "seguir-receta-iterativa",
              "text": "Seguir una secuencia mínima de pasos para analizar un algoritmo iterativo."
            }
          ],
          "prerequisites": {
            "modules": [
              { "id": "mod-complejidad-temporal-espacial", "kind": "required" },
              { "id": "mod-algoritmos-iterativos-patrones-costos", "kind": "required" }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-receta-iterativo-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Identificar todas las líneas, sin contar los "
                    },
                    {
                      "type": "inlineCode",
                      "text": "end"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Para cada línea, determinar cuántas veces se ejecuta en función de "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Sumar todos los costos para obtener "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "T(n)"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Identificar el término dominante y aplicar la notación asintótica."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-receta-demostrar-pertenencia-asintotica",
          "slug": "receta-demostrar-pertenencia-asintotica",
          "title": "10.2 Receta para demostrar pertenencia a una familia asintótica",
          "order": 3,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "seguir-receta-pertenencia",
              "text": "Seguir una secuencia mínima para demostrar pertenencia a una familia asintótica mediante límites."
            }
          ],
          "prerequisites": {
            "modules": [
              { "id": "mod-notaciones-asintoticas", "kind": "required" },
              { "id": "mod-demostraciones-completas-teorema-limites", "kind": "required" }
            ],
            "sections": [
              { "id": "sec-teorema-general-limites", "kind": "required" }
            ]
          },
          "blocks": [
            {
              "id": "blk-receta-pertenencia-lista",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Calcular "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "L=\\lim_{n\\to\\infty}\\frac{f(n)}{g(n)}"
                    },
                    {
                      "type": "text",
                      "text": " o "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "L=\\lim_{n\\to\\infty}\\frac{g(n)}{f(n)}"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Aplicar el teorema de límites para identificar qué notaciones aplican."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Concluir explícitamente con la notación correspondiente."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-tecnicas-calcular-limites",
          "slug": "tecnicas-calcular-limites",
          "title": "10.3 Técnicas para calcular límites",
          "order": 4,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "learningObjectives": [
            {
              "objectiveId": "identificar-tecnicas-limites",
              "text": "Identificar técnicas frecuentes para resolver límites en comparaciones asintóticas."
            }
          ],
          "prerequisites": {
            "modules": [
              { "id": "mod-demostraciones-completas-teorema-limites", "kind": "required" }
            ],
            "sections": []
          },
          "blocks": [
            {
              "id": "blk-tecnicas-limites-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Dividir numerador y denominador por el término dominante del denominador."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Regla de L'Hôpital: si el límite es "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "\\infty/\\infty"
                    },
                    {
                      "type": "text",
                      "text": " o "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "0/0"
                    },
                    {
                      "type": "text",
                      "text": ", derivar numerador y denominador."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Logaritmos: para comparar funciones exponenciales, aplicar log a ambas."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Serie de Taylor: para aproximaciones más finas cerca del límite."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
