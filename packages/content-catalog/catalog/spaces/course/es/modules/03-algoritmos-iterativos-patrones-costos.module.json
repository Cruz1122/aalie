  "terms": [
    {
      "termId": "term-for-simple",
      "label": "for simple",
      "definition": "Ciclo cuyo contador recorre un rango lineal, normalmente de 1 a n."
    },
    {
      "termId": "term-for-anidado",
      "label": "for anidado",
      "definition": "Ciclo for ubicado dentro de otro ciclo for. Su costo depende de la combinacion de ambos rangos."
    },
    {
      "termId": "term-limite-fijo",
      "label": "límite fijo",
      "definition": "Limite de un ciclo interno que no depende del indice externo."
    },
    {
      "termId": "term-limite-variable",
      "label": "límite variable",
      "definition": "Limite de un ciclo interno que depende del indice externo."
    },
    {
      "termId": "term-while-duplicacion",
      "label": "while con duplicación",
      "definition": "Ciclo while donde la variable de control se multiplica por una constante, generando comportamiento logarítmico."
    },
    {
      "termId": "term-busqueda-secuencial",
      "label": "búsqueda secuencial",
      "definition": "Algoritmo que recorre un arreglo posición por posición hasta encontrar un elemento o confirmar que no está."
    },
    {
      "termId": "term-mejor-caso",
      "label": "mejor caso",
      "definition": "Entrada que hace que el algoritmo ejecute la menor cantidad de trabajo posible."
    },
    {
      "termId": "term-peor-caso",
      "label": "peor caso",
      "definition": "Entrada que hace que el algoritmo ejecute la mayor cantidad de trabajo posible."
    },
    {
      "termId": "term-caso-promedio",
      "label": "caso promedio",
      "definition": "Costo esperado cuando las entradas posibles se consideran bajo un modelo probabilístico, por ejemplo distribución uniforme."
    },
    {
      "termId": "term-metodo-limites",
      "label": "método de los límites",
      "definition": "Tecnica formal para comparar dos funciones calculando el límite del cociente entre ellas cuando n tiende a infinito."
    }
  ],
