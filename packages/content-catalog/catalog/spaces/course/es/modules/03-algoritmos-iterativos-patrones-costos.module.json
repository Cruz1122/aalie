                        "type": "inlineMath",
                        "latex": "10^{30}"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "\\gg 10^{300}"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Inmanejable para n grande."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineMath",
                        "latex": "O(n!)"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Factorial"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "3, 628, 800"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "\\gg 10^{157}"
                      },
                      {
                        "type": "text",
                        "text": "inmenso"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "inmenso"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Practicamente imposible."
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-orden-crecimiento-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Orden de crecimiento (de menor a mayor)"
                }
              ]
            },
            {
              "id": "blk-orden-crecimiento-formula",
              "type": "equationBlock",
              "latex": "1 < \\log(n) < n < n\\log(n) < n^2 < n^3 < \\cdots < 2^n < 3^n < n!"
            },
            {
              "id": "blk-logaritmos-base-nota",
              "type": "note",
              "variant": "info",
              "title": "Nota",
              "blocks": [
                {
                  "id": "blk-logaritmos-base-nota-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "En logaritmos, si no aparece la base, se asume base 2 (convención del curso)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-comparar-funciones-correctamente",
          "slug": "comparar-funciones-correctamente",
          "title": "3.4 Como comparar funciones correctamente",
          "order": 4,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 8,
          "learningObjectives": [
            {
              "objectiveId": "rechazar-comparacion-grafica",
              "text": "Entender por qué graficar o tabular no es la forma formal de comparar funciones."
            },
            {
              "objectiveId": "aplicar-limite-cociente",
              "text": "Aplicar el límite del cociente para decidir que función crece más rápido."
            },
            {
              "objectiveId": "interpretar-limite-cero-constante-infinito",
              "text": "Interpretar los casos L=0, L constante positiva y L infinito."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-complejidad-temporal-espacial",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-tabla-crecimiento-funciones-comunes",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-comparar-funciones-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La manera correcta de comparar funciones no es graficando ni tabulando. Se usan desigualdades y límites."
                }
              ]
            },
            {
              "id": "blk-metodo-limites-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Método de los límites"
                }
              ]
            },
            {
              "id": "blk-metodo-limites-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Para comparar"
                },
                {
                  "type": "inlineMath",
                  "latex": "f(n)"
                },
                {
                  "type": "text",
                  "text": "y"
                },
                {
                  "type": "inlineMath",
                  "latex": "g(n)"
                },
                {
                  "type": "text",
                  "text": ", calculamos:"
                }
              ]
            },
            {
              "id": "blk-metodo-limites-formula",
              "type": "equationBlock",
              "latex": "\\lim_{n \\to \\infty}\\frac{f(n)}{g(n)} = L"
            },
            {
              "id": "blk-metodo-limites-tabla",
              "type": "table",
              "title": "Interpretación del límite para comparar funciones",
              "columns": [
                {
                  "key": "resultado",
                  "label": "Resultado L"
                },
                {
                  "key": "significado",
                  "label": "Significado"
                },
                {
                  "key": "relacion",
                  "label": "Relacion"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "inlineMath",
                        "latex": "L=0"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      },
                      {
                        "type": "text",
                        "text": "crece más rápido que"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "crece más lento que"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "L = constante"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "(c>0)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "y"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      },
                      {
                        "type": "text",
                        "text": "crecen a la misma velocidad"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Son del mismo orden"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineMath",
                        "latex": "L=\\infty"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "crece más rápido que"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ],
                    [
                      {
                        "type": "inlineMath",
                        "latex": "f(n)"
                      },
                      {
                        "type": "text",
                        "text": "domina a"
                      },
                      {
                        "type": "inlineMath",
                        "latex": "g(n)"
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Ejemplo"
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-enunciado",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Comparar"
                },
                {
                  "type": "inlineMath",
                  "latex": "f(n)=3n^2+5n"
                },
                {
                  "type": "text",
                  "text": "y"
                },
                {
                  "type": "inlineMath",
                  "latex": "g(n)=n^2"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-limite",
              "type": "latexSteps",
              "title": "Cálculo del límite",
              "steps": [
                {
                  "stepId": "plantear-el-cociente",
                  "title": "Plantear el cociente",
                  "latex": "\\lim_{n \\to \\infty}\\frac{3n^2+5n}{n^2}"
                },
                {
                  "stepId": "dividir-por-n-cuadrado",
                  "title": "Dividir por n^2",
                  "latex": "\\lim_{n \\to \\infty}\\left(3+\\frac{5}{n}\\right)"
                },
                {
                  "stepId": "evaluar-el-limite",
                  "title": "Evaluar el límite",
                  "latex": "3+0=3"
                }
              ]
            },
            {
              "id": "blk-ejemplo-comparar-funciones-conclusion",
              "type": "note",
              "variant": "success",
              "title": "Conclusión",
              "blocks": [
                {
                  "id": "blk-ejemplo-comparar-funciones-conclusion-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "inlineMath",
                      "latex": "L=3"
                    },
                    {
                      "type": "text",
                      "text": "es una constante positiva. Entonces"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "f(n)"
                    },
                    {
                      "type": "text",
                      "text": "y"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "g(n)"
                    },
                    {
                      "type": "text",
                      "text": "son del mismo orden. Crecen a la misma velocidad."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
