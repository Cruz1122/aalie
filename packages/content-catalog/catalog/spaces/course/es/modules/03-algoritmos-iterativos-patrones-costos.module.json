              "blocks": [
                {
                  "id": "blk-busqueda-secuencial-nota-peor-caso-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "¿Es tan malo como que "
                    },
                    {
                      "type": "inlineMath",
