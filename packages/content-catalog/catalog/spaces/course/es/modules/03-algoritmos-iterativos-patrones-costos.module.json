          "blocks": [
            {
              "id": "blk-busqueda-secuencial-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "BusquedaSecuencial",
              "code": "int BusquedaSecuencial (E int A[n], E int x) {\n  i <- 1                             # C1 * 1\n  while (A[i]<>x) and (i<=n)         # C2 * (n+1) en peor caso\n    i <- i + 1                       # C3 * n\n  endwhile\n  if (i <= n) then                   # C4 * 1\n    return i\n  else\n    return -1                        # C5 * 1\n}"
            },
            {
              "id": "blk-busqueda-secuencial-precondiciones",
              "type": "note",
              "variant": "info",
              "title": "Precondiciones",
              "blocks": [
                {
                  "id": "blk-busqueda-secuencial-precondiciones-texto",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "inlineMath",
                      "latex": "A[i] \\in \\mathbb{Z}"
                    },
                    {
                      "type": "text",
                      "text": ","
                    },
                    {
                      "type": "inlineMath",
                      "latex": "1 \\le i \\le n"
                    },
                    {
                      "type": "text",
                      "text": ". Si"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "x"
                    },
                    {
                      "type": "text",
                      "text": "no está en el arreglo, retorna"
                    },
                    {
                      "type": "inlineMath",
                      "latex": "-1"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
