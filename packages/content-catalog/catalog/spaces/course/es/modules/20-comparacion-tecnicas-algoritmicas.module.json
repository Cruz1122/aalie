  "terms": [
    {
      "termId": "term-tecnica-algoritmica",
      "label": "Técnica algorítmica",
      "definition": "Patrón de diseño o análisis usado para resolver una familia de problemas con una estructura reconocible."
    },
    {
      "termId": "term-senal-estructural",
      "label": "Señal estructural",
      "definition": "Rasgo del problema o del algoritmo que sugiere una técnica: subproblemas, decisiones, solapamiento, restricciones, cotas o ciclos."
    },
    {
      "termId": "term-subproblemas-independientes",
      "label": "Subproblemas independientes",
      "definition": "Subproblemas que se resuelven sin reutilizar resultados entre sí. Son típicos de Divide y Vencerás."
    },
    {
      "termId": "term-subproblemas-superpuestos-comparacion",
      "label": "Subproblemas superpuestos",
      "definition": "Subproblemas que aparecen repetidos y justifican guardar resultados mediante Programación Dinámica."
    },
    {
      "termId": "term-decision-irrevocable",
      "label": "Decisión irrevocable",
      "definition": "Decisión que no se reconsidera después de aceptarse. Es típica de los algoritmos voraces."
    },
    {
      "termId": "term-decision-reversible",
      "label": "Decisión reversible",
      "definition": "Decisión que puede deshacerse para probar otra alternativa. Es típica del backtracking."
    },
    {
      "termId": "term-poda-factibilidad-comparacion",
      "label": "Poda por factibilidad",
      "definition": "Descarte de una rama porque viola restricciones y no puede llevar a una solución válida."
    },
    {
      "termId": "term-poda-suboptimalidad-comparacion",
      "label": "Poda por suboptimalidad",
      "definition": "Descarte de una rama porque su mejor valor posible no mejora la mejor solución conocida."
    },
    {
      "termId": "term-garantia-optimalidad",
      "label": "Garantía de optimalidad",
      "definition": "Justificación de que la técnica encuentra una solución óptima, no solo una solución válida o razonable."
    },
    {
      "termId": "term-linea-base-fuerza-bruta",
      "label": "Línea base de fuerza bruta",
      "definition": "Solución exhaustiva usada como referencia inicial para entender el espacio completo antes de podar, guardar o elegir mejor."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-comparacion-tecnicas-algoritmicas",
      "slug": "comparacion-tecnicas-algoritmicas",
      "title": "Comparación de Técnicas Algorítmicas",
      "order": 1,
      "summary": "Síntesis para elegir técnica según la estructura del problema, las garantías requeridas y el costo esperado.",
      "sections": [
        {
          "sectionId": "sec-idea-central-comparacion-tecnicas",
          "slug": "idea-central-comparacion-tecnicas",
          "title": "Idea central: no se elige la técnica por gusto",
          "order": 1,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 7,
          "blocks": [
            {
              "id": "blk-comparacion-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La técnica algorítmica no se elige por moda ni por comodidad. Se elige porque el problema tiene una estructura que la justifica: subproblemas independientes, subproblemas repetidos, decisiones locales seguras, restricciones parciales, cotas o búsqueda exhaustiva."
                }
              ]
            },
            {
              "id": "blk-comparacion-principio",
              "type": "note",
              "variant": "warning",
              "title": "Principio de selección",
              "blocks": [
                {
                  "id": "blk-comparacion-principio-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Primero se identifica la estructura del problema; después se decide la técnica. Hacerlo al revés suele producir algoritmos que parecen sofisticados pero no están justificados."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-senales-estructurales-table",
              "type": "table",
              "title": "Señales estructurales y técnica sugerida",
              "columns": [
                {
                  "key": "senal",
                  "label": "Señal estructural"
                },
                {
                  "key": "pregunta",
                  "label": "Pregunta diagnóstica"
                },
                {
                  "key": "tecnica",
                  "label": "Técnica candidata"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Costo acumulado por instrucciones repetidas"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿El algoritmo se explica principalmente por ciclos?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Análisis iterativo"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Problema se divide en partes independientes"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Los subproblemas no comparten resultados?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Divide y Vencerás"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Problema se reduce a una versión más pequeña"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Cada paso reduce el tamaño y continúa con un subproblema?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Resta y Vencerás / recursión lineal"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Subproblemas repetidos"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿El mismo estado se calcula varias veces?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Programación Dinámica"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Elección local segura"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Se puede demostrar que escoger lo mejor ahora no daña el óptimo?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Voraz"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Soluciones parciales bajo restricciones"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Puedo podar una rama apenas viola una restricción?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Backtracking"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Optimización con cotas"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Puedo estimar si una rama ya no puede mejorar la mejor solución?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Branch and Bound"
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "No hay estructura explotable"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "¿Solo queda probar todas las posibilidades?"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Fuerza bruta"
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-modelo-decision-tecnica",
          "slug": "modelo-decision-tecnica",
          "title": "Modelo de decisión para elegir técnica",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "blocks": [
            {
              "id": "blk-modelo-decision-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Una forma disciplinada de elegir técnica es responder preguntas en cascada. Cada pregunta descarta técnicas que no corresponden."
                }
              ]
            },
            {
              "id": "blk-modelo-decision-cases",
              "type": "equationBlock",
              "title": "Modelo de selección de técnica",
              "latex": "Tecnica(P)=\\begin{cases}\\text{Iterativa},& P\\ \\text{se resuelve por acumulación de pasos en ciclos}\\\\\\text{Divide y Vencerás},& P\\to \\text{subproblemas independientes}\\\\\\text{Resta y Vencerás},& P\\to \\text{un subproblema menor dominante}\\\\\\text{Programación Dinámica},& P\\to \\text{subproblemas superpuestos}\\\\\\text{Voraz},& P\\to \\text{elección local segura demostrable}\\\\\\text{Backtracking},& P\\to \\text{decisiones reversibles con poda por factibilidad}\\\\\\text{Branch and Bound},& P\\to \\text{optimización con cotas de poda}\\\\\\text{Fuerza Bruta},& \\text{sin estructura explotable clara}\\end{cases}"
            },
            {
              "id": "blk-expl-modelo-decision-cases",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Este modelo clasifica el problema "
                },
                {
                  "type": "strong",
                  "text": "P"
                },
                {
                  "type": "text",
                  "text": " según su naturaleza estructural. La clave es identificar la relación entre el problema original y sus subproblemas o decisiones. Por ejemplo, si un problema se divide en partes que no comparten información, la técnica lógica es "
                },
                {
                  "type": "emphasis",
                  "text": "Divide y Vencerás"
                },
                {
                  "type": "text",
                  "text": "; si las decisiones son irreversibles y locales, es "
                },
                {
                  "type": "emphasis",
                  "text": "Voraz"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-flujo-decision-tecnica",
              "type": "mermaid",
              "title": "Flujo de selección de técnica",
              "code": "flowchart TD\n A[\"Problema\"] --> B{\"¿Hay algoritmo dado para analizar?\"}\n B -- \"Sí\" --> C{\"¿Predominan ciclos?\"}\n C -- \"Sí\" --> D[\"Análisis iterativo\"]\n C -- \"No\" --> E{\"¿Predomina recursión?\"}\n E -- \"Sí\" --> F[\"Plantear recurrencia\"]\n F --> G{\"¿Subproblemas independientes?\"}\n G -- \"Sí\" --> H[\"Divide y Vencerás / métodos de recurrencia\"]\n G -- \"No\" --> I{\"¿Estados repetidos?\"}\n I -- \"Sí\" --> J[\"Programación Dinámica\"]\n I -- \"No\" --> K[\"Resta y Vencerás / recursión lineal\"]\n B -- \"No\" --> L{\"¿Es problema de optimización?\"}\n L -- \"Sí\" --> M{\"¿Elección local segura?\"}\n M -- \"Sí\" --> N[\"Voraz\"]\n M -- \"No\" --> O{\"¿Hay cotas útiles?\"}\n O -- \"Sí\" --> P[\"Branch and Bound\"]\n O -- \"No\" --> Q{\"¿Hay restricciones parciales?\"}\n Q -- \"Sí\" --> R[\"Backtracking\"]\n Q -- \"No\" --> S[\"Fuerza bruta / búsqueda exhaustiva\"]\n L -- \"No\" --> T{\"¿Se buscan soluciones válidas bajo restricciones?\"}\n T -- \"Sí\" --> R\n T -- \"No\" --> S"
            }
          ]
        },
        {
          "sectionId": "sec-tabla-comparativa-global",
          "slug": "tabla-comparativa-global",
