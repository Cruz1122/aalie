  "learningObjectives": [
    {
      "objectiveId": "distinguir-tecnicas-por-estructura",
      "text": "Distinguir técnicas algorítmicas según la estructura del problema y no solo por apariencia del código."
    },
    {
      "objectiveId": "identificar-subproblemas-independientes",
      "text": "Identificar cuándo un problema se divide en subproblemas independientes y conviene usar Divide y Vencerás."
    },
    {
      "objectiveId": "identificar-subproblemas-superpuestos",
      "text": "Identificar cuándo hay subproblemas superpuestos y conviene usar Programación Dinámica."
    },
    {
      "objectiveId": "distinguir-voraz-pd",
      "text": "Distinguir problemas donde una elección local demostrable basta de problemas que requieren evaluar alternativas."
    },
    {
      "objectiveId": "distinguir-backtracking-bb",
      "text": "Distinguir backtracking de Branch and Bound por el tipo de poda: factibilidad contra suboptimalidad."
    },
    {
      "objectiveId": "usar-fuerza-bruta-como-linea-base",
      "text": "Usar fuerza bruta como línea base conceptual antes de justificar una técnica más eficiente."
    },
    {
      "objectiveId": "comparar-garantias",
      "text": "Comparar qué técnicas garantizan solución óptima, cuáles requieren demostración adicional y cuáles pueden ser solo heurísticas."
    },
    {
      "objectiveId": "comparar-costos",
      "text": "Comparar tiempo y espacio típicos de cada técnica."
    },
    {
      "objectiveId": "clasificar-problemas",
      "text": "Clasificar un problema dado según señales estructurales: ciclos, recurrencia, tabla, elección local, árbol de decisiones o cotas."
    },
    {
      "objectiveId": "evitar-confusiones",
      "text": "Evitar confusiones comunes: llamar voraz a cualquier algoritmo rápido, llamar PD a cualquier tabla o llamar B&B a cualquier backtracking."
    }
  ],
