        {
          "sectionId": "sec-demostracion-theta-n2",
          "slug": "demostracion-theta-n2",
          "title": "Demostración 1: 3n² + 5n ∈ Θ(n²)",
          "order": 2,
          "kind": "example",
          "trackProgress": true,
          "estimatedMinutes": 10,
          "learningObjectives": [
            {
              "objectiveId": "calcular-limite-theta",
              "text": "Calcular el límite de (3n² + 5n)/n²."
            },
            {
              "objectiveId": "aplicar-teorema-theta",
              "text": "Aplicar el teorema cuando el límite es una constante positiva finita."
            },
            {
              "objectiveId": "verificar-theta-definicion",
              "text": "Verificar la pertenencia a Θ(n²) usando c₁, c₂ y n₀."
            }
          ],
          "prerequisites": {
            "modules": [
              {
                "id": "mod-notaciones-asintoticas",
                "kind": "required"
              },
              {
                "id": "mod-tabla-maestra-notaciones-convenciones",
                "kind": "required"
              }
            ],
            "sections": [
              {
                "id": "sec-teorema-general-limites",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-demo1-enunciado",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Demostrar que "
                },
                {
                  "type": "inlineMath",
                  "latex": "3n^2 + 5n \\in \\Theta(n^2)"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-demo1-paso1-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Paso 1 — Calcular el límite (Conv. A)"
                }
              ]
            },
            {
              "id": "blk-demo1-paso1-formulas",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "plantear",
                  "title": "Plantear el límite",
                  "latex": "\\lim_{n \\to \\infty}\\frac{3n^2 + 5n}{n^2}"
                },
                {
                  "stepId": "dividir",
                  "title": "Dividir cada término del numerador entre n²",
                  "latex": "\\lim_{n \\to \\infty}\\left(\\frac{3n^2}{n^2} + \\frac{5n}{n^2}\\right)"
                },
                {
                  "stepId": "simplificar",
                  "title": "Simplificar",
                  "latex": "\\lim_{n \\to \\infty}\\left(3 + \\frac{5}{n}\\right)"
                },
                {
                  "stepId": "evaluar",
                  "title": "Evaluar",
                  "latex": "3 + 0 = 3"
                }
              ]
            },
            {
              "id": "blk-demo1-paso2-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Paso 2 — Aplicar el teorema"
                }
              ]
            },
            {
              "id": "blk-demo1-paso2-text",
              "type": "paragraph",
              "content": [
                {
                  "type": "inlineMath",
                  "latex": "L = 3"
                },
                {
                  "type": "text",
                  "text": ", que es una constante positiva finita "
                },
                {
                  "type": "inlineMath",
                  "latex": "(0 < 3 < \\infty)"
                },
                {
                  "type": "text",
                  "text": ". Por el teorema, esto implica "
                },
                {
                  "type": "inlineMath",
                  "latex": "f \\in \\Theta(n^2)"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Paso 3 — Verificación con definición formal"
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-intro",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Tomamos "
                },
                {
                  "type": "inlineMath",
                  "latex": "c_1 = 3"
                },
                {
                  "type": "text",
                  "text": " y "
                },
                {
                  "type": "inlineMath",
                  "latex": "c_2 = 4"
                },
                {
                  "type": "text",
                  "text": ", y buscamos "
                },
                {
                  "type": "inlineMath",
                  "latex": "n_0"
                },
                {
                  "type": "text",
                  "text": " tal que:"
                }
              ]
            },
            {
              "id": "blk-demo1-paso3-desigualdad",
              "type": "equationBlock",
              "latex": "3n^2 \\le 3n^2 + 5n \\le 4n^2 \\quad \\text{para todo } n \\ge n_0"
            },
            {
              "id": "blk-demo1-paso3-lista",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "La desigualdad izquierda "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "3n^2 \\le 3n^2 + 5n"
                    },
                    {
                      "type": "text",
                      "text": " es siempre verdadera para "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 0"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "La desigualdad derecha "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "3n^2 + 5n \\le 4n^2"
                    },
                    {
                      "type": "text",
                      "text": " equivale a "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "5n \\le n^2"
                    },
                    {
                      "type": "text",
                      "text": ", es decir "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 5"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-demo1-resultado",
              "type": "note",
              "variant": "success",
              "title": "Conclusión",
              "blocks": [
                {
                  "id": "blk-demo1-resultado-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Tomando "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n_0 = 5"
                    },
                    {
                      "type": "text",
                      "text": ", la propiedad se cumple para todo "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge 5"
                    },
                    {
