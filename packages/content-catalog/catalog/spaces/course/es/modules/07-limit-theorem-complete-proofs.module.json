                  "type": "text",
                  "text": "Demostrar que "
                },
                {
                  "type": "inlineMath",
                  "latex": "n \\in o(n^2)"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-demo2-conv-a-heading",
              "type": "heading",
              "level": 3,
              "content": [
