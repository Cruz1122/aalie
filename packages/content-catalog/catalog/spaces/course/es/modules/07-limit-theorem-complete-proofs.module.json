                            "type": "text",
                            "text": ", "
                          },
                          {
                            "type": "inlineMath",
                            "latex": "\\Omega"
                          }
                        ]
                      ]
                    },
                    {
                      "cells": [
                        [
                          {
                            "type": "inlineMath",
                            "latex": "L = +\\infty"
                          }
                        ],
                        [
                          {
                            "type": "inlineMath",
                            "latex": "f \\in \\omega(g)"
                          },
                          {
                            "type": "text",
                            "text": " y "
                          },
                          {
                            "type": "inlineMath",
                            "latex": "f \\in \\Omega(g)"
                          }
                        ]
                      ]
                    }
                  ]
                },
                {
                  "id": "blk-teorema-convencion-b-intro",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Con Convención B ("
                    },
                    {
                      "type": "inlineMath",
                      "latex": "\\lim g/f = L'"
                    },
                    {
                      "type": "text",
                      "text": "), el mismo cuadro pero con "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "0"
                    },
                    {
                      "type": "text",
                      "text": " y "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "\\infty"
                    },
                    {
                      "type": "text",
                      "text": " intercambiados:"
                    }
                  ]
                },
                {
                  "id": "blk-teorema-convencion-b-tabla",
                  "type": "table",
                  "title": "Criterio de límites con Convención B",
                  "columns": [
                    {
                      "key": "limite",
                      "label": "Resultado del límite"
                    },
