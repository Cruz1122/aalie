                  "type": "text",
                  "text": "Convención A — Paso 1"
                }
              ]
            },
            {
              "id": "blk-demo2-conv-a-formula",
              "type": "equationBlock",
              "latex": "\\lim_{n \\to \\infty}\\frac{n}{n^2} = \\lim_{n \\to \\infty}\\frac{1}{n} = 0"
            },
            {
              "id": "blk-demo2-conv-b-heading",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "text",
                  "text": "Convención B (curso) — Paso 1"
