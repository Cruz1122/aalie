                            "latex": "0 < L < \\infty"
                          }
                        ],
                        [
                          {
                            "type": "inlineMath",
                            "latex": "f \\in \\Theta(g)"
                          },
                          {
                            "type": "text",
                            "text": " y también "
                          },
                          {
                            "type": "inlineMath",
                            "latex": "O"
                          },
                          {
                            "type": "text",
                            "text": ", "
                          },
                          {
                            "type": "inlineMath",
                            "latex": "\\Omega"
                          }
                        ]
                      ]
                    },
                    {
                      "cells": [
                        [
