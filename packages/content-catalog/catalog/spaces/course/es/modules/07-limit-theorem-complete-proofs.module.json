  "terms": [
    {
      "termId": "term-teorema-limites",
      "label": "Teorema de límites",
      "definition": "Criterio que permite decidir pertenencia a notaciones asintóticas a partir del límite del cociente entre dos funciones."
    },
    {
      "termId": "term-convencion-a",
      "label": "Convención A",
      "definition": "Convención que calcula L = lim f(n)/g(n) cuando n tiende a infinito."
    },
    {
      "termId": "term-convencion-b",
      "label": "Convención B / curso",
      "definition": "Convención del curso que calcula L' = lim g(n)/f(n) cuando n tiende a infinito."
    },
    {
      "termId": "term-limite-cero",
      "label": "Límite cero",
      "definition": "Caso donde el cociente tiende a 0; bajo Convención A indica f ∈ o(g) y f ∈ O(g)."
    },
    {
      "termId": "term-limite-constante",
      "label": "Límite constante positiva finita",
      "definition": "Caso donde el cociente tiende a una constante c con 0 < c < ∞; indica f ∈ Θ(g)."
    },
    {
      "termId": "term-limite-uno",
      "label": "Límite uno",
      "definition": "Caso donde el cociente tiende exactamente a 1; indica f ~ g."
    },
    {
      "termId": "term-limite-infinito",
      "label": "Límite infinito",
      "definition": "Caso donde el cociente tiende a +∞; bajo Convención A indica f ∈ ω(g) y f ∈ Ω(g)."
    },
    {
      "termId": "term-caso-oscilatorio",
      "label": "Caso oscilatorio",
      "definition": "Caso donde el límite no existe por oscilación; el criterio directo de límites no permite concluir automáticamente una notación."
    },
    {
      "termId": "term-verificacion-formal",
      "label": "Verificación formal",
      "definition": "Paso donde se confirma la conclusión usando la definición formal de la notación, con constantes y un n₀ apropiado."
    },
    {
      "termId": "term-n0",
      "label": "n₀",
      "definition": "Punto a partir del cual debe cumplirse una desigualdad asintótica."
    }
  ],
