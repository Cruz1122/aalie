                  "type": "text",
                  "text": "Conv. A: "
                },
                {
                  "type": "inlineMath",
                  "latex": "L = 0 \\Rightarrow f \\in o(g)"
                },
                {
                  "type": "text",
                  "text": ". Conv. B: "
                },
                {
                  "type": "inlineMath",
                  "latex": "L = \\infty \\Rightarrow f \\in o(g)"
                },
                {
                  "type": "text",
                  "text": " (criterio del curso). Ambas concluyen "
                },
                {
                  "type": "inlineMath",
                  "latex": "n \\in o(n^2)"
