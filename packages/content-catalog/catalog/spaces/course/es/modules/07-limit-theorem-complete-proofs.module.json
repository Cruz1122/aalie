              "id": "blk-demo2-paso3-formula",
              "type": "latexSteps",
              "steps": [
                {
                  "stepId": "partir",
                  "title": "Partimos de la desigualdad",
                  "latex": "n < c \\cdot n^2"
                },
                {
                  "stepId": "dividir",
                  "title": "Dividimos por n positivo",
                  "latex": "1 < c \\cdot n"
                },
                {
                  "stepId": "despejar",
                  "title": "Despejamos n",
                  "latex": "n > \\frac{1}{c}"
                }
              ]
            },
            {
              "id": "blk-demo2-resultado",
              "type": "note",
              "variant": "success",
              "title": "Conclusión",
              "blocks": [
                {
                  "id": "blk-demo2-resultado-text",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Tomando "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n_0 = \\left\\lceil \\frac{1}{c} \\right\\rceil + 1"
                    },
                    {
                      "type": "text",
                      "text": ", se cumple para todo "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "n \\ge n_0"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
