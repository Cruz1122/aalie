                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Sea "
                    },
                    {
                      "type": "inlineMath",
                      "latex": "L = \\lim_{n \\to \\infty}\\frac{f(n)}{g(n)}"
                    },
                    {
                      "type": "text",
                      "text": " (Convención A). Entonces:"
                    }
                  ]
