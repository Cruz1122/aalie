              "id": "blk-demo2-conv-b-formula",
              "type": "equationBlock",
              "latex": "\\lim_{n \\to \\infty}\\frac{n^2}{n} = \\lim_{n \\to \\infty}n = +\\infty"
            },
            {
              "id": "blk-demo2-paso2-heading",
              "type": "heading",
              "level": 3,
              "content": [
