                            "type": "inlineMath",
                            "latex": "L = 1"
                          }
                        ],
                        [
                          {
                            "type": "inlineMath",
                            "latex": "f \\sim g"
                          },
                          {
                            "type": "text",
                            "text": " y también "
                          },
                          {
                            "type": "inlineMath",
                            "latex": "\\Theta"
                          },
                          {
                            "type": "text",
                            "text": ", "
