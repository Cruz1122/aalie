            },
            {
              "id": "blk-demo2-paso3-text",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Debemos mostrar que para toda "
                },
                {
                  "type": "inlineMath",
                  "latex": "c > 0"
                },
                {
                  "type": "text",
                  "text": ", existe "
                },
                {
                  "type": "inlineMath",
                  "latex": "n_0"
                },
                {
                  "type": "text",
                  "text": " tal que "
                },
                {
                  "type": "inlineMath",
                  "latex": "n < c \\cdot n^2"
                },
                {
                  "type": "text",
                  "text": " para "
                },
                {
                  "type": "inlineMath",
                  "latex": "n \\ge n_0"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
