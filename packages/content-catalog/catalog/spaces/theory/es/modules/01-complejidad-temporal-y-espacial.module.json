  "chapters": [
    {
      "chapterId": "cap-principios-del-analisis",
      "slug": "principios-del-analisis",
      "title": "Principios del analisis",
      "order": 1,
      "summary": "Marco conceptual previo a la notacion asintotica.",
      "sections": [
        {
          "sectionId": "sec-analizar-algoritmo-no-programa",
          "slug": "analizar-algoritmo-no-programa",
          "title": "Analizar el algoritmo, no el programa",
          "order": 1,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 8,
          "searchMeta": {
            "aliases": ["algoritmo vs programa"],
            "keywords": ["constante multiplicativa", "analisis"]
          },
          "blocks": [
            {
              "id": "blk-principio-heading",
              "type": "heading",
              "level": 2,
              "content": [
                { "type": "text", "text": "Principio fundamental" }
              ]
            },
            {
              "id": "blk-principio-paragraph",
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "El objetivo es estudiar el " },
                { "type": "strong", "text": "algoritmo" },
                { "type": "text", "text": ", no una implementacion accidental. Dos programas que ejecutan la misma idea pueden diferir por constantes, pero comparten la misma estructura de crecimiento de " },
                { "type": "term", "text": "T(n)", "termRef": "term-t-de-n", "display": "tooltip" },
                { "type": "text", "text": "." }
              ]
            },
            {
              "id": "blk-principio-equation",
              "type": "equationBlock",
              "latex": "T_1(n) \\leq C \\cdot T_2(n)",
              "align": "center"
            },
            {
              "id": "blk-principio-note",
              "type": "note",
              "variant": "info",
              "title": "Idea clave",
              "blocks": [
                {
                  "id": "blk-principio-note-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "Si dos implementaciones difieren solo por detalles de bajo nivel, su comparacion asintotica no cambia." }
                  ]
                }
              ]
            },
            {
              "id": "blk-principio-quote",
              "type": "quote",
              "content": [
                { "type": "text", "text": "La abstraccion no elimina detalles por comodidad; los elimina para comparar ideas de forma estable." }
              ],
              "attribution": "Resumen pedagogico del modulo"
            }
          ]
        },
        {
          "sectionId": "sec-operacion-elemental-y-modelo-de-costo",
          "slug": "operacion-elemental-y-modelo-de-costo",
          "title": "Operacion elemental y modelo de costo",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 12,
          "prerequisites": {
            "sections": [
              { "id": "sec-analizar-algoritmo-no-programa", "kind": "required" }
            ]
          },
          "searchMeta": {
            "aliases": ["modelo de costo"],
            "keywords": ["OE", "RAM", "costo unitario"]
          },
          "blocks": [
            {
              "id": "blk-oe-definition",
              "type": "definition",
              "title": "Que cuenta como costo",
              "blocks": [
                {
                  "id": "blk-oe-definition-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "En el " },
                    { "type": "term", "text": "modelo RAM", "termRef": "term-modelo-ram", "display": "tooltip" },
                    { "type": "text", "text": ", una " },
                    { "type": "term", "text": "operacion elemental", "termRef": "term-operacion-elemental", "display": "tooltip" },
                    { "type": "text", "text": " recibe costo unitario." }
                  ]
                },
                {
                  "id": "blk-oe-definition-list",
                  "type": "list",
                  "style": "unordered",
                  "items": [
                    { "content": [{ "type": "text", "text": "Asignaciones y comparaciones simples." }] },
                    { "content": [{ "type": "text", "text": "Accesos directos a memoria abstracta." }] },
                    { "content": [{ "type": "text", "text": "Operaciones aritmeticas basicas." }] }
                  ]
                }
              ]
            },
            {
              "id": "blk-oe-cheatsheet",
              "type": "cheatsheet",
              "title": "Mini hoja de referencia",
              "items": [
                {
                  "label": "OE",
                  "value": [{ "type": "text", "text": "Unidad minima de costo." }]
                },
                {
                  "label": "T(n)",
                  "value": [{ "type": "text", "text": "Suma total de ejecuciones por costo elemental." }]
                }
              ]
            },
            {
              "id": "blk-oe-example",
              "type": "example",
              "title": "Conteo basico en un ciclo FOR",
              "blocks": [
                {
                  "id": "blk-oe-example-algorithm",
                  "type": "algorithm",
                  "language": "pseudocode",
                  "title": "Acumulador lineal",
                  "code": "suma(n) BEGIN\n    total <- 0;\n    FOR i <- 1 TO n DO BEGIN\n        total <- total + i;\n    END\n    RETURN total;\nEND"
                },
                {
                  "id": "blk-oe-example-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "Si el cuerpo ejecuta una cantidad constante de OEs por iteracion, entonces la contribucion dominante crece linealmente con n." }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "chapterId": "cap-crecimiento-asintotico",
      "slug": "crecimiento-asintotico",
      "title": "Crecimiento asintotico",
      "order": 2,
      "sections": [
        {
          "sectionId": "sec-notaciones-y-comparacion",
          "slug": "notaciones-y-comparacion",
          "title": "Notaciones y comparacion de crecimiento",
          "order": 1,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 18,
          "searchMeta": {
            "aliases": ["big o"],
            "keywords": ["O", "Theta", "dominancia", "comparacion"]
          },
          "blocks": [
            {
              "id": "blk-notacion-theorem",
              "type": "theorem",
              "title": "Dominancia eventual",
              "blocks": [
                {
                  "id": "blk-notacion-theorem-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "Si existen constantes positivas c y n_0 tales que " },
                    { "type": "inlineMath", "latex": "f(n) \\leq c g(n)" },
                    { "type": "text", "text": " para todo " },
                    { "type": "inlineMath", "latex": "n \\geq n_0" },
                    { "type": "text", "text": ", entonces " },
                    { "type": "inlineMath", "latex": "f(n) = O(g(n))" },
                    { "type": "text", "text": "." }
                  ]
                }
              ]
            },
            {
              "id": "blk-notacion-proof",
              "type": "proof",
              "title": "Lectura operacional",
              "blocks": [
                {
                  "id": "blk-notacion-proof-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "La prueba operativa consiste en exhibir una cota superior estable despues de cierto umbral." }
                  ]
                },
                {
                  "id": "blk-notacion-proof-equation",
                  "type": "equationBlock",
                  "latex": "3n + 10 \\leq 4n \\quad \\text{para } n \\geq 10",
                  "align": "center"
                }
              ]
            },
            {
              "id": "blk-notacion-table",
              "type": "table",
              "title": "Orden relativo de crecimiento",
              "columns": [
                { "key": "funcion", "label": "Funcion" },
                { "key": "comentario", "label": "Comentario" }
              ],
              "rows": [
                { "cells": [[{ "type": "inlineMath", "latex": "\\log n" }], [{ "type": "text", "text": "Crecimiento lento." }]] },
                { "cells": [[{ "type": "inlineMath", "latex": "n" }], [{ "type": "text", "text": "Lineal y frecuente en recorridos simples." }]] },
                { "cells": [[{ "type": "inlineMath", "latex": "n \\log n" }], [{ "type": "text", "text": "Comun en divide y venceras balanceado." }]] },
                { "cells": [[{ "type": "inlineMath", "latex": "n^2" }], [{ "type": "text", "text": "Tipico en bucles anidados completos." }]] },
                { "cells": [[{ "type": "inlineMath", "latex": "2^n" }], [{ "type": "text", "text": "Explosivo; aparece en busquedas exhaustivas." }]] }
              ]
            },
            {
              "id": "blk-notacion-figure",
              "type": "figure",
              "resourceRef": "fig-crecimiento-funciones",
              "display": {
                "width": "full",
                "captionPosition": "bottom"
              }
            }
          ]
        },
        {
          "sectionId": "sec-ejemplos-y-practica",
          "slug": "ejemplos-y-practica",
          "title": "Ejemplos y practica guiada",
          "order": 2,
          "kind": "practice",
          "trackProgress": true,
          "estimatedMinutes": 16,
          "prerequisites": {
            "sections": [
              { "id": "sec-notaciones-y-comparacion", "kind": "required" }
            ]
          },
          "searchMeta": {
            "aliases": ["ejercicios"],
            "keywords": ["busqueda lineal", "factorial", "practica"]
          },
          "blocks": [
            {
              "id": "blk-practica-example",
              "type": "example",
              "title": "Busqueda lineal",
              "blocks": [
                {
                  "id": "blk-practica-example-algorithm",
                  "type": "algorithm",
                  "language": "pseudocode",
                  "title": "Busqueda lineal canonica",
                  "code": "busquedaLineal(A[n], x, n) BEGIN\n    FOR i <- 1 TO n DO BEGIN\n        IF (A[i] = x) THEN BEGIN\n            RETURN i;\n        END\n    END\n    RETURN -1;\nEND",
                  "caption": "Cada iteracion revisa un elemento hasta encontrarlo o agotar el arreglo."
                },
                {
                  "id": "blk-practica-example-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "En peor caso inspecciona todos los elementos, por lo que su costo dominante es lineal." }
                  ]
                }
              ]
            },
            {
              "id": "blk-practica-exercise",
              "type": "exercise",
              "title": "Justificar factorial iterativo",
              "prompt": [
                { "type": "text", "text": "Explica por que el factorial iterativo tiene costo " },
                { "type": "inlineMath", "latex": "\\Theta(n)" },
                { "type": "text", "text": " bajo el modelo RAM." }
              ],
              "difficulty": "intermediate",
              "solutionRef": "blk-practica-solution"
            },
            {
              "id": "blk-practica-solution",
              "type": "exerciseSolution",
              "title": "Solucion propuesta",
              "blocks": [
                {
                  "id": "blk-practica-solution-paragraph",
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "La inicializacion cuesta constante y el ciclo ejecuta una cantidad constante de OEs en cada iteracion desde 2 hasta n." }
                  ]
                },
                {
                  "id": "blk-practica-solution-equation",
                  "type": "equationBlock",
                  "latex": "T(n) = c_0 + c_1 (n - 1) = \\Theta(n)",
                  "align": "center"
                }
              ]
            },
            {
              "id": "blk-practica-reference-list",
              "type": "referenceList",
              "references": ["ref-clrs", "ref-knuth"]
            },
            {
              "id": "blk-practica-buttons",
              "type": "buttonRow",
              "buttons": [
                {
                  "label": "Abrir ejemplos",
                  "target": { "kind": "external", "ref": "/examples" },
                  "variant": "primary"
                },
                {
                  "label": "Volver a notaciones",
                  "target": { "kind": "section", "ref": "sec-notaciones-y-comparacion" },
                  "variant": "secondary"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
