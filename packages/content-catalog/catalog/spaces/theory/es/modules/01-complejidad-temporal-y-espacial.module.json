      "termId": "term-operacion-elemental",
      "label": "Operacion elemental",
      "aliases": ["OE"],
      "definition": "Operacion cuyo costo se cuenta como una unidad dentro del modelo de costo adoptado."
    },
    {
      "termId": "term-modelo-ram",
      "label": "Modelo RAM",
      "aliases": ["RAM"],
