    {
      "objectiveId": "obj-arbol",
      "text": "Abrir la vista de árbol de llamadas en el analizador y relacionar profundidad con el ejemplo recursivo analizado."
    }
  ],
  "terms": [
    {
      "termId": "term-llamada-recursiva",
      "label": "llamada recursiva",
      "aliases": [],
      "definition": "Invocación de un procedimiento desde el propio cuerpo de ese procedimiento. Cada llamada nueva suele acercarse a un caso más pequeño hasta llegar a un caso base."
    },
    {
      "termId": "term-recurrencia",
      "label": "recurrencia",
      "aliases": [],
      "definition": "Ecuación que expresa el costo T(n) en función de costos en tamaños menores (por ejemplo T(n/2)). El curso enseña a resolverla; aquí usas la interfaz para visualizar llamadas."
    },
    {
      "termId": "term-caso-base",
      "label": "caso base",
      "aliases": [],
      "definition": "Situación en la que la recursión se detiene sin nuevas llamadas (por ejemplo factorial de 0 o 1)."
    }
  ],
