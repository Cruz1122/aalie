              "id": "blk-examples-search-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Búsqueda lineal",
              "code": "busquedaLineal(A[n], x, n) BEGIN\n  FOR i <- 1 TO n DO BEGIN\n    IF (A[i] = x) THEN BEGIN\n      RETURN i;\n    END\n  END\n  RETURN -1;\nEND"
            },
