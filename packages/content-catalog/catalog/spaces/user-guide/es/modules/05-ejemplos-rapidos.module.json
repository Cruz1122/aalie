              "id": "blk-examples-factorial-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Factorial iterativo",
              "code": "factorial(n) BEGIN\n  resultado <- 1;\n  FOR i <- 2 TO n DO BEGIN\n    resultado <- resultado * i;\n  END\n  RETURN resultado;\nEND"
            },
            {
              "id": "blk-examples-factorial-note",
              "type": "note",
              "variant": "info",
              "title": "Qué mirar",
