          "blocks": [
            {
              "id": "blk-editor-basic-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "term",
                  "text": "Monaco Editor",
                  "termRef": "term-monaco-editor",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " concentra escritura, resaltado, autocompletado y acciones de análisis en una sola superficie."
                }
              ]
            },
            {
              "id": "blk-editor-basic-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Autocompletado contextual con prioridad para variables locales, parámetros y snippets cortos."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Numeración de líneas, indentación, búsqueda y reemplazo en el mismo panel."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Importación de texto y edición previa antes de ejecutar el análisis de complejidad."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-editor-basic-note",
              "type": "note",
              "variant": "success",
              "title": "Flujo recomendado",
              "blocks": [
                {
                  "id": "blk-editor-basic-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Primero corrige el parseo visible, luego ejecuta el análisis y solo después abre trace, export o comparación LLM si de verdad lo necesitas."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-validacion-en-tiempo-real",
          "slug": "validacion-en-tiempo-real",
          "title": "Validación en tiempo real",
          "order": 2,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "diagnosticos"
            ],
            "keywords": [
              "unexpected token",
              "parseo",
              "warning"
            ]
          },
          "prerequisites": {
            "sections": [
              {
                "id": "sec-funciones-basicas",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-editor-validation-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Antes del análisis formal, la UI muestra "
                },
                {
                  "type": "term",
                  "text": "diagnósticos",
                  "termRef": "term-diagnostics",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " de parseo y advertencias del editor para que ajustes el código sobre la marcha."
                }
              ]
            },
            {
              "id": "blk-editor-validation-list",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Los errores sintácticos bloquean conclusiones fuertes hasta que el parseo sea válido."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Las advertencias ayudan a detectar bloques incompletos, delimitadores mal cerrados o estructuras sospechosas."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "La reparación con IA es opcional y depende de API key; no sustituye la gramática real del proyecto."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-editor-validation-note",
              "type": "note",
              "variant": "warning",
              "title": "Qué no debes asumir",
              "blocks": [
                {
                  "id": "blk-editor-validation-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Un código que parsea correctamente no garantiza que todas las heurísticas posteriores produzcan una conclusión fuerte; esto importa especialmente en "
                    },
                    {
                      "type": "inlineCode",
                      "text": "WHILE"
                    },
                    {
                      "type": "text",
                      "text": " y en algunos artefactos auxiliares."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-atajos-de-teclado",
          "slug": "atajos-de-teclado",
          "title": "Atajos de teclado",
          "order": 3,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "shortcuts"
            ],
            "keywords": [
              "ctrl+s",
              "ctrl+f",
              "ctrl+h",
              "tab"
            ]
          },
          "blocks": [
            {
              "id": "blk-editor-shortcuts-table",
              "type": "table",
              "title": "Atajos visibles",
              "columns": [
                {
                  "key": "shortcut",
                  "label": "Atajo"
                },
                {
                  "key": "action",
                  "label": "Acción"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Ctrl+S"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Analizar o guardar cambios según la superficie activa."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Ctrl+F"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Buscar dentro del documento actual."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Ctrl+H"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Reemplazar coincidencias visibles."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Ctrl+/"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Comentar o descomentar líneas seleccionadas."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Tab"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Indentar el bloque activo."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "inlineCode",
                        "text": "Shift+Tab"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Quitar indentación."
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-editor-shortcuts-cheat",
              "type": "cheatsheet",
              "title": "Reglas rápidas",
              "items": [
                {
                  "label": "Buscar",
                  "value": [
                    {
                      "type": "text",
                      "text": "Funciona dentro del documento cargado; no reemplaza la búsqueda estructurada de la guía."
                    }
                  ]
                },
                {
                  "label": "Guardar",
                  "value": [
                    {
                      "type": "text",
                      "text": "Úsalo como gesto operativo; la acción exacta depende de la vista actual."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
