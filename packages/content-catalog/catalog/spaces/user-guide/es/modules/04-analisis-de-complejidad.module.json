      "AST",
      "classify",
      "byLine",
      "T_open",
      "loop invariant"
    ]
  },
  "prerequisites": {
    "modules": [
      {
        "id": "mod-user-guide-grammar",
        "kind": "required"
      }
    ]
  },
  "relatedModuleIds": [
    "mod-user-guide-grammar",
    "mod-user-guide-examples",
    "mod-user-guide-troubleshooting"
  ],
  "learningObjectives": [
    {
      "objectiveId": "obj-pipeline",
      "text": "Explicar el pipeline real del motor sin vender UX idealizada."
    },
    {
      "objectiveId": "obj-leer-resultados",
      "text": "Interpretar byLine, T_open, T_polynomial y notaciones con claridad contractual."
    }
  ],
  "terms": [
    {
      "termId": "term-by-line",
      "label": "byLine",
      "aliases": [
        "costos por línea"
      ],
      "definition": "Tabla contractual que reporta costo elemental, número de ejecuciones y costo total por línea."
    },
    {
      "termId": "term-t-open",
      "label": "T_open",
      "aliases": [
        "ecuación abierta"
      ],
      "definition": "Expresión simbólica abierta de costo antes del cierre algebraico final."
    },
    {
      "termId": "term-t-polynomial",
      "label": "T_polynomial",
      "aliases": [
        "forma simplificada"
      ],
      "definition": "Mejor forma simplificada defendible derivada de T_open cuando el motor puede publicarla sin inventar pasos."
    },
    {
      "termId": "term-loop-invariant",
      "label": "loopInvariant",
      "aliases": [
        "invariante de ciclo"
      ],
      "definition": "Artefacto pedagógico auxiliar asociado al ciclo principal; no gobierna la complejidad calculada."
    },
    {
      "termId": "term-structured-trace",
      "label": "structuredTrace",
      "aliases": [
        "trace estructurado"
      ],
      "definition": "Artefacto derivado contractual para diagramas que debe ser coherente con el trace base."
    }
  ],
  "chapters": [
    {
      "chapterId": "cap-flujo-del-motor",
      "slug": "flujo-del-motor",
      "title": "Flujo del motor",
      "order": 1,
      "summary": "Cómo entra el código y qué devuelve el servicio principal.",
      "sections": [
        {
          "sectionId": "sec-flujo-desde-el-editor",
          "slug": "flujo-desde-el-editor",
          "title": "Flujo desde el editor",
          "order": 1,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "analizar complejidad"
            ],
            "keywords": [
              "editor",
              "parse",
              "classify",
              "analyzer"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-editor-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El flujo contractual del motor es "
                },
                {
                  "type": "inlineCode",
                  "text": "AST -> classify -> analyzer -> byLine/totals -> T_open -> T_polynomial -> notaciones"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-analysis-editor-list",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Primero debe existir parseo válido; sin AST no hay análisis formal defendible."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "La clasificación decide si el camino operativo es iterativo, recursivo o híbrido."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "El resultado principal vive en byLine y totals; los demás artefactos acompañan, pero no sustituyen, esa salida."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-editor-note",
              "type": "note",
              "variant": "warning",
              "title": "Precondición real",
              "blocks": [
                {
                  "id": "blk-analysis-editor-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Si el parseo falla, cualquier ayuda posterior es orientativa. La fuente de verdad del análisis formal empieza después del AST."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-analisis-desde-aalie",
          "slug": "analisis-desde-aalie",
          "title": "Análisis desde AALIE",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "chat de aalie"
            ],
            "keywords": [
              "bloque de pseudocodigo",
              "assistant"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-aalie-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Cuando el asistente recibe un bloque de pseudocódigo o contexto de la vista actual, puede guiar el flujo y explicar resultados; aun así, el análisis formal publicado por la app sigue siendo la fuente de verdad."
                }
              ]
            },
            {
              "id": "blk-analysis-aalie-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Úsalo para orientación, explicación de pasos y próximos movimientos operativos."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "No lo uses como sustituto de byLine, T_open o las notaciones visibles de la app."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Si falta análisis formal completo, la respuesta del asistente debe leerse como apoyo contextual, no como veredicto matemático final."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-aalie-note",
              "type": "note",
              "variant": "success",
              "title": "Buen uso",
              "blocks": [
                {
                  "id": "blk-analysis-aalie-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AALIE aporta más valor cuando ya tienes una vista concreta abierta y quieres entender qué significa o qué revisar después."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-interpretacion-de-resultados",
          "slug": "interpretacion-de-resultados",
          "title": "Interpretación de resultados",
          "order": 3,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "searchMeta": {
            "aliases": [
              "leer resultados"
            ],
            "keywords": [
              "byLine",
              "T_open",
              "T_polynomial",
              "big o"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-results-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "term",
                  "text": "byLine",
                  "termRef": "term-by-line",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " muestra costo elemental, número de ejecuciones y costo total por línea. Luego "
                },
                {
                  "type": "term",
                  "text": "T_open",
                  "termRef": "term-t-open",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " preserva la estructura simbólica antes de cualquier cierre defendible."
                }
              ]
            },
            {
              "id": "blk-analysis-results-table",
              "type": "table",
              "title": "Lectura mínima del resultado",
              "columns": [
                {
                  "key": "artifact",
                  "label": "Artefacto"
                },
                {
                  "key": "question",
                  "label": "Qué responde"
                }
              ],
              "rows": [
                {
                  "cells": [
                    [
                      {
                        "type": "term",
                        "text": "byLine",
                        "termRef": "term-by-line",
                        "display": "tooltip"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Qué cuesta cada línea y cuántas veces se ejecuta."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "term",
                        "text": "T_open",
                        "termRef": "term-t-open",
                        "display": "tooltip"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Cuál es la ecuación de costo abierta antes del cierre algebraico."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "term",
                        "text": "T_polynomial",
                        "termRef": "term-t-polynomial",
                        "display": "tooltip"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Cuál es la mejor forma simplificada defendible que el motor pudo derivar."
                      }
                    ]
                  ]
                },
                {
                  "cells": [
                    [
                      {
                        "type": "text",
                        "text": "Big-O / Big-Ω / Big-Θ"
                      }
                    ],
                    [
                      {
                        "type": "text",
                        "text": "Qué lectura asintótica publica la app para el caso seleccionado."
                      }
                    ]
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-results-equation",
              "type": "equationBlock",
              "latex": "T_{open}(n)=\\sum_{k=1}^{m} C_k \\cdot e_k(n)",
              "align": "center"
            },
            {
              "id": "blk-analysis-results-definition",
              "type": "definition",
              "title": "Regla contractual",
              "blocks": [
                {
                  "id": "blk-analysis-results-definition-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "term",
                      "text": "T_polynomial",
                      "termRef": "term-t-polynomial",
                      "display": "tooltip"
                    },
                    {
                      "type": "text",
                      "text": " solo puede derivarse de "
                    },
                    {
                      "type": "term",
                      "text": "T_open",
                      "termRef": "term-t-open",
                      "display": "tooltip"
                    },
                    {
                      "type": "text",
                      "text": " mediante transformaciones simbólicas defendibles; no por recomputación independiente del algoritmo."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-results-note",
              "type": "note",
              "variant": "warning",
              "title": "Estados parciales existen",
              "blocks": [
                {
                  "id": "blk-analysis-results-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "El motor puede publicar estados parciales o artefactos auxiliares ausentes sin inventar conclusiones. Eso es comportamiento esperado, no una falla del contrato."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "chapterId": "cap-artefactos-auxiliares",
      "slug": "artefactos-auxiliares",
      "title": "Artefactos auxiliares y límites",
      "order": 2,
      "summary": "Comparación LLM, panel GPU vs CPU y trace estructurado.",
      "sections": [
        {
          "sectionId": "sec-comparacion-llm",
          "slug": "comparacion-llm",
          "title": "Comparación con LLM",
          "order": 1,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "llm comparison"
            ],
            "keywords": [
              "comparar con llm",
              "cross-check"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-llm-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La comparación con LLM es una superficie opcional para contraste rápido. Nunca reemplaza la salida formal visible del motor."
                }
              ]
            },
            {
              "id": "blk-analysis-llm-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Sirve para detectar discrepancias, lenguaje ambiguo o supuestos implícitos que conviene revisar."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "No prueba corrección matemática por sí sola."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Si el análisis formal falta o es parcial, el contraste con LLM también debe leerse con cautela."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-llm-note",
              "type": "note",
              "variant": "info",
              "title": "Lectura correcta",
              "blocks": [
                {
                  "id": "blk-analysis-llm-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Úsalo como segunda opinión complementaria, no como árbitro de la complejidad publicada por la app."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-gpu-vs-cpu",
          "slug": "gpu-vs-cpu",
          "title": "GPU vs CPU",
          "order": 2,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 2,
          "searchMeta": {
            "aliases": [
              "gpu cpu"
            ],
            "keywords": [
              "heuristica",
              "paralelismo",
              "ramificacion"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-gpu-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El panel GPU vs CPU es auxiliar. Resume rasgos estructurales del algoritmo para sugerir si una ejecución paralela podría ser favorable."
                }
              ]
            },
            {
              "id": "blk-analysis-gpu-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Profundidad recursiva y forma del árbol de llamadas."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Ramificación, independencia aparente entre operaciones y presencia de bucles masivos."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Accesos a arrays y carga de operaciones que podrían beneficiarse de paralelismo."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-gpu-note",
              "type": "note",
              "variant": "warning",
              "title": "No promete speedup",
              "blocks": [
                {
                  "id": "blk-analysis-gpu-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "La recomendación visible no sustituye benchmarking ni modela hardware real. Es una heurística de lectura, no una garantía contractual de rendimiento."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-trace-y-loop-invariant",
          "slug": "trace-y-loop-invariant",
          "title": "Trace y loop invariant",
          "order": 3,
          "kind": "theory",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "trace"
            ],
            "keywords": [
              "structuredTrace",
              "loopInvariant",
              "callTreeSource"
            ]
          },
          "blocks": [
            {
              "id": "blk-analysis-trace-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "El trace de ejecución muestra pasos instrumentados y puede adjuntar "
                },
                {
                  "type": "term",
                  "text": "structuredTrace",
                  "termRef": "term-structured-trace",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " para diagramas. El "
                },
                {
                  "type": "term",
                  "text": "loopInvariant",
                  "termRef": "term-loop-invariant",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " es un artefacto pedagógico auxiliar asociado al ciclo principal."
                }
              ]
            },
            {
              "id": "blk-analysis-trace-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "En iterativos, el trace explica mutaciones de estado, condiciones y salida final."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "En recursivos, puede incluir callTreeSource y una clasificación estructural derivada."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Si structuredTrace no puede derivarse, el trace base sigue siendo válido."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "loopInvariant no altera la complejidad calculada; acompaña el análisis, no lo gobierna."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-analysis-trace-code",
              "type": "code",
              "language": "json",
              "title": "Shape mínimo derivado",
              "code": "{\n  \"derived\": {\n    \"structuredTrace\": {\n      \"patternKind\": \"unknown\",\n      \"graph\": [],\n      \"classification\": \"degraded\"\n    }\n  }\n}"
            },
            {
              "id": "blk-analysis-trace-note",
              "type": "note",
              "variant": "info",
              "title": "Degradación correcta",
              "blocks": [
                {
                  "id": "blk-analysis-trace-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Si algún artefacto auxiliar no puede derivarse, la UI debe degradar visualmente sin reinterpretar pasos ni contradecir el trace base."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
