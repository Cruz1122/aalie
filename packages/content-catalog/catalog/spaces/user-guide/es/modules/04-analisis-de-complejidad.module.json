  "moduleId": "mod-user-guide-analysis",
  "slug": "analisis-de-complejidad",
  "title": "Análisis de complejidad",
  "shortTitle": "Análisis",
  "order": 4,
  "locale": "es",
  "version": "1.0.0",
  "status": "published",
  "summary": "Explica cómo leer los resultados del análisis, qué significan las fórmulas y cómo interpretar cada panel sin necesitar base previa.",
  "difficulty": "intermediate",
  "estimatedMinutes": 20,
  "tags": [
    "analisis",
    "T_open",
    "byLine",
    "trace",
    "llm"
  ],
  "searchMeta": {
