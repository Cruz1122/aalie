              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La sintaxis visible recomendada para "
                },
                {
                  "type": "term",
                  "text": "asignación",
                  "termRef": "term-assignment",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " es "
                },
                {
                  "type": "inlineCode",
                  "text": "<-"
                },
                {
                  "type": "text",
                  "text": " y los comentarios visibles usan "
                },
                {
                  "type": "inlineCode",
                  "text": "//"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-grammar-assign-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Asignación recomendada",
              "code": "suma <- a + b;\nesValido <- (x >= 0) AND (x != 10);\n// comentario visible\ncontador <- contador + 1;"
            },
            {
              "id": "blk-grammar-assign-note",
              "type": "note",
              "variant": "warning",
              "title": "Compatibilidad no es pedagogía",
              "blocks": [
                {
                  "id": "blk-grammar-assign-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Alias Unicode y operadores legacy pueden existir a nivel de parseo, pero no deben aparecer como sintaxis principal en snippets, ayudas o microcopy de la guía."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
