          "blocks": [
            {
              "id": "blk-grammar-control-heading-if",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "inlineCode",
                  "text": "IF / ELSE"
                }
              ]
            },
            {
              "id": "blk-grammar-control-if",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Selección",
              "code": "IF (x > 0) THEN BEGIN\n  PRINT(\"positivo\");\nEND\nELSE BEGIN\n  PRINT(\"no positivo\");\nEND"
            },
            {
              "id": "blk-grammar-control-heading-loops",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "inlineCode",
                  "text": "FOR / WHILE / REPEAT"
                }
              ]
            },
            {
              "id": "blk-grammar-control-loops",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Bucles",
              "code": "FOR i <- 1 TO n DO BEGIN\n  PRINT(i);\nEND\n\nWHILE (i <= n) DO BEGIN\n  i <- i + 1;\nEND\n\nREPEAT\n  i <- i - 1;\nUNTIL (i = 0);"
            },
            {
              "id": "blk-grammar-control-note",
              "type": "note",
              "variant": "warning",
              "title": "Invariante sintáctico",
              "blocks": [
                {
                  "id": "blk-grammar-control-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Toda estructura de control usa bloque completo. No existe sintaxis por indentación ni "
                    },
                    {
                      "type": "inlineCode",
                      "text": "for-each"
                    },
                    {
                      "type": "text",
                      "text": " en la gramática visible actual."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
