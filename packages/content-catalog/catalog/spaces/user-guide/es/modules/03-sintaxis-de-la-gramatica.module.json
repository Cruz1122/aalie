      "sections": [
        {
          "sectionId": "sec-procedimientos-y-call",
          "slug": "procedimientos-y-call",
          "title": "Procedimientos y CALL",
          "order": 1,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "procedimientos"
            ],
            "keywords": [
              "CALL",
              "BEGIN",
              "END",
              "return"
            ]
          },
          "blocks": [
            {
              "id": "blk-grammar-proc-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "La forma visible del producto usa procedimientos con bloque completo y llamadas sentenciales mediante "
                },
                {
                  "type": "term",
                  "text": "CALL",
                  "termRef": "term-call-stmt",
                  "display": "highlight"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-grammar-proc-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Estructura básica",
              "code": "procesar(A[n], n) BEGIN\n  total <- 0;\n  FOR i <- 1 TO n DO BEGIN\n    total <- total + A[i];\n  END\n  RETURN total;\nEND"
            },
            {
              "id": "blk-grammar-proc-call",
              "type": "code",
              "language": "text",
              "title": "Llamada sentencial vs expresión",
              "code": "CALL procesar(A, n);\nresultado <- procesar(A, n);",
              "caption": "Usa CALL solo cuando la llamada es una sentencia completa."
            },
            {
              "id": "blk-grammar-proc-note",
              "type": "note",
              "variant": "info",
              "title": "Convención visible",
              "blocks": [
                {
                  "id": "blk-grammar-proc-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "La UI enseña una sola sintaxis visible en ASCII. Si el parser acepta variantes legacy, eso no las convierte en forma pedagógica recomendada."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
