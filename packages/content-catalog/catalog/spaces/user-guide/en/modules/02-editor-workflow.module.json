                "id": "sec-funciones-basicas",
                "kind": "required"
              }
            ]
          },
          "blocks": [
            {
              "id": "blk-editor-validation-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Before formal analysis, the UI shows parse "
                },
                {
                  "type": "term",
                  "text": "diagnostics",
                  "termRef": "term-diagnostics",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " and editor warnings so you can correct the code while you write."
                }
              ]
            },
            {
              "id": "blk-editor-validation-list",
              "type": "list",
              "style": "ordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Syntax errors block strong formal conclusions until parsing is valid."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Warnings help detect incomplete blocks, mismatched delimiters, or suspicious structures."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "AI repair is optional and API-key dependent; it does not replace the project’s real grammar."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-editor-validation-note",
              "type": "note",
              "variant": "warning",
              "title": "What not to assume",
              "blocks": [
                {
                  "id": "blk-editor-validation-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A program that parses successfully does not guarantee that every later heuristic will produce a strong conclusion; this matters especially for "
                    },
                    {
                      "type": "inlineCode",
                      "text": "WHILE"
                    },
                    {
                      "type": "text",
                      "text": " and some auxiliary artifacts."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
