              "title": "Quick rules",
              "items": [
                {
                  "label": "Search",
                  "value": [
                    {
                      "type": "text",
                      "text": "It works inside the loaded document; it does not replace the guide’s structured search."
                    }
                  ]
                },
                {
                  "label": "Save",
                  "value": [
