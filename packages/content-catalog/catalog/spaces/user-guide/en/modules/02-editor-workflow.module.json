          "blocks": [
            {
              "id": "blk-editor-basic-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "term",
                  "text": "Monaco Editor",
                  "termRef": "term-monaco-editor",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " keeps writing, highlighting, autocomplete, and analysis actions in the same surface."
                }
              ]
            },
            {
              "id": "blk-editor-basic-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Context-aware autocomplete that prioritizes local variables, parameters, and short snippets."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Line numbers, indentation, search, and replace in the same panel."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "text",
                      "text": "Text import and editing before running complexity analysis."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-editor-basic-note",
              "type": "note",
              "variant": "success",
              "title": "Recommended workflow",
              "blocks": [
                {
                  "id": "blk-editor-basic-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Fix visible parse issues first, then run the analysis, and only after that open trace, export, or LLM comparison if they truly help."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-validacion-en-tiempo-real",
          "slug": "real-time-validation",
          "title": "Real-time validation",
          "order": 2,
          "kind": "overview",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "diagnostics"
            ],
            "keywords": [
              "unexpected token",
              "parse",
              "warning"
            ]
          },
          "prerequisites": {
