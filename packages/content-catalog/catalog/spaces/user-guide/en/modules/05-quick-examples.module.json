              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This snippet compresses assignment, "
                },
                {
                  "type": "inlineCode",
                  "text": "FOR"
                },
                {
                  "type": "text",
                  "text": ", and "
                },
                {
                  "type": "inlineCode",
                  "text": "RETURN"
                },
                {
                  "type": "text",
                  "text": " into a small, verifiable form."
                }
              ]
            },
            {
              "id": "blk-examples-factorial-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Iterative factorial",
              "code": "factorial(n) BEGIN\n  result <- 1;\n  FOR i <- 2 TO n DO BEGIN\n    result <- result * i;\n  END\n  RETURN result;\nEND"
            },
            {
              "id": "blk-examples-factorial-note",
              "type": "note",
              "variant": "info",
              "title": "What to inspect",
              "blocks": [
                {
                  "id": "blk-examples-factorial-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Use it to verify the visible loop form and later compare it with per-line cost reading."
                    }
                  ]
                }
              ]
            }
          ]
        },
