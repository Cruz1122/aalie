                  "type": "text",
                  "text": "Linear search is a compact way to discuss best, worst, and average behavior on a simple iterative structure."
                }
              ]
            },
            {
              "id": "blk-examples-search-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Linear search",
              "code": "linearSearch(A[n], x, n) BEGIN\n  FOR i <- 1 TO n DO BEGIN\n    IF (A[i] = x) THEN BEGIN\n      RETURN i;\n    END\n  END\n  RETURN -1;\nEND"
            },
            {
              "id": "blk-examples-search-note",
              "type": "note",
              "variant": "success",
              "title": "Useful reading",
              "blocks": [
