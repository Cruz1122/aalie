            "keywords": [
              "IF",
              "FOR",
              "WHILE",
              "REPEAT"
            ]
          },
          "blocks": [
            {
              "id": "blk-grammar-control-heading-if",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "inlineCode",
                  "text": "IF / ELSE"
                }
              ]
            },
            {
              "id": "blk-grammar-control-if",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Selection",
              "code": "IF (x > 0) THEN BEGIN\n  PRINT(\"positive\");\nEND\nELSE BEGIN\n  PRINT(\"not positive\");\nEND"
            },
            {
              "id": "blk-grammar-control-heading-loops",
              "type": "heading",
              "level": 3,
              "content": [
                {
                  "type": "inlineCode",
                  "text": "FOR / WHILE / REPEAT"
                }
              ]
            },
            {
              "id": "blk-grammar-control-loops",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Loops",
              "code": "FOR i <- 1 TO n DO BEGIN\n  PRINT(i);\nEND\n\nWHILE (i <= n) DO BEGIN\n  i <- i + 1;\nEND\n\nREPEAT\n  i <- i - 1;\nUNTIL (i = 0);"
            },
            {
              "id": "blk-grammar-control-note",
              "type": "note",
              "variant": "warning",
              "title": "Syntactic invariant",
              "blocks": [
                {
                  "id": "blk-grammar-control-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Every control structure uses a full block. There is no indentation-only syntax and no "
                    },
                    {
                      "type": "inlineCode",
                      "text": "for-each"
                    },
                    {
                      "type": "text",
                      "text": " in the current visible grammar."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
