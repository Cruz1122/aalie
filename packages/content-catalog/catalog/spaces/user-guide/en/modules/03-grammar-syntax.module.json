      "summary": "Procedures, assignment, and control flow.",
      "sections": [
        {
          "sectionId": "sec-procedimientos-y-call",
          "slug": "procedures-and-call",
          "title": "Procedures and CALL",
          "order": 1,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 4,
          "searchMeta": {
            "aliases": [
              "procedures"
            ],
            "keywords": [
              "CALL",
              "BEGIN",
              "END",
              "return"
            ]
          },
          "blocks": [
            {
              "id": "blk-grammar-proc-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The product’s visible form uses procedures with full blocks and sentential calls through "
                },
                {
                  "type": "term",
                  "text": "CALL",
                  "termRef": "term-call-stmt",
                  "display": "highlight"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-grammar-proc-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Basic structure",
              "code": "process(A[n], n) BEGIN\n  total <- 0;\n  FOR i <- 1 TO n DO BEGIN\n    total <- total + A[i];\n  END\n  RETURN total;\nEND"
            },
            {
              "id": "blk-grammar-proc-call",
              "type": "code",
              "language": "text",
              "title": "Sentential call vs expression",
              "code": "CALL process(A, n);\nresult <- process(A, n);",
              "caption": "Use CALL only when the call is a full statement."
            },
            {
              "id": "blk-grammar-proc-note",
              "type": "note",
              "variant": "info",
              "title": "Visible convention",
              "blocks": [
                {
                  "id": "blk-grammar-proc-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The UI teaches a single visible ASCII syntax. If the parser accepts legacy variants, that does not make them the pedagogical default."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-variables-y-asignacion",
          "slug": "variables-and-assignment",
          "title": "Variables and assignment",
          "order": 2,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "assignment"
            ],
