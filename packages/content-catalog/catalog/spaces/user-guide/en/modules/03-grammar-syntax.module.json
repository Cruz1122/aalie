          "blocks": [
            {
              "id": "blk-grammar-assign-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The recommended visible syntax for "
                },
                {
                  "type": "term",
                  "text": "assignment",
                  "termRef": "term-assignment",
                  "display": "tooltip"
                },
                {
                  "type": "text",
                  "text": " is "
                },
                {
                  "type": "inlineCode",
                  "text": "<-"
                },
                {
                  "type": "text",
                  "text": ", and visible comments use "
                },
                {
                  "type": "inlineCode",
                  "text": "//"
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "id": "blk-grammar-assign-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Recommended assignment",
              "code": "sum <- a + b;\nisValid <- (x >= 0) AND (x != 10);\n// visible comment\ncounter <- counter + 1;"
            },
            {
              "id": "blk-grammar-assign-note",
              "type": "note",
              "variant": "warning",
              "title": "Compatibility is not pedagogy",
              "blocks": [
                {
                  "id": "blk-grammar-assign-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Unicode aliases and legacy operators may exist at parse level, but they should not appear as primary syntax in snippets, helpers, or guide microcopy."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-estructuras-de-control",
          "slug": "control-structures",
          "title": "Control structures",
          "order": 3,
          "kind": "reference",
          "trackProgress": true,
          "estimatedMinutes": 5,
          "searchMeta": {
            "aliases": [
              "if for while repeat"
