            {
              "id": "blk-m08-s03-p01",
              "type": "paragraph",
              "content": [
                {
              "type": "text",
              "text": "Course-linked "
            },
            {
              "type": "link",
              "text": "quizzes",
              "target": { "kind": "external", "ref": "/quizzes" }
            },
            {
              "type": "text",
              "text": " become available when the required progress threshold is reached. In this flow, a course completed at 100% can already show its quiz, while another below 90% remains locked."
                }
              ]
            },
