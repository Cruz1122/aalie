  "chapters": [
    {
      "chapterId": "cap-errores-frecuentes",
      "slug": "common-errors",
      "title": "Common errors",
      "order": 1,
      "sections": [
        {
          "sectionId": "sec-unexpected-token",
          "slug": "unexpected-token",
          "title": "unexpected token",
          "order": 1,
          "kind": "troubleshooting",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "unexpected token"
            ],
            "keywords": [
              "unexpected token",
              "parse error"
            ]
          },
          "blocks": [
            {
              "id": "blk-trouble-token-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This error usually means the input does not match the product’s visible grammar at that exact point."
                }
              ]
            },
            {
              "id": "blk-trouble-token-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Cause: "
                    },
                    {
                      "type": "text",
                      "text": "keywords outside the visible form, unbalanced delimiters, or a structure the grammar does not support."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Fix: "
                    },
                    {
                      "type": "text",
                      "text": "review parentheses, brackets, blocks, and return to the official ASCII syntax before trying AI repair."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-trouble-token-note",
              "type": "note",
              "variant": "danger",
              "title": "Fast check",
              "blocks": [
                {
                  "id": "blk-trouble-token-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Before assuming a parser bug, confirm "
                    },
                    {
                      "type": "inlineCode",
                      "text": "BEGIN/END"
                    },
                    {
                      "type": "text",
                      "text": ", "
                    },
                    {
                      "type": "inlineCode",
                      "text": "CALL"
                    },
                    {
                      "type": "text",
                      "text": ", and the visible form of comments and assignment."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-missing-begin-o-end",
          "slug": "missing-begin-or-end",
          "title": "missing BEGIN or END",
          "order": 2,
          "kind": "troubleshooting",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "incomplete block"
            ],
            "keywords": [
              "BEGIN",
              "END"
            ]
          },
          "blocks": [
            {
              "id": "blk-trouble-begin-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Control structures and procedures use full blocks. If "
                },
                {
                  "type": "inlineCode",
                  "text": "BEGIN"
                },
                {
                  "type": "text",
                  "text": " or "
                },
                {
                  "type": "inlineCode",
                  "text": "END"
                },
                {
                  "type": "text",
                  "text": " is missing, parsing often breaks downstream."
                }
              ]
            },
            {
              "id": "blk-trouble-begin-code",
              "type": "algorithm",
              "language": "pseudocode",
              "title": "Valid form",
              "code": "IF (condition) THEN BEGIN\n  PRINT(\"ok\");\nEND"
            },
            {
              "id": "blk-trouble-begin-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Cause: "
                    },
                    {
                      "type": "text",
                      "text": "copying an incomplete structure or trying to write indentation-style pseudocode."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Fix: "
                    },
                    {
                      "type": "text",
                      "text": "close every block as soon as you open it and validate again before continuing."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-missing-semicolon",
          "slug": "missing-semicolon",
          "title": "missing semicolon",
          "order": 3,
          "kind": "troubleshooting",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "semicolon"
            ],
            "keywords": [
              "missing semicolon",
              ";"
            ]
          },
          "blocks": [
            {
              "id": "blk-trouble-semicolon-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "When a "
                },
                {
                  "type": "inlineCode",
                  "text": ";"
                },
                {
                  "type": "text",
                  "text": " is missing in an assignment or another relevant statement, the parser may report the problem on the current line or the next one."
                }
              ]
            },
            {
              "id": "blk-trouble-semicolon-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Cause: "
                    },
                    {
                      "type": "text",
                      "text": "fast editing inside blocks with several consecutive statements."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Fix: "
                    },
                    {
                      "type": "text",
                      "text": "inspect the statement before the highlighted line and normalize the snippet before rerunning analysis."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-trouble-semicolon-note",
              "type": "note",
              "variant": "warning",
              "title": "Useful clue",
              "blocks": [
                {
                  "id": "blk-trouble-semicolon-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This failure shows up often when copying examples or when turning free text into structured pseudocode."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "sectionId": "sec-api-no-disponible",
          "slug": "api-unavailable",
          "title": "API unavailable",
          "order": 4,
          "kind": "troubleshooting",
          "trackProgress": true,
          "estimatedMinutes": 3,
          "searchMeta": {
            "aliases": [
              "api unavailable"
            ],
            "keywords": [
              "api key",
              "repair with ai",
              "offline"
            ]
          },
          "blocks": [
            {
              "id": "blk-trouble-api-p1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "AI-powered features depend on external availability and, in some cases, on a valid API key. The base formal analysis should not depend on that."
                }
              ]
            },
            {
              "id": "blk-trouble-api-list",
              "type": "list",
              "style": "unordered",
              "items": [
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Cause: "
                    },
                    {
                      "type": "text",
                      "text": "service outage, missing API key, or incomplete local configuration."
                    }
                  ]
                },
                {
                  "content": [
                    {
                      "type": "strong",
                      "text": "Fix: "
                    },
                    {
                      "type": "text",
                      "text": "check backend status, verify the API key, and continue with the visible formal flow while the integration recovers."
                    }
                  ]
                }
              ]
            },
            {
              "id": "blk-trouble-api-note",
              "type": "note",
              "variant": "info",
              "title": "Operational limit",
              "blocks": [
                {
                  "id": "blk-trouble-api-note-p1",
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "LLM comparison, AI repair, and some assistant helpers may degrade without invalidating parsing, byLine, or bounds already computed."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
