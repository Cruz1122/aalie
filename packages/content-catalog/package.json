{
  "name": "@aa/content-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrato, catálogo y validación del contenido académico de AALIE",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "tsx": "^4.21.0",
    "typescript": "5.5.4"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./terms": {
      "import": "./src/terms.ts",
      "types": "./src/terms.ts"
    },
    "./server": {
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    },
    "./utils": {
      "import": "./src/utils.ts",
      "types": "./src/utils.ts"
    },
    "./schemas/*": "./schemas/*",
    "./catalog/*": "./catalog/*"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
