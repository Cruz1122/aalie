# Valores locales/CI ficticios para los stacks Compose bajo infra/
POSTGRES_DB=aalie
POSTGRES_USER=aalie
POSTGRES_PASSWORD=change-me-local-only
API_DATABASE_URL=postgresql+psycopg://aalie:change-me-local-only@postgres:5432/aalie
WEB_DATABASE_URL=postgresql://aalie:change-me-local-only@postgres:5432/aalie

# Public local origin used by Better Auth and the JWT issuer. Keep the
# production BETTER_AUTH_URL/AUTH_JWT_ISSUER values out of the dev stack.
DEV_BETTER_AUTH_URL=http://localhost:3000
DEV_AUTH_JWT_ISSUER=http://localhost:3000

# Secret LLM server-side; never expose it as NEXT_PUBLIC_*.
# Supported key formats are detected automatically (Gemini, OpenAI, Anthropic,
# OpenRouter, xAI and Groq).
API_KEY=
# Optional equivalent for OpenAI deployments; takes precedence over API_KEY.
OPENAI_API_KEY=
LLM_PROVIDER=
LLM_MODEL_CLASSIFY=
LLM_MODEL_PARSER_ASSIST=
LLM_MODEL_GENERAL=
LLM_MODEL_REPAIR=
LLM_MODEL_COMPARE=
LLM_MODEL_EXPLAIN=
LLM_MODEL_RECURSION_DIAGRAM=
LLM_MODEL_GENERATE_DIAGRAM=
OPENAI_COMPATIBLE_ENDPOINT_BASE=https://api.openai.com/v1/chat/completions
OPENROUTER_ENDPOINT_BASE=https://openrouter.ai/api/v1/chat/completions
XAI_ENDPOINT_BASE=https://api.x.ai/v1/chat/completions
GROQ_ENDPOINT_BASE=https://api.groq.com/openai/v1/chat/completions
ANTHROPIC_ENDPOINT_BASE=https://api.anthropic.com/v1/messages
RATE_LIMIT_HMAC_SECRET=replace-with-a-random-dev-secret
# Prefer a separate credential for BFF-to-API rate-limit checks; falls back to the HMAC above.
AALIE_RATE_LIMIT_SERVICE_TOKEN=
AALIE_RATE_LIMIT_LLM_UCALDAS_AUTH=5
AALIE_RATE_LIMIT_LLM_BACKEND_AUTH=5
AALIE_ABUSE_STRIKES_TO_BAN=3
AALIE_ABUSE_STRIKE_WINDOW_SECONDS=300
AALIE_ABUSE_BAN_SECONDS=3600
