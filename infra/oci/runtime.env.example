# Copy to /home/ubuntu/aalie/.env.runtime with mode 0600. Values below are examples only.
POSTGRES_DB=aalie
POSTGRES_USER=aalie
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
API_DATABASE_URL=postgresql+psycopg://aalie:replace-with-openssl-rand-hex-32@postgres:5432/aalie
WEB_DATABASE_URL=postgresql://aalie:replace-with-openssl-rand-hex-32@postgres:5432/aalie

# Better Auth / Google OAuth.
BETTER_AUTH_URL=https://aalie.dev
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
AUTH_JWT_ISSUER=https://aalie.dev
AUTH_JWT_AUDIENCE=urn:aalie:api
AUTH_JWKS_URL=http://web:3000/api/auth/jwks

# MF3 request boundary. Never expose these through NEXT_PUBLIC_* variables.
RATE_LIMIT_HMAC_SECRET=replace-with-openssl-rand-hex-32
AALIE_RATE_LIMITS_ENABLED=true
AALIE_STUDY_TELEMETRY_ENABLED=false
PDF_EXPORT_MAX_CONCURRENCY=1

# Product quotas per 60-second window.
AALIE_RATE_LIMIT_PARSE_ANON=120
AALIE_RATE_LIMIT_PARSE_AUTH=300
AALIE_RATE_LIMIT_ANALYSIS_ANON=30
AALIE_RATE_LIMIT_ANALYSIS_AUTH=120
AALIE_RATE_LIMIT_TRACE_ANON=10
AALIE_RATE_LIMIT_TRACE_AUTH=40
AALIE_RATE_LIMIT_QUIZ_ANON=20
AALIE_RATE_LIMIT_QUIZ_AUTH=60
AALIE_RATE_LIMIT_EXPORT_TEXT_ANON=10
AALIE_RATE_LIMIT_EXPORT_TEXT_AUTH=30
AALIE_RATE_LIMIT_EXPORT_PDF_ANON=2
AALIE_RATE_LIMIT_EXPORT_PDF_AUTH=8
AALIE_RATE_LIMIT_LLM_ANON=5
AALIE_RATE_LIMIT_LLM_AUTH=20

# Off-VM PostgreSQL backups. Bucket must be private. Prefer Instance Principal auth.
OCI_BACKUP_BUCKET=replace-with-private-bucket-name
OCI_BACKUP_PREFIX=postgres
# OCI_BACKUP_NAMESPACE=optional-namespace-override
