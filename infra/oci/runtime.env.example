# Copiar a /home/ubuntu/aalie/.env.runtime con modo 0600.
# Generar una contraseña hexadecimal nueva en producción; estos valores son ficticios.
POSTGRES_DB=aalie
POSTGRES_USER=aalie
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
API_DATABASE_URL=postgresql+psycopg://aalie:replace-with-openssl-rand-hex-32@postgres:5432/aalie
WEB_DATABASE_URL=postgresql://aalie:replace-with-openssl-rand-hex-32@postgres:5432/aalie

# Better Auth / Google OAuth; keep this file mode 0600.
BETTER_AUTH_URL=https://aalie.dev
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
AUTH_JWT_ISSUER=https://aalie.dev
AUTH_JWT_AUDIENCE=urn:aalie:api
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
