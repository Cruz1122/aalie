# Usar diagramas deterministas (sin LLM) cuando true
NEXT_PUBLIC_USE_DETERMINISTIC_DIAGRAMS=false

# Nota: la configuracion LLM (API_KEY, modelos y provider) vive ahora en apps/api.
# El frontend nunca llama Gemini directamente; usa /api/llm como proxy interno.

# URL privada de PostgreSQL usada exclusivamente por Better Auth
DATABASE_URL=postgresql://aalie:change-me@postgres:5432/aalie

# Better Auth / Google OAuth (server-side only; nunca usar NEXT_PUBLIC_)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT para servicios internos
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=urn:aalie:api
