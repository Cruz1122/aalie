# API key opcional del servidor para Gemini.
# Si existe y es valida, habilita las funciones LLM y el asistente embebido
# en /analyzer, /examples y /user-guide sin depender de una key local.
API_KEY=

# Usar diagramas deterministas (sin LLM) cuando true
NEXT_PUBLIC_USE_DETERMINISTIC_DIAGRAMS=false

# Endpoint base para Gemini
GEMINI_ENDPOINT_BASE=https://generativelanguage.googleapis.com/v1beta/models

# Modelos por job del BFF /api/llm
LLM_MODEL_PARSER_ASSIST=
LLM_MODEL_GENERAL=
LLM_MODEL_REPAIR=
LLM_MODEL_COMPARE=
LLM_MODEL_EXPLAIN=
