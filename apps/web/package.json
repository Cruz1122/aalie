{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Next.js (App Router) para AALIE - Analizador de Complejidades",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:trace-cache": "node --import tsx --test --test-reporter=spec src/lib/__tests__/trace-cache-utils.test.ts",
    "test:trace-cache:tap": "node --import tsx --test src/lib/__tests__/trace-cache-utils.test.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:watch": "vitest",
    "test:examples": "vitest run src/lib/examples/__tests__ src/components/examples/__tests__",
    "validate:examples-catalog": "node --import tsx scripts/validate-examples-catalog.ts"
  },
  "dependencies": {
    "@aa/grammar": "workspace:^",
    "@aa/types": "workspace:^",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "country-flag-icons": "^1.6.13",
    "dagre": "^0.8.5",
    "katex": "0.16.10",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.54.0",
    "next": "14.2.35",
    "next-intl": "^3.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/dagre": "^0.7.53",
    "@types/katex": "^0.16.7",
    "@types/node": "20.14.9",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.13",
    "tsx": "^4.21.0",
    "typescript": "5.5.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "vitest": "^2.1.9"
  }
}
