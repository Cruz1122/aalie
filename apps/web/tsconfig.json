{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@aa/content-catalog": ["../../packages/content-catalog/src/index.ts"],
      "@aa/content-catalog/server": [
        "../../packages/content-catalog/src/server.ts"
      ],
      "@aa/content-catalog/terms": [
        "../../packages/content-catalog/src/terms.ts"
      ],
      "@aa/content-catalog/types": [
        "../../packages/content-catalog/src/types.ts"
      ],
      "@aa/content-catalog/utils": [
        "../../packages/content-catalog/src/utils.ts"
      ],
      "@aa/types": ["../../packages/types/src"],
      "@aa/grammar": ["../../packages/grammar/ts/src"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
