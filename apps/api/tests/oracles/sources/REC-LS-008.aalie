recursiveQuadraticLocalWork(n)
BEGIN
  IF (n <= 0) THEN
  BEGIN
    RETURN 1;
  END
  ELSE
  BEGIN
    local <- 0;
    FOR i <- 1 TO n DO
    BEGIN
      FOR j <- 1 TO n DO
      BEGIN
        local <- local + 1;
      END;
    END;
    sub <- recursiveQuadraticLocalWork(n - 1);
    RETURN sub + local;
  END;
END
