karatsubaLikeCost(n)
BEGIN
  IF (n <= 1) THEN
  BEGIN
    RETURN 1;
  END
  ELSE
  BEGIN
    a <- karatsubaLikeCost(n / 2);
    b <- karatsubaLikeCost(n / 2);
    c <- karatsubaLikeCost(n / 2);
    total <- 0;
    FOR i <- 1 TO n DO
    BEGIN
      total <- total + 1;
    END;
    RETURN a + b + c + total;
  END;
END
