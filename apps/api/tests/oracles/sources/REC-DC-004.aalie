quadraticCombineCost(n)
BEGIN
  IF (n <= 1) THEN
  BEGIN
    RETURN 1;
  END
  ELSE
  BEGIN
    a <- quadraticCombineCost(n / 2);
    b <- quadraticCombineCost(n / 2);
    total <- 0;
    FOR i <- 1 TO n DO
    BEGIN
      FOR j <- 1 TO n DO
      BEGIN
        total <- total + 1;
      END;
    END;
    RETURN a + b + total;
  END;
END
