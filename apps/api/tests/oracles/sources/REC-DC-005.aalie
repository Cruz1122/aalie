ternarySplitCost(n)
BEGIN
  IF (n <= 1) THEN
  BEGIN
    RETURN 1;
  END
  ELSE
  BEGIN
    a <- ternarySplitCost(n / 3);
    b <- ternarySplitCost(n / 3);
    c <- ternarySplitCost(n / 3);
    total <- 0;
    FOR i <- 1 TO n DO
    BEGIN
      total <- total + 1;
    END;
    RETURN a + b + c + total;
  END;
END
