# API key del servidor para LLM. Se detecta automáticamente: AIza... = Gemini,
# sk-proj... = OpenAI, sk-ant... = Anthropic, sk-or-v1... = OpenRouter,
# xai... = xAI y gsk_... = Groq. Solo cuentas autenticadas @ucaldas.edu.co pueden usarla.
API_KEY=
# Alternativa explícita para una clave OpenAI; tiene prioridad sobre API_KEY.
OPENAI_API_KEY=

# Si queda vacío, el proveedor se detecta a partir de la clave.
LLM_PROVIDER=

# SQLAlchemy/psycopg URL usada por FastAPI (solo runtime; no guardar secretos)
DATABASE_URL=postgresql+psycopg://aalie:change-me@postgres:5432/aalie

# Endpoint base para Gemini
GEMINI_ENDPOINT_BASE=https://generativelanguage.googleapis.com/v1beta/models
# Endpoints opcionales para proveedores compatibles con OpenAI y Anthropic.
OPENAI_COMPATIBLE_ENDPOINT_BASE=https://api.openai.com/v1/chat/completions
OPENROUTER_ENDPOINT_BASE=https://openrouter.ai/api/v1/chat/completions
XAI_ENDPOINT_BASE=https://api.x.ai/v1/chat/completions
GROQ_ENDPOINT_BASE=https://api.groq.com/openai/v1/chat/completions
ANTHROPIC_ENDPOINT_BASE=https://api.anthropic.com/v1/messages

# Modelos por job
LLM_MODEL_CLASSIFY=
LLM_MODEL_PARSER_ASSIST=
LLM_MODEL_GENERAL=
LLM_MODEL_REPAIR=
LLM_MODEL_COMPARE=
LLM_MODEL_RECURSION_DIAGRAM=
LLM_MODEL_GENERATE_DIAGRAM=

# Cuota y protección anti-spam de la clave institucional.
AALIE_RATE_LIMIT_LLM_UCALDAS_AUTH=5
AALIE_RATE_LIMIT_LLM_BACKEND_AUTH=5
AALIE_ABUSE_STRIKES_TO_BAN=3
AALIE_ABUSE_STRIKE_WINDOW_SECONDS=300
AALIE_ABUSE_BAN_SECONDS=3600

# Better Auth JWT verification (no secrets or private keys are stored in API)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=urn:aalie:api

# Shared HMAC used to pseudonymize authenticated subjects for API-side quotas.
RATE_LIMIT_HMAC_SECRET=
# Optional dedicated BFF-to-API credential. If empty, RATE_LIMIT_HMAC_SECRET is used.
AALIE_RATE_LIMIT_SERVICE_TOKEN=
