              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "big-o"
              }
            ]
          }
        },
        {
          "optionId": "false",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Falso"
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Incorrecto. Big-O define una cota superior, no una equivalencia exacta."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "big-o"
              }
            ]
          }
        }
      ],
      "answer": {
        "correctOptionIds": ["true"]
      },
      "gradingPolicy": {
        "mode": "all_or_nothing",
        "maxScore": 1,
        "penalty": 0
      },
      "explanation": {
        "blocks": [
          {
            "type": "markdown",
            "content": "Big-O expresa cota superior asintotica: para n suficientemente grande, \\(f(n)\\) no supera a \\(c g(n)\\)."
          }
        ]
      },
      "contentRefs": [
        {
          "courseId": "ada",
          "moduleId": "notacion-asintotica",
          "chapterId": "big-o"
        }
      ],
      "selectionMeta": {
        "weight": 1,
