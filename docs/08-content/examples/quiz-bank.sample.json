    {
      "questionId": "ada-asymptotic-notation-basic-001",
      "questionVersion": 1,
      "status": "active",
      "type": "single_choice",
      "difficulty": "basic",
      "cognitiveLevel": "understand",
      "topic": "asymptotic_notation",
      "tags": ["big_o", "upper_bound", "formal_definition"],
      "skillIds": ["skill.asymptotic.big_o.upper-bound-interpretation"],
      "prompt": {
        "blocks": [
          {
            "type": "markdown",
            "content": "Que expresa que \\(f(n) \\in O(g(n))\\)?"
          }
        ]
      },
      "options": [
        {
          "optionId": "a",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Que \\(f(n)\\) esta acotada superiormente por \\(g(n)\\), salvo constante multiplicativa."
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Correcto. Big-O representa una cota superior asintotica."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "big-o"
              }
            ]
          }
        },
        {
          "optionId": "b",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Que \\(f(n)\\) y \\(g(n)\\) son exactamente la misma funcion."
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Incorrecto. Big-O no exige igualdad literal ni crecimiento exacto."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "big-o"
              }
            ]
          }
        },
        {
          "optionId": "c",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Que \\(f(n)\\) crece estrictamente mas rapido que \\(g(n)\\)."
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Incorrecto. Esa idea se relaciona con \\(\\omega(g(n))\\), no con Big-O."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "little-omega"
              }
            ]
          }
        }
      ],
      "answer": {
        "correctOptionIds": ["a"]
      },
      "gradingPolicy": {
        "mode": "all_or_nothing",
        "maxScore": 1,
        "penalty": 0
      },
      "explanation": {
        "blocks": [
          {
            "type": "markdown",
            "content": "Existen constantes \\(c > 0\\) y \\(n_0\\) tales que, para todo \\(n \\ge n_0\\), se cumple \\(0 \\le f(n) \\le c g(n)\\)."
          }
        ]
      },
      "contentRefs": [
        {
          "courseId": "ada",
          "moduleId": "notacion-asintotica",
          "chapterId": "big-o"
        }
      ],
