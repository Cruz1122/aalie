    {
      "questionId": "ada-asymptotic-notation-intermediate-001",
      "questionVersion": 1,
      "status": "active",
      "type": "multiple_choice",
      "difficulty": "intermediate",
      "cognitiveLevel": "apply",
      "topic": "asymptotic_notation",
      "tags": ["theta", "big_o", "big_omega", "limits"],
      "skillIds": ["skill.asymptotic.theta.identify-equivalent-order"],
      "prompt": {
        "blocks": [
          {
            "type": "markdown",
            "content": "Sea \\(f(n) = 3n^2 + 5n\\). Selecciona todas las afirmaciones correctas."
          }
        ]
      },
      "options": [
        {
          "optionId": "a",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "\\(f(n) \\in O(n^2)\\)"
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Correcto. \\(n^2\\) acota superiormente a \\(3n^2+5n\\) salvo constante."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "big-o"
              }
            ]
          }
        },
        {
          "optionId": "b",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "\\(f(n) \\in \\Omega(n^2)\\)"
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Correcto. Tambien esta acotada inferiormente por una constante positiva por \\(n^2\\)."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "omega"
              }
            ]
          }
        },
        {
          "optionId": "c",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "\\(f(n) \\in \\Theta(n^2)\\)"
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Correcto. El termino dominante es cuadratico; la cota es ajustada."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "theta"
              }
            ]
          }
        },
        {
          "optionId": "d",
          "content": {
            "blocks": [
              {
                "type": "markdown",
                "content": "\\(f(n) \\in o(n^2)\\)"
              }
            ]
          },
          "feedback": {
            "blocks": [
              {
                "type": "markdown",
                "content": "Incorrecto. Little-o exigiria crecimiento estrictamente menor que \\(n^2\\)."
              }
            ],
            "contentRefs": [
              {
                "courseId": "ada",
                "moduleId": "notacion-asintotica",
                "chapterId": "little-o"
              }
            ]
          }
        }
      ],
      "answer": {
        "correctOptionIds": ["a", "b", "c"]
      },
      "gradingPolicy": {
        "mode": "exact_set",
        "maxScore": 1,
        "penalty": 0
      },
      "explanation": {
        "blocks": [
          {
            "type": "markdown",
            "content": "El termino dominante de \\(3n^2+5n\\) es \\(n^2\\), por eso pertenece a O, Omega y Theta de \\(n^2\\), pero no a little-o de \\(n^2\\)."
          }
        ]
      },
      "contentRefs": [
        {
          "courseId": "ada",
          "moduleId": "notacion-asintotica",
          "chapterId": "theta"
        }
      ],
