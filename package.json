{
  "name": "algoritmos-monorepo",
  "private": true,
  "version": "1.10.0",
  "description": "Monorepo para AALIE - Analizador de Complejidades (Next.js + FastAPI)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --port 8000",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "start": "pnpm -C apps/web start",
    "test": "pnpm -r test",
    "test:docs-contracts": "python scripts/check_docs_contracts.py",
    "lint": "pnpm -C apps/web lint",
    "lint:web": "pnpm -C apps/web lint",
    "lint:web:fix": "pnpm -C apps/web lint:fix",
    "format:web": "pnpm -C apps/web format",
    "format:web:write": "pnpm -C apps/web format:write",
    "lint:api": "cd infra && docker compose exec -T api ruff check .",
    "lint:api:local": "cd apps/api && python -m ruff check app",
    "lint:api:fix": "cd apps/api && python -m ruff check app --fix",
    "format:api": "cd infra && docker compose exec -T api ruff format .",
    "lint:all": "pnpm run lint:web || true && pnpm run lint:api",
    "format:all": "pnpm run format:web || true && pnpm run format:api",
    "test:api": "cd apps/api && python -m pytest tests/ -v",
    "test:api:gate": "cd apps/api && python -m pytest -m \"unit or component or system\" -q",
    "test:api:contract": "cd apps/api && python -m pytest -m contract -q",
    "test:api:cov": "cd apps/api && python -m pytest tests/ --cov=app --cov-report=term",
    "test:api:unit": "cd apps/api && python -m pytest tests/unit/ -v",
    "test:api:stress": "cd apps/api && python -m pytest tests/contract/test_stress_algorithms.py -v",
    "test:api:while": "cd apps/api && python -m pytest -m while_domain -v"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "flatted": "3.4.2",
      "glob": "10.5.0",
      "dagre>lodash": "4.18.1",
      "graphlib>lodash": "4.18.1",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9.0.0 <10": "9.0.7",
      "monaco-editor>dompurify": "3.4.0",
      "mermaid>dompurify": "3.4.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4.0.0 <5": "4.0.4",
      "ws": "8.20.1",
      "js-yaml": "4.1.1",
      "brace-expansion": "1.1.14",
      "yaml": "2.8.3",
      "mdast-util-to-hast": "13.2.1"
    }
  }
}
